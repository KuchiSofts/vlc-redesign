#define VERSION_NUMBER @REDESIGN_VERSION_NUMBER@
#define VERSION_NUMBER_STR "@REDESIGN_VERSION@"

/* vlc.exe, and the helpers that share its icon and manifest (built with
 * -DVLC_RC_CACHE_GEN or -DVLC_RC_PREPARSER) */
#if defined(VLC_RC_CACHE_GEN)
# define RC_INTERNAL_NAME "vlc-cache-gen"
# define RC_ORIGINAL_FILENAME "vlc-cache-gen.exe"
# define RC_FILE_DESCRIPTION "VLC Redesign plugin cache generator"
#elif defined(VLC_RC_PREPARSER)
# define RC_INTERNAL_NAME "vlc-preparser"
# define RC_ORIGINAL_FILENAME "vlc-preparser.exe"
# define RC_FILE_DESCRIPTION "VLC Redesign media preparser"
#else
# define RC_INTERNAL_NAME "vlc"
# define RC_ORIGINAL_FILENAME "vlc.exe"
# define RC_FILE_DESCRIPTION "VLC Redesign"
#endif

#include <winuser.h>

VLC_ICON ICON "vlc.ico"

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "KuchiSofts"
      VALUE "ProductName", "VLC Redesign"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "InternalName", RC_INTERNAL_NAME
      VALUE "OriginalFilename", RC_ORIGINAL_FILENAME
      VALUE "FileVersion", VERSION_NUMBER_STR
      VALUE "FileDescription", RC_FILE_DESCRIPTION
      VALUE "Comments", "Based on VLC @VERSION@"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors; VLC Redesign \251 2026 KuchiSofts"
      VALUE "LegalTrademarks", "VLC media player, VideoLAN and x264 are registered trademarks from VideoLAN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vlc.exe.manifest"
