#EXTM3U x-tvg-url="https://epg.example/a.xml,https://epg.example/b.xml.gz" catchup="shift" catchup-days="2" tvg-shift="+1.5"
#EXTGRP:Before
#EXTINF:-1 tvg-id='single.quoted' tvg-name=Unquoted tvg-chno=007 radio="TRUE" user-agent="UA/1.0" http-referrer="https://ref.example/",Radio, with comma
#EXTVLCOPT:network-caching=1000
relative/path/radio.mp3
#EXTINF:0 catchup="xc" catchup-days="3",Xtream style
http://panel.example:8080/live/me/p%40ss/101.ts
#EXTINF:-1 catchup="fs" tvg-rec="4",Flussonic index
https://flu.example/ch/index.m3u8
#EXTINF:-1 catchup="default" catchup-source="&utc={utc}&lutc={lutc}&o={offset:60}&s={start}&e={end}&n={now}&t={timestamp}",Append source
https://live.example/append.m3u8?x=1
#EXTINF:-1 catchup-type="flussonic-hls" timeshift="1" group-title="",Empty group
https://flu.example/other/tracks-v1a1/mono.m3u8
#EXTINF:-1 tvg-logo="//cdn.example/logo.png" logo="ignored.png" channel-number="12" tvg-shift="-0.5" catchup-source="https://a.example/${start}-${end}-${duration}-${offset}-${timestamp}.ts",Dollar template
https://live.example/dollar.ts
#EXTGRP:After
#EXTINF:-1,18+ Late
https://live.example/late18.ts
https://bare.example/no-extinf.ts
#EXTINF:-1 tvg-name="Missing URL"
#EXTINF:-1,Last
rtsp://cam.example/stream
