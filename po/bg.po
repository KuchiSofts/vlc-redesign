#: modules/gui/macosx/menus/VLCMainMenu.m:832
#: modules/gui/macosx/panels/VLCAudioEffectsWindowController.m:106
#: modules/gui/macosx/panels/VLCAudioEffectsWindowController.m:354
#: modules/gui/macosx/panels/VLCVideoEffectsWindowController.m:119
#: modules/gui/macosx/panels/VLCVideoEffectsWindowController.m:457
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:736
#: modules/gui/macosx/preferences/prefs_widgets.m:1038
#: modules/gui/macosx/preferences/prefs_widgets.m:1095
