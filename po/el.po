msgstr "Ταινία NTSC (IVTC)"

#: src/libvlc-module.c:391
msgid "Deinterlace filter"
msgstr "Φίλτρο αποδιαπλοκής"

#: src/libvlc-module.c:392
msgid "Deinterlace module to use."
msgstr "Η ενότητα αποδιαπλοκής που θα χρησιμοποιηθεί."

#: src/libvlc-module.c:394
msgid "Video Stereo 3D mode"
msgstr "Λειτουργία στερεοσκοπικού 3D βίντεο"

#: src/libvlc-module.c:395
msgid "Set the Video Stereo 3D mode."
msgstr "Ορισμός της λειτουργίας στερεοσκοπικού 3D βίντεο."

#: src/libvlc-module.c:403 src/video_output/vout_intf.c:168
msgid "Left Only"
msgstr "Μόνο αριστερά"

#: src/libvlc-module.c:403 src/video_output/vout_intf.c:169
msgid "Right Only"
msgstr "Μόνο δεξιά"

#: src/libvlc-module.c:404 src/video_output/vout_intf.c:170
msgid "Side-by-Side"
msgstr "Δίπλα-δίπλα"

#: src/libvlc-module.c:427
msgid "Disable screensaver"
msgstr "Απενεργοποίηση προφύλαξης οθόνης"

#: src/libvlc-module.c:428
msgid "Disable the screensaver during video playback."
msgstr ""
"Απενεργοποίηση της προφύλαξης οθόνης κατά τη διάρκεια της αναπαραγωγής."

#: src/libvlc-module.c:432 modules/gui/macosx/main/macosx.m:125
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:51
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:79
