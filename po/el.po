#: src/libvlc-module.c:200
msgid "Stereo audio output mode"
msgstr "Στερεοφωνική λειτουργία εξόδου ήχου"

#: src/libvlc-module.c:206 src/libvlc-module.c:218 src/libvlc-module.c:424
#: modules/codec/x264.c:434
