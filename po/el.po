msgid "Never"
msgstr "Ποτέ"

#: src/libvlc-module.c:432
msgid "When fullscreen"
msgstr "Σε πλήρη οθόνη"

#: src/libvlc-module.c:432 modules/gui/macosx/main/macosx.m:125
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:51
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:59
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:119
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:140
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:347
