#: modules/codec/x264.c:374
msgid "CPU optimizations"
msgstr "Suoritinoptimoinnit"

#: modules/codec/x264.c:375
msgid "Use assembler CPU optimizations."
msgstr "Käytä assembler-kielisiä suoritinoptimointeja."

