#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:250
msgid "Size values"
msgstr "Luachanna méide"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:273
msgid ""
"Choose the size of the subtitles by name (relative to the picture), or in "
"pixels."
msgstr ""
"Roghnaigh méid na bhfotheideal de réir ainm (i gcoibhneas leis an bpictiúr), "
"nó i bpicteilíní."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:274
msgid "Relative|Pixels"
msgstr "Coibhneasta|Picteilíní"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:275
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:266
