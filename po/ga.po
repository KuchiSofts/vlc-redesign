#: src/libvlc-module.c:323
msgid "Zoom video"
msgstr "Súmáil an físeán"

#: src/libvlc-module.c:325
msgid "You can zoom the video by the specified factor."
msgstr "Is féidir leat an físeán a shúmáil faoin bhfachtóir sonraithe."

#: src/libvlc-module.c:327
msgid "Grayscale video output"
msgstr ""

#: src/libvlc-module.c:329
msgid ""
"Output video in grayscale. As the color information aren't decoded, this can "
"save some processing power."
msgstr ""

#: src/libvlc-module.c:332
msgid "Embedded video"
msgstr "Físeán leabaithe"

#: src/libvlc-module.c:334
msgid "Embed the video output in the main interface."
msgstr "Leabaigh an t-aschur físeáin sa phríomhchomhéadan."

#: src/libvlc-module.c:336
msgid "Fullscreen video output"
msgstr "Aschur físeáin lánscáileáin"

#: src/libvlc-module.c:338
msgid "Start video in fullscreen mode"
msgstr "Tosaigh an físeán i lánscáileán"

