#: modules/codec/x264.c:357
msgid ""
"Dct-domain noise reduction. Adaptive pseudo-deadzone. 10 to 1000 seems to be "
"a useful range."
msgstr ""
"Redución de ruído en dominio DCT. Pseudozona morta adaptábel. De 10 a 1000 "
