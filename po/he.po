#: modules/gui/macosx/main/macosx.m:70
msgid "Control playback with the Apple Remote"
msgstr "שליטה בנגינה עם שלט של Apple"

#: modules/gui/macosx/main/macosx.m:71
msgid "By default, VLC can be remotely controlled with the Apple Remote."
msgstr "כברירת מחדל, ניתן לשלוט ב־VLC מרחוק עם שלט של Apple."

#: modules/gui/macosx/main/macosx.m:73
msgid "Control system volume with the Apple Remote"
msgstr "שליטה בעוצמת השמע של המערכת עם שלט של Apple"

#: modules/gui/macosx/main/macosx.m:74
msgid ""
"By default, VLC will control its own volume with the Apple Remote. However, "
"you can choose to control the global system volume instead."
msgstr ""
"כברירת מחדל, ל־VLC תהיה שליטה בעוצמת השמע העצמית שלו עם השלט של Apple. עם "
"זאת, ניתן לבחור לשלוט בעוצמת השמע של כל המערכת במקום."

#: modules/gui/macosx/main/macosx.m:76
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:416
msgid "Display VLC status menu icon"
msgstr "הצגת סמל תפריט מצב VLC"

#: modules/gui/macosx/main/macosx.m:77
msgid ""
"By default, VLC will show the statusbar icon menu. However, you can choose "
"to disable it (restart required)."
msgstr ""
"כברירת מחדל, יציג VLC את תפריט סמל שורת המצב. עם זאת, ניתן לבחור להשבית אותו "
"(נדרשת הפעלה מחדש)."

#: modules/gui/macosx/main/macosx.m:79
msgid "Control play queue items with the Apple Remote"
msgstr ""

#: modules/gui/macosx/main/macosx.m:80
msgid ""
"By default, VLC will allow you to switch to the next or previous item with "
"the Apple Remote. You can disable this behavior with this option."
msgstr ""
"כברירת מחדל, יתאפשר לך עם VLC לעבור לפריט הבא או הקודם עם השלט של Apple. "
"ניתן לנטרל התנהגות זו עם האפשרות שלהלן."

#: modules/gui/macosx/main/macosx.m:82
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:386
msgid "Control playback with media keys"
msgstr "שליטה בנגינה עם מקשי המדיה"

#: modules/gui/macosx/main/macosx.m:83
msgid ""
"By default, VLC can be controlled using the media keys on modern Apple "
"keyboards."
msgstr ""

#: modules/gui/macosx/main/macosx.m:86
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:460
msgid "Use the native fullscreen mode"
msgstr "שימוש במצב המסך המלא הטבעי"

#: modules/gui/macosx/main/macosx.m:87
msgid ""
"By default, VLC uses the fullscreen mode known from previous Mac OS X "
"releases. It can also use the native fullscreen mode on Mac OS X 10.7 and "
"later."
msgstr ""
"כברירת מחדל, ב־VLC נעשה שימוש במצב המסך המלא הידוע מהמהדורות הקודמות של Mac "
"OS X. הנגן יכול להשתמש גם במצב המסך המלא הטבעי ב־Mac OS X 10.7 ואילך."

#: modules/gui/macosx/main/macosx.m:89
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:453
#: modules/gui/qt/qt.cpp:184
msgid "Resize interface to the native video size"
msgstr "שינוי גודל הממשק לגודל הטבעי של הווידאו"

#: modules/gui/macosx/main/macosx.m:90 modules/gui/qt/qt.cpp:185
msgid ""
"You have two choices:\n"
" - The interface will resize to the native video size\n"
" - The video will fit to the interface size\n"
" By default, interface resize to the native video size."
msgstr ""
"עומדות בפניך שתי אפשרויות:\n"
" - גודל הממשק ישתנה בהתאם לגודל הטבעי של הווידאו\n"
" - הווידאו יתאים את עצמו לגודל הממשק\n"
"כברירת מחדל, הממשק יתאים עצמו לגודל הווידאו הטבעי."

#: modules/gui/macosx/main/macosx.m:95
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:452
#: modules/gui/qt/qt.cpp:274
