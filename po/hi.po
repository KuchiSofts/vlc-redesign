msgstr "ऑप्टिकल मीडिया के लिए कैशिंग मान, मिलीसेकंड में।"

#: src/libvlc-module.c:576
msgid "Network caching (ms)"
msgstr "नेटवर्क कैशिंग (ms)"

#: src/libvlc-module.c:578
