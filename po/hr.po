msgid "Default"
msgstr "Zadano"

#: src/libvlc-module.c:619
#: modules/gui/macosx/panels/VLCAudioEffectsWindowController.m:239
#: modules/gui/qt/dialogs/extended/extended_panels.cpp:942
msgid "Enable"
msgstr "Omogući"

#: src/libvlc-module.c:621
msgid "MTU of the network interface"
msgstr "Vrijednost MTU sučelja mrežnih veza"

#: src/libvlc-module.c:623
msgid ""
"This is the maximum application-layer packet size that can be transmitted "
"over the network (in bytes)."
msgstr ""
"To je maksimalna veličina paketa aplikacijske razine, koj može biti poslana "
"preko mreže (u bajtima)."

#: src/libvlc-module.c:628 modules/stream_out/rtp.c:116
msgid "Hop limit (TTL)"
msgstr "Ograničenje skokova (TTL)"

#: src/libvlc-module.c:630 modules/stream_out/rtp.c:118
msgid ""
"This is the hop limit (also known as \"Time-To-Live\" or TTL) of the "
"multicast packets sent by the stream output (-1 = use operating system built-"
"in default)."
msgstr ""
"Ovim se ograničavaju skokovi (poznati i kao \"vrijeme opstanka\" iliti TTL)  "
"višesmjerno poslanih paketa, koji su poslani s izlaza strujanja (-1 = "
"ugrađeni standard operacijskog sustava)."

#: src/libvlc-module.c:634
msgid "Multicast output interface"
msgstr "Izlazno sučelje višesmjerno poslanih strujanja"

#: src/libvlc-module.c:636
msgid "Default multicast interface. This overrides the routing table."
msgstr ""
"Zadano sučelje višesmjerno poslanih tokova strujanja. Time se zamjenjuje "
"tablica usmjeravanja."

#: src/libvlc-module.c:638
msgid "DiffServ Code Point"
msgstr "DiffServ kôdna točka"

#: src/libvlc-module.c:639
msgid ""
"Differentiated Services Code Point for outgoing UDP streams (or IPv4 Type Of "
"Service, or IPv6 Traffic Class). This is used for network Quality of Service."
msgstr ""
"Diferencijalna kôdna točka usluga za odlazno UDP strujanje (ili IPv4 vrsta "
"usluga, ili IPv6 prometni razredi). To se koristi za mrežnu kvalitetu usluga "
"(QoS)."

#: src/libvlc-module.c:645
msgid ""
"Choose the program to select by giving its Service ID. Only use this option "
"if you want to read a multi-program stream (like DVB streams for example)."
msgstr ""
"Odaberite program za odabir zadavanjem njegovog identifikacijskog broja "
"službe. Koristite ovu mogućnost samo ukoliko želite učitavati neki "
"višeprogramski protok strujanja (primjerice strujanja DVB-a)."

#: src/libvlc-module.c:649 modules/gui/qt/iptv/qml/TvPlayerOverlay.qml:760
#: modules/gui/qt/menus/qml_menu_wrapper.cpp:687
#: modules/gui/qt/player/qml/controlbarcontrols/ProgramButton.qml:36
msgid "Programs"
msgstr "Programi"

#: src/libvlc-module.c:651
msgid ""
"Choose the programs to select by giving a comma-separated list of Service "
"IDs (SIDs). Only use this option if you want to read a multi-program stream "
"(like DVB streams for example)."
msgstr ""
"Odaberite programe za odabir navođenjem zarezima razdvajanog popisa "
"identifikacijskih brojeva službi (SIDs). Koristite ovu mogućnost samo "
"ukoliko želite učitavati neki višeprogramski protok strujanja (primjerice "
"strujanja DVB-a)."

#: src/libvlc-module.c:657
#: modules/gui/qt/medialibrary/qml/VideoInfoExpandPanel.qml:295
msgid "Video track"
msgstr "Video zapis"

#: src/libvlc-module.c:659
msgid "Stream number of the video track to use (from 0 to n)."
msgstr "Broj strujanja video zapisa koji će biti korišten (od 0 do n)."

#: src/libvlc-module.c:662
#: modules/gui/qt/medialibrary/qml/VideoInfoExpandPanel.qml:307
msgid "Audio track"
msgstr "Zapis zvuka"

#: src/libvlc-module.c:664
msgid "Stream number of the audio track to use (from 0 to n)."
msgstr "Broj strujanja zvučnog zapisa koji će biti korišten (od 0 do n)."

#: src/libvlc-module.c:667
#: modules/gui/qt/medialibrary/qml/VideoInfoExpandPanel.qml:319
msgid "Subtitle track"
msgstr "Zapis podnaslova"

#: src/libvlc-module.c:669
msgid "Stream number of the subtitle track to use (from 0 to n)."
msgstr "Broj strujanja zapisa podnaslova koji će se koristiti (od 0 do n)."

#: src/libvlc-module.c:672 modules/stream_out/transcode/transcode.c:97
msgid "Audio language"
msgstr "Jezik zvuka"

#: src/libvlc-module.c:674
msgid ""
"Language of the audio track you want to use (comma separated, two or three "
"letter ISO-639 country code; you may use 'none' to avoid a fallback to "
"another language)."
msgstr ""
"Jezik zapisa zvuka koji želite koristiti (odvojeno zarezom, dvoslovni ili "
"troslovni kôd zemlje ISO-639; možete koristiti 'none' kako biste izbjegli "
"prelazak na neki drugi jezik)."

#: src/libvlc-module.c:677
msgid "Subtitle language"
msgstr "Jezik podnaslova"

#: src/libvlc-module.c:679
msgid ""
"Language of the subtitle track you want to use (comma separated, two or "
"three letter ISO-639 country code; you may use 'any' as a fallback)."
msgstr ""
"Jezik zapisa podnaslova koji želite koristiti (odvojeno zarezom, dvoslovni "
"ili troslovni kôd zemlje ISO-639; kao zamjenu možete koristiti 'any')."

#: src/libvlc-module.c:682
msgid "Menu language"
msgstr "Jezik izbornika"

#: src/libvlc-module.c:684
msgid ""
"Language of the menus you want to use with DVD/BluRay (comma separated, two "
"or three letter ISO-639 country code; you may use 'any' as a fallback)."
msgstr ""
"Jezik izbornika koji želite koristiti s DVD/BluRay diskovima (odvojeno "
"zarezom, dvoslovni ili troslovni kôd zemlje ISO-639; kao zamjenu možete "
"koristiti 'any')."

#: src/libvlc-module.c:687
msgid "Video track ID"
msgstr "ID video zapisa"

#: src/libvlc-module.c:689
msgid "Stream ID of the video track to use."
msgstr "ID strujanja video zapisa koji će se koristiti."

#: src/libvlc-module.c:691
msgid "Audio track ID"
msgstr "ID zvučnog zapisa"

#: src/libvlc-module.c:693
msgid "Stream ID of the audio track to use."
msgstr "ID strujanja zvučnog zapisa koji će se koristiti."

#: src/libvlc-module.c:695
msgid "Subtitle track ID"
msgstr "ID zapisa podnaslova"

#: src/libvlc-module.c:697
msgid "Stream ID of the subtitle track to use."
msgstr "ID strujanja zapisa podnaslova koji će se koristiti."

#: src/libvlc-module.c:699
#, fuzzy
msgid "Preferred Closed Captions decoder"
msgstr "Dekoder zatvorenih natpisa"

#: src/libvlc-module.c:703
msgid "Preferred video resolution"
msgstr "Poželjna razlučivost video slike"

#: src/libvlc-module.c:705
msgid ""
"When several video formats are available, select one whose resolution is "
"closest to (but not higher than) this setting, in number of lines. Use this "
"option if you don't have enough CPU power or network bandwidth to play "
"higher resolutions."
msgstr ""
"Ako su raspoloživi različiti video formati, odaberite neki sa sličnim brojem "
"redaka (ali ne i s višom razlučivošću) kojem je ova postavka najbliža.\n"
"Koristite ovu mogućnost ako nemate dostatne procesorske snage ili širine "
"mrežnog pojasa za izvedbu pri višim razlučivostima."

#: src/libvlc-module.c:711
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:131
msgid "Best available"
msgstr "Najbolja dostupna"

#: src/libvlc-module.c:711
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:131
msgid "Full HD (1080p)"
msgstr "Full HD (1080p)"

#: src/libvlc-module.c:711
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:131
msgid "HD (720p)"
msgstr "HD (720p)"

#: src/libvlc-module.c:712
msgid "Standard Definition (576 or 480 lines)"
msgstr "Standardna definicija (576 ili 480 linija)"

#: src/libvlc-module.c:713
msgid "Low Definition (360 lines)"
msgstr "Niska definicija (360 linija)"

#: src/libvlc-module.c:714
msgid "Very Low Definition (240 lines)"
msgstr "Vrlo niska definicija (240 linija)"

#: src/libvlc-module.c:717
msgid "Low delay mode"
msgstr "Način niske zadrške"

#: src/libvlc-module.c:719
msgid ""
"Try to minimize delay along decoding chain. Might break with non compliant "
"streams."
msgstr ""
"Pokušava smanjiti zadršku u lancu dekodiranja. Može ne raditi s nesukladnim "
"strujanjima."

#: src/libvlc-module.c:722
msgid "Input repetitions"
msgstr "Ponavljanja ulaznog sadržaja"

#: src/libvlc-module.c:724
msgid "Number of time the same input will be repeated"
msgstr "Broj koliko će puta biti opetovan isti ulazni sadržaj"

#: src/libvlc-module.c:726
#: modules/gui/macosx/windows/VLCOpenWindowController.m:225
msgid "Start time"
msgstr "Početno vrijeme"

#: src/libvlc-module.c:728
msgid "The stream will start at this position (in seconds)."
msgstr "Strujanje će započeti pri tom položaju (u sekundama)."

#: src/libvlc-module.c:730
#: modules/gui/macosx/windows/VLCOpenWindowController.m:227
msgid "Stop time"
msgstr "Zaustavno vrijeme"

#: src/libvlc-module.c:732
msgid "The stream will stop at this position (in seconds)."
msgstr "Strujanje će se zaustaviti na tom mjestu (u sekundama)."

#: src/libvlc-module.c:734
msgid "Run time"
msgstr "Vrijeme izvođenja"

#: src/libvlc-module.c:736
msgid "The stream will run this duration (in seconds)."
msgstr "Strujanje će teći u tom trajanju (u sekundama)."

#: src/libvlc-module.c:738
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:377
msgid "Fast seek"
msgstr "Brzo traženje"

#: src/libvlc-module.c:740
msgid "Favor speed over precision while seeking"
msgstr "Pri traženju prednost davati brzini pred točnošću"

#: src/libvlc-module.c:742 modules/gui/qt/player/qml/PlaybackSpeed.qml:221
#: modules/gui/qt/player/qml/TracksMenu.qml:334
msgid "Playback speed"
msgstr "Brzina izvođenja"

#: src/libvlc-module.c:744
msgid "This defines the playback speed (nominal speed is 1.0)."
msgstr "Ovim se određuje brzina izvođenja (nominalna brzina je 1.0)."

#: src/libvlc-module.c:746
msgid "Input list"
msgstr "Ulazni popis"

#: src/libvlc-module.c:748
msgid ""
"You can give a comma-separated list of inputs that will be concatenated "
"together after the normal one."
msgstr ""
"Ovdje možete zadati zarezima razdvajani popis ulaznih sadržaja, koji će biti "
"nadovezan iza onog redovnog."

#: src/libvlc-module.c:751
msgid "Input slave (experimental)"
msgstr "Ovisni dovod (pokusno)"

#: src/libvlc-module.c:753
msgid ""
"This allows you to play from several inputs at the same time. This feature "
"is experimental, not all formats are supported. Use a '#' separated list of "
"inputs."
msgstr ""
"Ovo Vam omogućava istovremeno izvođenje s različitih ulaza. To je svojstvo "
"još uvijek pokusno i ne podržava sve formate. Koristite putem '#' razdvajani "
"popis ulaznih sadržaja."

#: src/libvlc-module.c:757
msgid "Bookmarks list for a stream"
msgstr "Popis straničnika za protok strujanja"

#: src/libvlc-module.c:759
msgid ""
"You can manually give a list of bookmarks for a stream in the form "
"\"{name=bookmark-name,time=optional-time-offset,bytes=optional-byte-offset},"
"{...}\""
msgstr ""
"Ovdje možete ručno zadati popis straničnika za protok strujanja u obliku "
"\"{naziv=naziv-straničnika,vrijeme=možebitni-vremenski-"
"odstup,bajti=možebitni-bajtovski-odstup},{...}\""

#: src/libvlc-module.c:763
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:99
msgid "Save recently played items"
msgstr "Spremi nedavno izvođene stavke"

#: src/libvlc-module.c:765
#: modules/gui/macosx/panels/dialogs/VLCResumeDialogController.m:65
#: modules/gui/macosx/panels/dialogs/VLCResumeDialogController.m:66
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:390
msgid "Continue playback"
msgstr "Nastavi izvođenje"

#: src/libvlc-module.c:766
msgid "Should the playback resume where it was left off?"
msgstr "Treba li izvođenje nastaviti ondje gdje je prekinuto?"

#: src/libvlc-module.c:775
msgid "Never resume playback where it was left off"
msgstr "Nikad ne nastavljaj izvođenje ondje gdje je prekinuto"

#: src/libvlc-module.c:776
msgid "Ask when the playback starts"
msgstr "Pitaj pri pokretanju izvođenja"

#: src/libvlc-module.c:777
msgid "Always resume playback where it was left off"
msgstr "Uvijek nastavi izvođenje ondje gdje je prekinuto"

#: src/libvlc-module.c:780
msgid "Resume last playback states"
msgstr "Vrati posljednja stanja izvođenja"

#: src/libvlc-module.c:781
msgid ""
"This will resume the last playback state, such as the selected tracks, rate, "
"aspect-ratio, ..."
msgstr ""
"Vraća posljednje stanje izvođenja, poput odabranih zapisa, brzine, bočnog "
"omjera, ..."

#: src/libvlc-module.c:784
msgid "Record directory"
msgstr "Mapa snimaka"

#: src/libvlc-module.c:786
msgid "Directory where the records will be stored"
msgstr "Mapa u koju će se spremati snimke"

#: src/libvlc-module.c:788
msgid "Prefer native stream recording"
msgstr "Prednost davati snimanju toka izvornog strujanja"

#: src/libvlc-module.c:790
msgid ""
"When possible, the input stream will be recorded instead of using the stream "
"output module"
msgstr ""
"Ukoliko je to moguće, umjesto da se koristi modul izlaznog strujanja, bit će "
"snimljeno ulazno strujanje"

#: src/libvlc-module.c:793
msgid "Timeshift directory"
msgstr "Mapa kliznog vremena"

#: src/libvlc-module.c:795
msgid "Directory used to store the timeshift temporary files."
msgstr ""
"Mapa koja se koristi za spremanje privremenih datoteka vremenskih pomaka (za "
"funkciju poznatu kao time-shift, time-shifting, time-slip i chase play)."

#: src/libvlc-module.c:797
msgid "Timeshift granularity"
msgstr "Zrnatost kliznog vremena"

#: src/libvlc-module.c:799
msgid ""
"This is the maximum size in bytes of the temporary files that will be used "
"to store the timeshifted streams."
msgstr ""
"Ovo je maksimum veličine privremenih datoteka u bajtima, koje će biti "
"korištene za spremanje vremenski pomaknutih strujanja."

#: src/libvlc-module.c:802
msgid "Change title according to current media"
msgstr "Izmijeni naslov sukladno tekućem mediju"

#: src/libvlc-module.c:803
msgid ""
"This option allows you to set the title according to what's being "
"played<br>$a: Artist<br>$b: Album<br>$c: Copyright<br>$t: Title<br>$g: "
"Genre<br>$n: Track num<br>$p: Now playing<br>$A: Date<br>$D: Duration<br>$Z: "
"\"Now playing\" (Fall back on Title - Artist)"
msgstr ""
"Pomoću ove mogućnosti možete postaviti naslov sukladno onom, što se upravo "
"izvodi<br>$a: Umjetnik<br>$b: Album<br>$c: Autorska prava<br>$t: "
"Naslov<br>$g: Žanr<br>$n: Broj zapisa<br>$p: Upravo se izvodi<br>$A: "
"Nadnevak<br>$D: Trajanje<br>$Z: \"Upravo se izvodi\" (osnovno je na  Naslov "
"- Izvođač)"

#: src/libvlc-module.c:810
msgid ""
"These options allow you to modify the behavior of the subpictures subsystem. "
"You can for example enable subpictures sources (logo, etc.). Enable these "
"filters here and configure them in the \"subsources filters\" modules "
"section. You can also set many miscellaneous subpictures options."
msgstr ""
"Ove mogućnosti dopuštaju da izmijenite ponašanje podsustavnih podslika. Tako "
"primjerice možete uključiti izvore podslika (logotip, itd.). Uključite te "
"filtre ovdje, a prilagodite ih u modulskom odsjeku \"filtri podslîka\". Isto "
"tako možete postaviti više različitih mogućnosti podslîka."

#: src/libvlc-module.c:816
msgid "Force subtitle position"
msgstr "Nametni položaj podnaslova"

#: src/libvlc-module.c:818
msgid ""
"You can use this option to place the subtitles under the movie, instead of "
"over the movie. Try several positions."
msgstr ""
"Ovu mogućnost možete koristiti za smještanje podnaslova ispod filma, umjesto "
"iznad njega. Iskušajte različite položaje."

#: src/libvlc-module.c:821
msgid "Subtitle position"
msgstr "Položaj podnaslova"

#: src/libvlc-module.c:823
msgid ""
"How high the subtitles are, in percent of the height of the picture above "
"their usual place (below it when negative). The same on any screen and in "
"any window size."
msgstr ""
"Koliko su podnaslovi podignuti iznad svojeg uobičajenog mjesta, u postocima "
"visine slike (spušteni ispod njega kada je vrijednost negativna). Jednako na "
"svakom zaslonu i pri svakoj veličini prozora."

#: src/libvlc-module.c:827
msgid "Subtitles text scaling factor"
msgstr "Faktor skaliranja teksta podnaslova"

#: src/libvlc-module.c:828
msgid "Changes the subtitles size where possible"
msgstr "Mijenja veličinu podnaslova gdje je to moguće"

#: src/libvlc-module.c:830
msgid "Enable sub-pictures"
msgstr "Omogući podslike"

#: src/libvlc-module.c:832
msgid "You can completely disable the sub-picture processing."
msgstr "Ovdje možete potpuno onemogućiti obrađivanje podslîka."

#: src/libvlc-module.c:834
msgid "Display sub-pictures on full window"
msgstr "Prikaži podslike preko cijelog okna"

#: src/libvlc-module.c:836
msgid "It allows showing subtitles in black bars."
msgstr "Omogućuje prikaz podnaslova u crnim trakama."

#: src/libvlc-module.c:838
msgid "Position of secondary subtitles"
msgstr "Položaj sekundarnih podnaslova"

#: src/libvlc-module.c:840
msgid ""
"Place on video where to display secondary subtitles (default bottom center)."
msgstr ""
"Mjesto na video slici gdje će se prikazati sekundarni podnaslovi (zadano je "
"u donjem središtu slike)."

#: src/libvlc-module.c:842
msgid "Force secondary subtitle position"
msgstr "Nametni položaj sekundarnih podnaslova"

#: src/libvlc-module.c:844
msgid ""
"You can use this option to vertically adjust the position secondary "
"subtitles are displayed."
msgstr ""
"Ovom mogućnošću možete okomito prilagoditi položaj na kojem se prikazuju "
"sekundarni podnaslovi."

#: src/libvlc-module.c:847
msgid "On Screen Display duration"
msgstr "Trajanje prikaza na zaslonu (OSD)"

#: src/libvlc-module.c:849
msgid "How long the messages of the On Screen Display stay, in milliseconds."
msgstr ""
"Koliko dugo poruke prikaza na zaslonu (OSD) ostaju vidljive, u milisekundama."

#: src/libvlc-module.c:850 src/libvlc-module.c:1827 src/text/iso-639_def.h:573
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:417
msgid "On Screen Display"
msgstr "Prikaz u prikazu (OSD)"

#: src/libvlc-module.c:852
msgid ""
"VLC can display messages on the video. This is called OSD (On Screen "
"Display)."
msgstr ""
"VLC može prikazivati poruke i unutar video slike. To se naziva prikaz u "
"prikazu (eng.: On Screen Display, skr. OSD)."

#: src/libvlc-module.c:855
msgid "Text rendering module"
msgstr "Modul uobličavanja teksta"

#: src/libvlc-module.c:857
msgid ""
"VLC normally uses Freetype for rendering, but this allows you to use svg for "
"instance."
msgstr ""
"VLC za predočavanje teksta obično koristi Freetype, ali Vam ovo omogućava da "
"koristite primjerice SVG."

#: src/libvlc-module.c:859
msgid "Subpictures source module"
msgstr "Modul izvora podslîka"

#: src/libvlc-module.c:861
msgid ""
"This adds so-called \"subpicture sources\". These filters overlay some "
"images or text over the video (like a logo, arbitrary text, ...)."
msgstr ""
"Ovim se dodaju tzv. \"izvori podslîka\". Ti filtri prekrivaju neke slike ili "
"tekstove preko video slike (kao što su logotip, proizvoljni tekst, ...)."

#: src/libvlc-module.c:864
msgid "Subpictures filter module"
msgstr "Modul filtra podslîka"

#: src/libvlc-module.c:866
msgid ""
"This adds so-called \"subpicture filters\". These filter subpictures created "
"by subtitle decoders or other subpictures sources."
msgstr ""
"Ovo dodaje tzv. \"filtre podslîka\". To filtrira podslike stvorene dekôderom "
"podnaslova ili drugim izvorima podslika."

#: src/libvlc-module.c:869
msgid "Autodetect subtitle files"
msgstr "Automatsko prepoznavanje datoteka podnaslova"

#: src/libvlc-module.c:871
msgid ""
"Automatically detect a subtitle file, if no subtitle filename is specified "
"(based on the filename of the movie)."
msgstr ""
"Automatski (na osnovu naziva datoteke filma) prepoznaje datoteku podnaslova, "
"ukoliko nije naveden naziv datoteke podnaslova."

#: src/libvlc-module.c:874
msgid "Subtitle autodetection fuzziness"
msgstr "Izrazitost samoprepoznavanja podnaslova"

#: src/libvlc-module.c:876
msgid ""
"This determines how fuzzy subtitle and movie filename matching will be. "
"Options are:\n"
"0 = no subtitles autodetected\n"
"1 = any subtitle file\n"
"2 = any subtitle file containing the movie name\n"
"3 = subtitle file matching the movie name with additional chars\n"
"4 = subtitle file matching the movie name exactly"
msgstr ""
"Ovim se određuje kako izrazita će biti podudarnost naziva datoteka "
"podnaslova i filma. Mogućnosti su:\n"
"0 = bez autom. prepoznavanja podnaslova\n"
"1 = bilo koja datoteka podnaslova\n"
"2 = bilo koja datoteka podnaslova, koja sadrži taj naziv filma\n"
"3 = datoteka podnaslova podudarna s nazivom filma s dodatnim znakovima\n"
"4 = datoteka podnaslova točno podudarna s nazivom filma"

#: src/libvlc-module.c:884
msgid "Subtitle autodetection paths"
msgstr "Staze samoprepoznavanja podnaslova"

#: src/libvlc-module.c:886
msgid ""
"Look for a subtitle file in those paths too, if your subtitle file was not "
"found in the current directory."
msgstr ""
"Datoteku podnaslova traži i na tim stazama, ukoliko Vaša datoteka podnaslova "
"nije pronađena u tekućem imeniku."

#: src/libvlc-module.c:889
msgid "Subtitle Frames per Second"
msgstr "Okvira u sekundi za podnaslove"

#: src/libvlc-module.c:891
msgid "Override the normal frames per second settings. "
msgstr "Nadomješta uobičajene postavke okvira u sekundi. "

#: src/libvlc-module.c:893
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:280
#: modules/spu/subsdelay.c:267
msgid "Subtitle delay"
msgstr "Odgoda podnaslova"

#: src/libvlc-module.c:895
msgid "Apply a delay to all subtitles (in 1/10s, eg 100 means 10s)."
msgstr ""
"Primijenjuje odgodu na sve podnaslove (u 1/10s, primjerice 100 znači 10s)."

#: src/libvlc-module.c:897
msgid "Use subtitle file"
msgstr "Koristi datoteku podnaslova"

#: src/libvlc-module.c:899
msgid ""
"Load this subtitle file. To be used when autodetect cannot detect your "
"subtitle file."
msgstr ""
"Učitava ovu datoteku podnaslova. Koristi se kada samoprepoznavanje ne može "
"prepoznati Vašu datoteku podnaslova."

#: src/libvlc-module.c:903
msgid "DVD device"
msgstr "Uređaj DVD-a"

#: src/libvlc-module.c:904
msgid "VCD device"
msgstr "Uređaj VCD-a"

#: src/libvlc-module.c:905 modules/access/cdda.c:822
msgid "Audio CD device"
msgstr "Uređaj audio CD-a"

#: src/libvlc-module.c:909
msgid ""
"This is the default DVD drive (or file) to use. Don't forget the colon after "
"the drive letter (e.g. D:)"
msgstr ""
"To je zadani pogon (ili datoteka) DVD-a koji će se koristiti. Ne zaboravite "
"dvotočku nakon pogonskog slova (primjerice D:)"

#: src/libvlc-module.c:912
msgid ""
"This is the default VCD drive (or file) to use. Don't forget the colon after "
"the drive letter (e.g. D:)"
msgstr ""
"To je zadani pogon (ili datoteka) VCD-a koji će se koristiti. Ne zaboravite "
"dvotočku nakon pogonskog slova (primjerice D:)"

#: src/libvlc-module.c:919
msgid "This is the default DVD device to use."
msgstr "To je uređaj DVD-a koji će se koristiti kao zadani."

#: src/libvlc-module.c:921
msgid "This is the default VCD device to use."
msgstr "To je uređaj VCD-a koji će se koristiti kao zadani."

#: src/libvlc-module.c:935
msgid "TCP connection timeout"
msgstr "Vrijeme isteka povezivanja TCP-a"

#: src/libvlc-module.c:937
msgid "Default TCP connection timeout (in milliseconds)."
msgstr "Zadano vrijeme isteka povezivanja putem TCP-a (u milisekundama)."

#: src/libvlc-module.c:939
msgid "HTTP server address"
msgstr "Adresa poslužitelja HTTP-a"

#: src/libvlc-module.c:941
msgid ""
"By default, the server will listen on any local IP address. Specify an IP "
"address (e.g. ::1 or 127.0.0.1) or a host name (e.g. localhost) to restrict "
"them to a specific network interface."
msgstr ""
"Po zadanom će poslužitelj koristiti sve raspoložive lokalne IP adrese. Da bi "
"adrese ograničili na neko određeno mrežno sučelje, navedite neku IP adresu "
"(na pr.: 127.0.0.1 ili ::1) ili naziv glavnog računala (na pr.: localhost)."

#: src/libvlc-module.c:945
msgid "RTSP server address"
msgstr "Adresa poslužitelja RTSP-a"

#: src/libvlc-module.c:947
msgid ""
"This defines the address the RTSP server will listen on, along with the base "
"path of the RTSP VOD media. Syntax is address/path. By default, the server "
"will listen on any local IP address. Specify an IP address (e.g. ::1 or "
"127.0.0.1) or a host name (e.g. localhost) to restrict them to a specific "
"network interface."
msgstr ""
"Tim se određuje adresa na kojoj će poslužitelj RTSP-a osluškivati, skupa s "
"osnovnom stazom medija RTSP VOD. Sintaksa glasi adresa/staza. Po zadanom će "
"poslužitelj koristiti sve raspoložive lokalne IP adrese. Da bi adrese "
"ograničili na neko određeno mrežno sučelje, navedite neku IP adresu (na pr.: "
"127.0.0.1 ili ::1) ili naziv glavnog računala (na pr.: localhost)."

#: src/libvlc-module.c:953
msgid "HTTP server port"
msgstr "Priključak poslužitelja HTTP-a"

#: src/libvlc-module.c:955
msgid ""
"The HTTP server will listen on this TCP port. The standard HTTP port number "
"is 80. However allocation of port numbers below 1025 is usually restricted "
"by the operating system."
msgstr ""
"Poslužitelj HTTP-a će osluškivati na tom priključku. Standardni priključak "
"za HTTP je 80. Dodjeljivanje brojeva priključaka u području ispod 1025 je "
"ionako obično ograničeno operacijskim sustavom."

#: src/libvlc-module.c:960
msgid "HTTPS server port"
msgstr "Priključak poslužitelja HTTPS-a"

#: src/libvlc-module.c:962
msgid ""
"The HTTPS server will listen on this TCP port. The standard HTTPS port "
"number is 443. However allocation of port numbers below 1025 is usually "
"restricted by the operating system."
msgstr ""
"Poslužitelj HTTPS-a će osluškivati na tom priključku TCP-a. Standardni "
"priključak za HTTPS je 443. Dodjeljivanje brojeva priključaka u području "
"ispod 1025 je ionako obično ograničeno operacijskim sustavom."

#: src/libvlc-module.c:967
msgid "RTSP server port"
msgstr "Priključak poslužitelja RTSP-a"

#: src/libvlc-module.c:969
msgid ""
"The RTSP server will listen on this TCP port. The standard RTSP port number "
"is 554. However allocation of port numbers below 1025 is usually restricted "
"by the operating system."
msgstr ""
"Poslužitelj RTSP-a će osluškivati na tom priključku TCP-a. Standardni "
"priključak za RTSP je 554. Dodjeljivanje brojeva priključaka u području "
"ispod 1025 je ionako obično ograničeno operacijskim sustavom."

#: src/libvlc-module.c:974
msgid "HTTP/TLS server certificate"
msgstr "Potvrda poslužitelja HTTP/TLS"

#: src/libvlc-module.c:976
msgid ""
"This X.509 certificate file (PEM format) is used for server-side TLS. On OS "
"X, the string is used as a label to search the certificate in the keychain."
msgstr ""
"Ova datoteka potvrde X.509 (u obliku PEM) se sa strane poslužitelja koristi "
"za TLS. Na OS X-u se niz koristi kao oznaka za traženje potvrde u privjesku "
"ključeva."

#: src/libvlc-module.c:979
msgid "HTTP/TLS server private key"
msgstr "Privatni ključ poslužitelja HTTP/TLS-a"

#: src/libvlc-module.c:981
msgid "This private key file (PEM format) is used for server-side TLS."
msgstr ""
"Ova datoteka privatnog ključa (u obliku PEM) se sa strane poslužitelja "
"koristi za TLS."

#: src/libvlc-module.c:983
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:339
msgid "HTTP proxy"
msgstr "Posrednički poslužitelj HTTP-a"

#: src/libvlc-module.c:985
msgid ""
"HTTP proxy to be used It must be of the form http://"
"[user@]myproxy.mydomain:myport/ ; if empty, the http_proxy environment "
"variable will be tried."
msgstr ""
"Posrednik HTTP-a koji će se koristiti. Unos mora biti u obliku http://"
"[korisnik@]mojposrednik.mojadomena:mojpriključak/ ; ako je prazno, bit će "
"iskušana varijabla okruženja http_proxy."

#: src/libvlc-module.c:989
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:340
msgid "HTTP proxy password"
msgstr "Zaporka za posrednika HTTP-a"

#: src/libvlc-module.c:991
msgid "If your HTTP proxy requires a password, set it here."
msgstr ""
"Ako Vaš posrednički poslužitelj HTTP-a iziskuje zaporku, zadajte je ovdje."

#: src/libvlc-module.c:993
msgid "Title metadata"
msgstr "Metapodaci naslova"

#: src/libvlc-module.c:995
msgid "Allows you to specify a \"title\" metadata for an input."
msgstr ""
"Dopušta Vam da odredite metapodatke \"naslova\" za neki ulazni sadržaj."

#: src/libvlc-module.c:997
msgid "Author metadata"
msgstr "Metapodaci autora"

#: src/libvlc-module.c:999
msgid "Allows you to specify an \"author\" metadata for an input."
msgstr "Dopušta Vam da odredite metapodatke \"autora\" za neki ulazni sadržaj."

#: src/libvlc-module.c:1001
msgid "Artist metadata"
msgstr "Metapodaci izvođača"

#: src/libvlc-module.c:1003
msgid "Allows you to specify an \"artist\" metadata for an input."
msgstr ""
"Dopušta Vam da odredite metapodatke \"izvođača\" za neki ulazni sadržaj."

#: src/libvlc-module.c:1005
msgid "Genre metadata"
msgstr "Metapodaci žanra"

#: src/libvlc-module.c:1007
msgid "Allows you to specify a \"genre\" metadata for an input."
msgstr "Dopušta Vam da odredite metapodatke \"žanra\" za neki ulazni sadržaj."

#: src/libvlc-module.c:1009
msgid "Copyright metadata"
msgstr "Metapodaci autorskih prava"

#: src/libvlc-module.c:1011
msgid "Allows you to specify a \"copyright\" metadata for an input."
msgstr ""
"Dopušta Vam da odredite metapodatke \"autorskih prava\" za neki ulazni "
"sadržaj."

#: src/libvlc-module.c:1013
msgid "Description metadata"
msgstr "Metapodaci opisa"

#: src/libvlc-module.c:1015
msgid "Allows you to specify a \"description\" metadata for an input."
msgstr "Dopušta Vam da odredite metapodatke \"opisa\" za neki ulazni sadržaj."

#: src/libvlc-module.c:1017
msgid "Date metadata"
msgstr "Metapodaci nadnevka"

#: src/libvlc-module.c:1019
msgid "Allows you to specify a \"date\" metadata for an input."
msgstr ""
"Dopušta Vam da odredite metapodatke \"nadnevka\" za neki ulazni sadržaj."

#: src/libvlc-module.c:1021
msgid "URL metadata"
msgstr "Metapodaci mrežne adrese"

#: src/libvlc-module.c:1023
msgid "Allows you to specify a \"url\" metadata for an input."
msgstr ""
"Dopušta Vam da odredite metapodatke \"mrežne adrese\" za neki ulazni sadržaj."

#: src/libvlc-module.c:1027
msgid ""
"These options allow you to control the preferred modules used for accessing, "
"demuxing and decoding (or encoding) inputs."
msgstr ""
"Ove mogućnosti omogućuju upravljanje željenim modulima koji se koriste za "
"pristup, demultipleksiranje i dekodiranje (ili kodiranje) ulaza."

#: src/libvlc-module.c:1030
msgid "Preferred decoders list"
msgstr "Popis poželjnih dekôdera"

#: src/libvlc-module.c:1032
msgid ""
"List of codecs that VLC will use in priority. For instance, 'dummy,a52' will "
"try the dummy and a52 codecs before trying the other ones. Only advanced "
"users should alter this option as it can break playback of all your streams."
msgstr ""
"Popis kôdeka koje će VLC prvenstveno koristiti. Primjerice 'dummy,a52' će "
"iskušati taj prividni kôdek i kôdeke a52 prije nego iskuša neki drugi. Ovu "
"mogućnost bi trebali mijenjati samo napredni korisnici, jer ona može "
"prekinuti izvedbu svih vaših strujanja."

#: src/libvlc-module.c:1037
msgid "Enable hardware decoders"
msgstr "Omogući sklopovske dekodere"

#: src/libvlc-module.c:1039
msgid ""
"VLC will fallback automatically to software decoders in case of hardware "
"decoder failure."
msgstr ""
"VLC će se automatski vratiti na programske dekodere ako sklopovski dekoder "
"zakaže."

#: src/libvlc-module.c:1042
msgid "Preferred decoder hardware device"
msgstr "Željeni sklopovski uređaj za dekodiranje"

#: src/libvlc-module.c:1043
msgid "This allows hardware decoding when available."
msgstr "Ovim se uključuje sklopovsko dekodiranje ukoliko je raspoloživo."

#: src/libvlc-module.c:1051
msgid ""
"These options allow you to set default global options for the stream output "
"subsystem."
msgstr ""
"Ove mogućnosti dopuštaju da postavite globalne mogućnosti podsustava izlaza "
"strujanja."

#: src/libvlc-module.c:1054
msgid "Default stream output chain"
msgstr "Zadani lanac izlaznog strujanja"

#: src/libvlc-module.c:1056
msgid ""
"You can enter here a default stream output chain. Refer to the documentation "
"to learn how to build such chains. Warning: this chain will be enabled for "
"all streams."
msgstr ""
"Ovdje možete unijeti zadani lanac izlaznog sadržaja strujanja. Proučite "
"dokumentaciju da bi saznali kako se tvore takvi lanci. Pozor: Ovaj lanac će "
"biti omogućen za sva strujanja."

#: src/libvlc-module.c:1060
msgid "Enable streaming of all ES"
msgstr "Omogući strujanje svih osnovnih strujanja"

#: src/libvlc-module.c:1062
msgid "Stream all elementary streams (video, audio and subtitles)"
msgstr "Struji sva osnovna strujanja (slika, zvuk i podnaslovi)"

#: src/libvlc-module.c:1064
msgid "Display while streaming"
msgstr "Prikazuj tijekom strujanja"

#: src/libvlc-module.c:1066
msgid "Play locally the stream while streaming it."
msgstr "Lokalno izvodi strujanje tijekom njegovog snimanja."

#: src/libvlc-module.c:1068
msgid "Enable video stream output"
msgstr "Omogući izlaz strujanja video zapisa"

#: src/libvlc-module.c:1070
msgid ""
"Choose whether the video stream should be redirected to the stream output "
"facility when this last one is enabled."
msgstr ""
"Birajte treba li strujanje video slike biti preusmjereno na napravu izlaznog "
"strujanja kada je ona uključena."

#: src/libvlc-module.c:1073
msgid "Enable audio stream output"
msgstr "Omogući izlaz strujanja zvuka"

#: src/libvlc-module.c:1075
msgid ""
"Choose whether the audio stream should be redirected to the stream output "
"facility when this last one is enabled."
msgstr ""
"Birajte treba li strujanje zvuka biti preusmjereno na napravu izlaznog "
"strujanja kada je ona uključena."

#: src/libvlc-module.c:1078
msgid "Enable SPU stream output"
msgstr "Omogući izlaz strujanja SPU"

#: src/libvlc-module.c:1080
msgid ""
"Choose whether the SPU streams should be redirected to the stream output "
"facility when this last one is enabled."
msgstr ""
"Odaberite treba li strujanje SPU-a biti preusmjereno na napravu izlaznog "
"strujanja kada je ona uključena."

#: src/libvlc-module.c:1083
msgid "Keep stream output open"
msgstr "Izlaz strujanja zadrži otvorenim"

#: src/libvlc-module.c:1085
msgid ""
"This allows you to keep an unique stream output instance across multiple "
"play queue items."
msgstr ""
"Ovim se omogućuje zadržavanje jedinstvene instance izlaznog strujanja kroz "
"više stavki reda izvođenja."

#: src/libvlc-module.c:1088
msgid "Stream output muxer caching (ms)"
msgstr "Predmemoriranje multiplekserovog izlaznog strujanja (ms)"

#: src/libvlc-module.c:1090
msgid ""
"This allow you to configure the initial caching amount for stream output "
"muxer. This value should be set in milliseconds."
msgstr ""

#: src/libvlc-module.c:1093
msgid "Preferred packetizer list"
msgstr "Popis poželjnih paketnika"

#: src/libvlc-module.c:1095
msgid ""
"This allows you to select the order in which VLC will choose its packetizers."
msgstr ""
"Ovo Vam omogućava da odaberete redoslijed kojim će VLC birati svoje "
"paketnike."

#: src/libvlc-module.c:1098
msgid "SAP announcement interval"
msgstr "Interval najavljivanja SAP-a"

#: src/libvlc-module.c:1100
msgid ""
"When the SAP flow control is disabled, this lets you set the fixed interval "
"between SAP announcements."
msgstr ""
"Ovo Vam, ukoliko je nadzor toka SAP-a isključen, dopušta da zadate ustaljeni "
"interval između najavljivanja SAP-a."

#: src/libvlc-module.c:1107
msgid "Access module"
msgstr "Modul pristupa"

#: src/libvlc-module.c:1109
msgid ""
"This allows you to force an access module. You can use it if the correct "
"access is not automatically detected. You should not set this as a global "
"option unless you really know what you are doing."
msgstr ""
"Ovo Vam omogućava da nametnete pristupni modul. Možete to upotrijebiti, "
"ukoliko ispravni pristup nije automatski prepoznat. No, ovo ne bi ste "
"trebali postavljati kao globalnu mogućnost, sve dok stvarno ne znate što "
"činite."

#: src/libvlc-module.c:1113
msgid "Stream filter module"
msgstr "Modul filtra strujanja"

#: src/libvlc-module.c:1115
#, fuzzy
msgid "Stream filters are used to modify the stream that is being read."
msgstr ""
"Filtri strujanja se koriste za preinačavanje strujanja koja se upravo "
"učitavaju."

#: src/libvlc-module.c:1117
#, fuzzy
msgid "Demux filter module"
msgstr "Modul filtra strujanja"

#: src/libvlc-module.c:1119
#, fuzzy
msgid "Demux filters are used to modify/control the stream that is being read."
msgstr ""
"Filtri strujanja se koriste za preinačavanje strujanja koja se upravo "
"učitavaju."

#: src/libvlc-module.c:1121
msgid "Demux module"
msgstr "Modul demultipleksera"

#: src/libvlc-module.c:1123
msgid ""
"Demultiplexers are used to separate the \"elementary\" streams (like audio "
"and video streams). You can use it if the correct demuxer is not "
"automatically detected. You should not set this as a global option unless "
"you really know what you are doing."
msgstr ""
"Demultiplekseri se koriste za rastavljanje \"osnovnih\" strujanja (poput "
"strujanja zvuka i slike). Ovo možete koristiti ukoliko nije automatski "
"prepoznat ispravni demuxer. No, ovo ne bi ste trebali postavljati kao "
"globalnu mogućnost, sve dok stvarno ne znate što činite."

#: src/libvlc-module.c:1128
msgid "Tracer module"
msgstr "Modul za praćenje"

#: src/libvlc-module.c:1130
msgid "This allow to select which tracer module you want to use."
msgstr "Omogućuje odabir modula za praćenje koji želite koristiti."

#: src/libvlc-module.c:1132
msgid "VLM configuration file"
msgstr "Datoteka prilagodbi VLM-a"

#: src/libvlc-module.c:1134
msgid "Read a VLM configuration file as soon as VLM is started."
msgstr "Učitaj datoteku prilagodbi VLM-a čim se pokrene VLM."

#: src/libvlc-module.c:1136
msgid "Use a plugins cache"
msgstr "Koristi predmemoriju dodataka"

#: src/libvlc-module.c:1138
msgid "Use a plugins cache which will greatly improve the startup time of VLC."
msgstr ""
"Za dodatke koristite međuspremnik, koji će znatno poboljšati vrijeme "
"pokretanja VLC-a."

#: src/libvlc-module.c:1140
msgid "Scan for new plugins"
msgstr ""

#: src/libvlc-module.c:1142
msgid ""
"Scan plugin directories for new plugins at startup. This increases the "
"startup time of VLC."
msgstr ""

#: src/libvlc-module.c:1145
#, fuzzy
msgid "Preferred keystore list"
msgstr "Popis poželjnih paketnika"

#: src/libvlc-module.c:1147
#, fuzzy
msgid "List of keystores that VLC will use in priority."
msgstr ""
"Ovo vam omogućava odabir popisa kôdera, koje će VLC prvenstveno koristiti."

#: src/libvlc-module.c:1149
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:23
msgid "Additional command line options"
msgstr "Dodatne mogućnosti naredbenog retka"

#: src/libvlc-module.c:1151
msgid ""
"Options VLC reads at every start, as if they were written on its command "
"line (the command line wins when it gives the same option). Write them as on "
"a command line, for example: --no-osd --network-caching=3000; quote a value "
"with spaces. Files to open, and the options only a command line can give (--"
"help, --config, --reset-config...), are left out."
msgstr ""
"Mogućnosti koje VLC čita pri svakom pokretanju, kao da su upisane u njegov "
"naredbeni redak (naredbeni redak ima prednost kada navodi istu mogućnost). "
"Upišite ih kao u naredbeni redak, primjerice: --no-osd --network-"
"caching=3000; vrijednost s razmacima stavite u navodnike. Datoteke za "
"otvaranje i mogućnosti koje može zadati samo naredbeni redak (--help, --"
"config, --reset-config...) se izostavljaju."

#: src/libvlc-module.c:1158
msgid "Locally collect statistics"
msgstr "Prikupljaj lokalne statistike"

#: src/libvlc-module.c:1160
msgid "Collect miscellaneous local statistics about the playing media."
msgstr "Prikuplja razne lokalne statistike o izvođenju medija."

#: src/libvlc-module.c:1162
msgid "Statistics collection frequency"
msgstr "Učestalost prikupljanja statistika"

#: src/libvlc-module.c:1164
msgid "Collection frequency of the statistics in ms."
msgstr "Učestalost prikupljanja statistika u ms."

#: src/libvlc-module.c:1166
msgid "Allow only one running instance"
msgstr "Dopusti samo jednu instancu"

#: src/libvlc-module.c:1168
msgid ""
"Allowing only one running instance of VLC can sometimes be useful, for "
"example if you associated VLC with some media types and you don't want a new "
"instance of VLC to be opened each time you open a file in your file manager. "
"This option will allow you to play the file with the already running "
"instance or enqueue it."
msgstr ""
"Dopuštanje samo jedne pokrenute instance VLC-a ponekad može biti korisno, "
"primjerice ako ste VLC pridružili nekim vrstama medija i ne želite da se "
"nova instanca VLC-a otvori svaki put kada otvorite datoteku u upravitelju "
"datoteka. Ova Vam mogućnost omogućuje da datoteku izvedete u već pokrenutoj "
"instanci ili je uvrstite u red izvođenja."

#: src/libvlc-module.c:1174
msgid "VLC is started from file association"
msgstr "VLC je pokrenut od pridružene datoteke"

#: src/libvlc-module.c:1176
msgid "Tell VLC that it is being launched due to a file association in the OS"
msgstr "Reci VLC-u da je pokrenut uslijed pridruženosti datoteka unutar OS-a"

#: src/libvlc-module.c:1179
msgid "Use only one instance when started from file manager"
msgstr "Koristi samo jednu instancu pri pokretanju iz upravitelja datoteka"

#: src/libvlc-module.c:1181
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:359
msgid "Increase the priority of the process"
msgstr "Povisi prioritet procesa"

#: src/libvlc-module.c:1183
msgid ""
"Increasing the priority of the process will very likely improve your playing "
"experience as it allows VLC not to be disturbed by other applications that "
"could otherwise take too much processor time. However be advised that in "
"certain circumstances (bugs) VLC could take all the processor time and "
"render the whole system unresponsive which might require a reboot of your "
"machine."
msgstr ""
"Povisivanje procesnog prioriteta će znatno poboljšati Vaš doživljaj "
"izvođenja, budući da se time VLC-u dopušta da bude neometan drugim "
"aplikacijama, koje bi mu inače mogle oduzeti previše procesorskog vremena. "
"No, pod stanovitim uvjetima (pogreške!) bi VLC mogao prisvojiti sve "
"procesorsko vrijeme i time cijeli sustav učiniti neosjetljivim na bilo kakve "
"daljnje unose, što bi pak moglo iziskivati ponovno pokretanje Vašeg računala."

#: src/libvlc-module.c:1190
msgid "Clock source"
msgstr "Ishodište sata"

#: src/libvlc-module.c:1208
msgid "Enqueue items into play queue in one instance mode"
msgstr "U načinu jedne instance uvrsti stavke u red izvođenja"

#: src/libvlc-module.c:1210
msgid ""
"When using the one instance only option, enqueue items to play queue and "
"keep playing current item."
msgstr ""
"Kada se koristi mogućnost samo jedne instance, stavke se uvrštavaju u red "
"izvođenja, a tekuća se stavka nastavlja izvoditi."

#: src/libvlc-module.c:1213
#, fuzzy
msgid "Expose media player via D-Bus"
msgstr "Dogradnje izvođača medija VLC"

#: src/libvlc-module.c:1214
msgid "Allow other applications to control VLC using the D-Bus MPRIS protocol."
msgstr ""

#: src/libvlc-module.c:1223
msgid ""
"These options define the behavior of the play queue. Some of them can be "
"overridden in the play queue dialog box."
msgstr ""
"Ove mogućnosti određuju ponašanje reda izvođenja. Neke od njih mogu biti "
"izmijenjene u dijaloškom okviru reda izvođenja."

#: src/libvlc-module.c:1226
msgid "Automatically preparse items"
msgstr "Automatski unaprijed raščlani stavke"

#: src/libvlc-module.c:1228
msgid ""
"Automatically preparse items added to the play queue (to retrieve some "
"metadata)."
msgstr ""
"Automatski unaprijed raščlanjuje stavke dodane u red izvođenja (radi "
"dohvaćanja nekih metapodataka)."

#: src/libvlc-module.c:1231
#, fuzzy
msgid "Preparsing timeout"
msgstr "Istek vremena"

#: src/libvlc-module.c:1233
#, fuzzy
msgid "Maximum time allowed to preparse an item, in milliseconds"
msgstr "Vrijednost međuspremanje za kamere i mikrofone, u milisekundama (ms)."

#: src/libvlc-module.c:1235
msgid "Preparsing threads"
msgstr "Niti za prethodnu raščlambu"

#: src/libvlc-module.c:1237
msgid "Maximum number of threads used to preparse items"
msgstr "Najveći broj niti koje se koriste za prethodnu raščlambu stavki"

#: src/libvlc-module.c:1239
msgid "Fetch-art threads"
msgstr "Niti za dohvaćanje omota"

#: src/libvlc-module.c:1241
msgid "Maximum number of threads used to fetch art"
msgstr "Najveći broj niti koje se koriste za dohvaćanje omota"

#: src/libvlc-module.c:1243
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:400
msgid "Allow metadata network access"
msgstr "Dopusti mrežni pristup za metapodatke"

#: src/libvlc-module.c:1248
msgid "Collapse"
msgstr "Sažmi"

#: src/libvlc-module.c:1248
msgid "Expand"
msgstr "Raširi"

#: src/libvlc-module.c:1250
msgid "Subdirectory behavior"
msgstr "Ponašanje pod-imenika"

#: src/libvlc-module.c:1252
msgid ""
"Select whether subdirectories must be expanded.\n"
"none: subdirectories do not appear in the play queue.\n"
"collapse: subdirectories appear but are expanded on first play.\n"
"expand: all subdirectories are expanded.\n"
msgstr ""
"Odaberite trebaju li se podmape proširivati.\n"
"none: podmape se ne pojavljuju u redu izvođenja.\n"
"collapse: podmape se pojavljuju, ali se proširuju pri prvom izvođenju.\n"
"expand: sve se podmape proširuju.\n"

#: src/libvlc-module.c:1257
msgid "Ignored extensions"
msgstr "Ignorirana proširenja"

#: src/libvlc-module.c:1259
msgid ""
"Files with these extensions will not be added to play queue when opening a "
"directory.\n"
"This is useful if you add directories that contain playlist files for "
"instance. Use a comma-separated list of extensions."
msgstr ""
"Datoteke s ovim nastavcima neće se dodavati u red izvođenja pri otvaranju "
"mape.\n"
"To je korisno ako, primjerice, dodajete mape koje sadrže datoteke popisa za "
"izvođenje. Koristite zarezom odvojeni popis nastavaka."

#: src/libvlc-module.c:1264
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:327
msgid "Show hidden files"
msgstr "Prikaži skrivene datoteke"

#: src/libvlc-module.c:1266
msgid "Ignore files starting with '.'"
msgstr "Zanemaruje datoteke koje počinju s '.'"

#: src/libvlc-module.c:1268
msgid "Flatten files listed by extractors (archive)"
msgstr "Izravnaj datoteke koje navode izdvajači (arhive)"

#: src/libvlc-module.c:1270
msgid "Services discovery modules"
msgstr "Moduli za istraživanje službi"

#: src/libvlc-module.c:1272
msgid ""
"Specifies the services discovery modules to preload, separated by colons. "
"Typical value is \"sap\"."
msgstr ""
"Specificira, razdvajano točka-zarezima, module za otkrivanje službi koje "
"treba učitati. Tipična vrijednost je \"sap\"."

#: src/libvlc-module.c:1275
msgid "Play files randomly forever"
msgstr "Datoteke izvodi uvijek nasumično"

#: src/libvlc-module.c:1277
msgid "VLC will randomly play files in the play queue until interrupted."
msgstr ""
"VLC će nasumično izvoditi datoteke iz reda izvođenja dok ga se ne prekine."

#: src/libvlc-module.c:1279
msgid "Repeat all"
msgstr "Opetuj sve"

#: src/libvlc-module.c:1281
msgid "VLC will keep playing the play queue indefinitely."
msgstr "VLC će neprekidno izvoditi red izvođenja."

#: src/libvlc-module.c:1283
msgid "Repeat current item"
msgstr "Opetuj tekuću stavku"

#: src/libvlc-module.c:1285
msgid "VLC will keep playing the current play queue item."
msgstr "VLC će ponavljati tekuću stavku reda izvođenja."

#: src/libvlc-module.c:1287
msgid "Play and stop"
msgstr "Izvedi i stani"

#: src/libvlc-module.c:1289
msgid "Stop playback after each item in the play queue."
msgstr "Zaustavlja izvođenje nakon svake stavke u redu izvođenja."

#: src/libvlc-module.c:1291
msgid "Play and exit"
msgstr "Izvedi i završi"

#: src/libvlc-module.c:1293
msgid "Exit if there are no more items in the play queue."
msgstr "Zatvara program ukoliko više nema stavki u redu izvođenja."

#: src/libvlc-module.c:1295
msgid "Play and pause"
msgstr "Izvedi i zastani"

#: src/libvlc-module.c:1297
msgid "Pause each item in the play queue on the last frame."
msgstr "Zastaje na posljednjem okviru svake stavke u redu izvođenja."

#: src/libvlc-module.c:1299
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:155
msgid "Start paused"
msgstr "Pokreni u stanci"

#: src/libvlc-module.c:1301
msgid "Pause each item in the play queue on the first frame."
msgstr "Zastaje na prvom okviru svake stavke u redu izvođenja."

#: src/libvlc-module.c:1303
msgid "Auto start"
msgstr "Automatski pokreni"

#: src/libvlc-module.c:1304
msgid "Automatically start playing the play queue content once it's loaded."
msgstr ""
"Automatski započinje izvođenje sadržaja reda izvođenja nakon što se učita."

#: src/libvlc-module.c:1307
msgid "Pause on audio communication"
msgstr "Stanka pri zvučnoj komunikaciji"

#: src/libvlc-module.c:1309
msgid ""
"If pending audio communication is detected, playback will be paused "
"automatically."
msgstr ""
"Ako se otkrije audio komunikacija u tijeku, automatski će se napraviti "
"stanka u izvođenju."

#: src/libvlc-module.c:1312
msgid "Use media library"
msgstr "Koristi knjižnicu medija"

#: src/libvlc-module.c:1314
msgid ""
"The media library is automatically saved and reloaded each time you start "
"VLC."
msgstr ""
"Knjižnica medija će se automatski spremati i ponovo učitavati svaki put kada "
"pokrenete VLC."

#: src/libvlc-module.c:1317
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:330
msgid "Use the media library"
msgstr "Koristi medijsku knjižnicu"

#: src/libvlc-module.c:1319
msgid ""
"Start the media library when VLC asks for it (the media player does). Turn "
"it off to browse without indexing your media; this takes effect the next "
"time VLC starts."
msgstr ""
"Pokreće medijsku knjižnicu kada je VLC zatraži (medijski izvođač to čini). "
"Isključite je za pregledavanje bez indeksiranja Vaših medija; to stupa na "
"snagu pri sljedećem pokretanju VLC-a."

#: src/libvlc-module.c:1323
msgid "Display play queue tree"
msgstr "Prikaži stablo reda izvođenja"

#: src/libvlc-module.c:1325
msgid ""
"The play queue can use a tree to categorize some items, like the contents of "
"a directory."
msgstr ""
"Red izvođenja može koristiti stablo za razvrstavanje nekih stavki, poput "
"sadržaja mape."

#: src/libvlc-module.c:1328
msgid "Play queue bookmark 1"
msgstr "Straničnik 1 reda izvođenja"

#: src/libvlc-module.c:1329
msgid "Play queue bookmark 2"
msgstr "Straničnik 2 reda izvođenja"

#: src/libvlc-module.c:1330
msgid "Play queue bookmark 3"
msgstr "Straničnik 3 reda izvođenja"

#: src/libvlc-module.c:1331
msgid "Play queue bookmark 4"
msgstr "Straničnik 4 reda izvođenja"

#: src/libvlc-module.c:1332
msgid "Play queue bookmark 5"
msgstr "Straničnik 5 reda izvođenja"

#: src/libvlc-module.c:1333
msgid "Play queue bookmark 6"
msgstr "Straničnik 6 reda izvođenja"

#: src/libvlc-module.c:1334
msgid "Play queue bookmark 7"
msgstr "Straničnik 7 reda izvođenja"

#: src/libvlc-module.c:1335
msgid "Play queue bookmark 8"
msgstr "Straničnik 8 reda izvođenja"

