msgid "The plugins could not be rescanned."
msgstr "Dodatke nije bilo moguće ponovno pretražiti."

#: modules/gui/qt/dialogs/preferences/config_model_audioscrobbler.cpp:153
msgid ""
"The plugins could not be rescanned: the folder of VLC may need administrator "
