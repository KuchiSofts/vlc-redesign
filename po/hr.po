#: modules/gui/qt/dialogs/preferences/config_model.cpp:254
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:29
msgid "Show what's new after an update"
msgstr "Prikaži novosti nakon ažuriranja"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:255
msgid ""
"The first time VLC opens after an update, a card lists what is new in the "
"version, with a link to the full changelog. The notes are in English."
msgstr ""
"Kad se VLC prvi put otvori nakon ažuriranja, kartica navodi novosti u "
"inačici, s poveznicom na potpuni popis promjena. Bilješke su na engleskom."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:257
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:368
msgid "Discover cast devices"
msgstr "Otkrivaj uređaje za emitiranje"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:258
msgid ""
"Looks for the cast devices of the local network when the Renderer menu opens."
msgstr ""
"Traži uređaje za emitiranje u lokalnoj mreži kada se otvori izbornik "
"Prikazivač."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:259
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:52
msgid "Remember window size and position"
msgstr "Zapamti veličinu i položaj prozora"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:260
msgid "Opens the window where it was when VLC was closed."
msgstr "Otvara prozor ondje gdje je bio kada je VLC zatvoren."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:262
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:53
msgid "Interface size"
msgstr ""

#: modules/gui/qt/dialogs/preferences/config_model.cpp:263
msgid ""
"How large the pages, texts and controls are drawn. Automatic picks the size "
"that suits this screen."
msgstr ""

#: modules/gui/qt/dialogs/preferences/config_model.cpp:264
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:77
msgid "Always show the player bar"
msgstr "Uvijek prikaži traku izvođača"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:265
msgid ""
"Keeps the player bar at the bottom of the library while nothing plays: Play "
"starts the play queue, or opens files when it is empty."
msgstr ""
"Zadržava traku izvođača na dnu knjižnice dok se ništa ne izvodi: Izvedi "
"pokreće red izvođenja ili otvara datoteke kada je on prazan."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:267
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:79
msgid "Increase text contrast"
msgstr "Povećaj kontrast teksta"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:268
msgid ""
"Draws the dim texts of the design (hints, descriptions, watched items) "
"brighter, to the contrast the WCAG accessibility guidelines ask for (AA)."
msgstr ""
"Prikazuje prigušene tekstove dizajna (savjete, opise, pogledane stavke) "
"svjetlije, do kontrasta koji zahtijevaju smjernice pristupačnosti WCAG (AA)."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:270
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:72
msgid "Popup duration"
msgstr "Trajanje skočnog prozora"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:271
msgid "How long the popup of the track changes stays on the screen."
msgstr "Koliko dugo skočni prozor promjene zapisa ostaje na zaslonu."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:272
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:360
msgid "Process priority"
msgstr "Prioritet procesa"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:273
msgid ""
"How much processor time the system gives VLC compared with the other "
"programs."
msgstr ""
"Koliko procesorskog vremena sustav daje VLC-u u odnosu na druge programe."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:274
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:207
msgid "Volume indicator"
msgstr "Kontrola glasnoće"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:275
msgid ""
"Where the volume shows when it changes (the wheel, the keys, mute). "
"Automatic: on the right side, on the left in a right-to-left language."
msgstr ""

#: modules/gui/qt/dialogs/preferences/config_model.cpp:277
msgid "Automatic|Right side|Left side|Top right corner|Top left corner"
msgstr ""

#: modules/gui/qt/dialogs/preferences/config_model.cpp:278
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:308
msgid "Double click on the video"
msgstr "Dvostruki klik na video"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:279
msgid "What a double click on the video does."
msgstr "Što radi dvostruki klik na video."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:279
msgid "Nothing|Toggle fullscreen"
msgstr "Ništa|Uključi/isključi cjelozaslonski prikaz"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:280
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:259
msgid "Size values"
msgstr "Vrijednosti veličine"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:281
msgid ""
"Choose the size of the subtitles by name (relative to the picture), or in "
"pixels."
msgstr ""
"Odaberite veličinu podnaslova po nazivu (u odnosu na sliku) ili u pikselima."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:282
msgid "Relative|Pixels"
msgstr "Relativno|Pikseli"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:283
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:275
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:276
#: modules/text_renderer/freetype/freetype.c:80
msgid "Background opacity"
msgstr "Neprozirnost pozadine"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:284
msgid ""
"How opaque the box behind the subtitles is when there is one (kept while "
"there is none)."
msgstr ""
"Koliko je neprozirna pozadina iza podnaslova kada postoji (zadržava se dok "
"je nema)."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:285
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:101
msgid "Never remember items matching"
msgstr "Nikad ne pamti stavke koje odgovaraju"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:286
msgid ""
"A regular expression: the items whose address or name matches it are not "
"saved in the history, nor their playback position."
msgstr ""
"Regularni izraz: stavke čija mu adresa ili naziv odgovara ne spremaju se u "
"povijest, kao ni njihov položaj izvođenja."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:289
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:104
msgid "Update the channels and the guide"
msgstr "Ažuriraj kanale i vodič"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:290
msgid ""
"How often the playlists and the programme guides are downloaded again, in "
"the background. Update in the sources does it at once."
msgstr ""
"Koliko se često popisi za izvođenje i programski vodiči ponovno preuzimaju u "
"pozadini. Ažuriranje u izvorima to čini odmah."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:292
msgid "Never|Every 6 hours|Every 12 hours|Every day|Every week"
msgstr "Nikada|Svakih 6 sati|Svakih 12 sati|Svaki dan|Svaki tjedan"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:293
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:105
msgid "Days of the guide kept"
msgstr "Dani vodiča koji se čuvaju"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:294
msgid ""
"How many days of programmes are kept before and after today. Fewer use less "
"memory with a large guide; the archives of the channels reach back as far as "
"this."
msgstr ""
"Koliko se dana emisija čuva prije i poslije današnjeg dana. Manje dana troši "
"manje memorije uz velik vodič; arhive kanala sežu najviše toliko unatrag."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:296
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:107
msgid "Hours across the guide"
msgstr "Sati u širini vodiča"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:297
msgid "The time the guide shows across its width."
msgstr "Vrijeme koje vodič prikazuje u svojoj širini."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:298
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:109
msgid "Guide languages"
msgstr "Jezici vodiča"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:299
msgid ""
"Keeps only the programmes in these languages when a guide gives several "
"(codes such as en, he, fr, separated by commas). Empty: every language."
msgstr ""
"Zadržava samo emisije na ovim jezicima kada vodič nudi više njih (kodovi "
"poput en, he, fr, odvojeni zarezima). Prazno: svi jezici."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:301
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:111
#: modules/gui/qt/qt.cpp:358
msgid "Channel banner"
msgstr "Natpis kanala"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:302
msgid "What the banner shows over the video when the channel changes."
msgstr "Što natpis prikazuje preko videa kada se kanal promijeni."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:303
msgid "Channel, now and next|Channel and now|Channel only|Nothing"
msgstr "Kanal, sada i sljedeće|Kanal i sada|Samo kanal|Ništa"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:304
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:113
msgid "Show programme descriptions"
msgstr "Prikaži opise emisija"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:305
msgid ""
"Shows the description of what is on in the channel lists and the banner."
msgstr "Prikazuje opis onoga što se emitira na popisima kanala i u natpisu."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:306
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:114
msgid "Show the progress of what is on"
msgstr "Prikaži napredak onoga što se emitira"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:307
msgid ""
"A bar of how much of the programme has played, from its start and end in the "
"guide."
msgstr ""
"Traka koja pokazuje koliko je emisije prošlo, prema njezinu početku i kraju "
"u vodiču."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:308
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:115
msgid "Show what is next"
msgstr "Prikaži što slijedi"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:309
msgid "Shows the next programme in the channel lists and the banner."
msgstr "Prikazuje sljedeću emisiju na popisima kanala i u natpisu."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:310
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:112
msgid "Start on the last channel"
msgstr "Pokreni na posljednjem kanalu"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:311
msgid "When VLC opens with nothing to play, the channel watched last plays."
msgstr ""
"Kada se VLC otvori bez ičega za reprodukciju, reproducira se posljednji "
"gledani kanal."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:312
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:116
msgid "Show adult channels"
msgstr "Prikaži kanale za odrasle"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:313
msgid "Lists the channels whose group or name says they are for adults."
msgstr "Navodi kanale čija grupa ili naziv govori da su za odrasle."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:326
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:297
msgid "System monospace"
msgstr "Sustavni font fiksne širine"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:326
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:258
