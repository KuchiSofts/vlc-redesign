#: src/libvlc-module.c:585
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:354
msgid "Clock synchronisation"
msgstr "Ժամացույցի համաժամացում"

#: src/libvlc-module.c:587
msgid ""
"It is possible to disable the input clock synchronisation for real-time "
"sources. Use this if you experience jerky playback of network streams."
msgstr ""
"Իրական ժամանակի աղբյուրների համար կարելի է անջատել մուտքի ժամացույցի "
"համաժամացումը։ Օգտագործեք սա, եթե ցանցային հոսքերը նվագարկվում են "
"ցնցումներով։"

#: src/libvlc-module.c:591
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:355
msgid "Clock jitter"
msgstr "Ժամացույցի տատանում"

#: src/libvlc-module.c:593
msgid ""
"This defines the maximum input delay jitter that the synchronization "
"algorithms should try to compensate (in milliseconds)."
msgstr ""
"Սա սահմանում է մուտքի հապաղման առավելագույն տատանումը, որը համաժամացման "
"ալգորիթմները պետք է փորձեն փոխհատուցել (միլիվայրկյաններով)։"

#: src/libvlc-module.c:596
msgid "Clock master source"
msgstr "Ժամացույցի հիմնական աղբյուր"

#: src/libvlc-module.c:597
msgid ""
"Select the clock master source:\n"
"auto: best clock source, input if the access can't be paced (when playing "
"live content), or audio otherwise (most likely).\n"
"input: all tracks are driven by the input clock, via PCR updates from the "
"demuxer. This restore the VLC 3.0 clock behavior where both audio and video "
"tracks can be altered to catch up with the input.\n"
"audio: if an audio track is playing, the audio output will drive the clock "
"(Fallback to Monotonic if there is no audio tracks).\n"
"monotonic: all tracks are driven by the monotonic clock of the system."
msgstr ""
"Ընտրեք ժամացույցի հիմնական աղբյուրը՝\n"
"ավտոմատ՝ լավագույն աղբյուրը. մուտքը, եթե մուտքի արագությունը հնարավոր չէ "
"կարգավորել (ուղիղ եթերի բովանդակություն նվագարկելիս), հակառակ դեպքում՝ ձայնը "
"(ամենահավանական տարբերակը)։\n"
"մուտք՝ բոլոր գծերը կառավարվում են մուտքի ժամացույցով՝ դեմուլտիպլեքսորից "
"ստացվող PCR թարմացումների միջոցով։ Սա վերականգնում է VLC 3.0-ի ժամացույցի "
"վարքը, երբ և՛ ձայնային, և՛ վիդեո գծերը կարող են փոփոխվել՝ մուտքին հասնելու "
"համար։\n"
"ձայն՝ եթե ձայնային գիծ է նվագարկվում, ժամացույցը կառավարում է ձայնի ելքը "
"(եթե ձայնային գծեր չկան, օգտագործվում է մոնոտոն ժամացույցը)։\n"
"մոնոտոն՝ բոլոր գծերը կառավարվում են համակարգի մոնոտոն ժամացույցով։"

