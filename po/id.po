#: src/libvlc-module.c:619
#: modules/gui/macosx/panels/VLCAudioEffectsWindowController.m:239
#: modules/gui/qt/dialogs/extended/extended_panels.cpp:941
msgid "Enable"
msgstr "Hidupkan"

#: src/libvlc-module.c:621
msgid "MTU of the network interface"
msgstr "MTU dari antarmuka jaringan"

#: src/libvlc-module.c:623
msgid ""
"This is the maximum application-layer packet size that can be transmitted "
"over the network (in bytes)."
msgstr ""
"Ini adalah ukuran maksimum paket lapisan-aplikasi yang dapat dikirimkan "
"melalui jaringan (dalam byte)."

#: src/libvlc-module.c:628 modules/stream_out/rtp.c:116
msgid "Hop limit (TTL)"
msgstr "Batasan hop (TTL)"

#: src/libvlc-module.c:630 modules/stream_out/rtp.c:118
msgid ""
"This is the hop limit (also known as \"Time-To-Live\" or TTL) of the "
"multicast packets sent by the stream output (-1 = use operating system built-"
"in default)."
msgstr ""
"Ini adalah batasan hop (juga dikenal sebagai \"Time-To-Live\" atau TTL) pada "
"paket multicast yang dkirim oleh output stream (-1 = gunakan default sistem "
"operasi)."

#: src/libvlc-module.c:634
msgid "Multicast output interface"
msgstr "Antarmuka output multicast"

#: src/libvlc-module.c:636
msgid "Default multicast interface. This overrides the routing table."
msgstr "Default antarmuka multicast. Ini akan menindih tabel route."

#: src/libvlc-module.c:638
msgid "DiffServ Code Point"
msgstr ""

#: src/libvlc-module.c:639
msgid ""
"Differentiated Services Code Point for outgoing UDP streams (or IPv4 Type Of "
"Service, or IPv6 Traffic Class). This is used for network Quality of Service."
msgstr ""

#: src/libvlc-module.c:645
msgid ""
"Choose the program to select by giving its Service ID. Only use this option "
"if you want to read a multi-program stream (like DVB streams for example)."
msgstr ""
"Pilih program dengan memberikan ID Servis. Hanya gunakan pilihan ini jika "
"Anda ingin membaca stream multi-program (contohnya stream DVB)."

#: src/libvlc-module.c:649 modules/gui/qt/menus/qml_menu_wrapper.cpp:687
#: modules/gui/qt/player/qml/controlbarcontrols/ProgramButton.qml:36
msgid "Programs"
msgstr "Program"

#: src/libvlc-module.c:651
msgid ""
"Choose the programs to select by giving a comma-separated list of Service "
"IDs (SIDs). Only use this option if you want to read a multi-program stream "
"(like DVB streams for example)."
msgstr ""
"Pilih program pilihan dengan memberi daftar ID Servis (SID) terpisah-koma. "
"Hanya gunakan pilihan ini jika Anda ingin membaca stream multi-program "
"(contoh stream DVB)."

#: src/libvlc-module.c:657
#: modules/gui/qt/medialibrary/qml/VideoInfoExpandPanel.qml:295
msgid "Video track"
msgstr "Trek video"

#: src/libvlc-module.c:659
msgid "Stream number of the video track to use (from 0 to n)."
msgstr ""

#: src/libvlc-module.c:662
#: modules/gui/qt/medialibrary/qml/VideoInfoExpandPanel.qml:307
msgid "Audio track"
msgstr "Trek audio"

#: src/libvlc-module.c:664
msgid "Stream number of the audio track to use (from 0 to n)."
msgstr "Nomor stream dari trek audio yang digunakan (dari 0 hingga n)."

#: src/libvlc-module.c:667
#: modules/gui/qt/medialibrary/qml/VideoInfoExpandPanel.qml:319
msgid "Subtitle track"
msgstr "Trek subtitle"

#: src/libvlc-module.c:669
msgid "Stream number of the subtitle track to use (from 0 to n)."
msgstr "Nomor stream dari trek subtitle yang digunakan (dari 0 hingga n)."

#: src/libvlc-module.c:672 modules/stream_out/transcode/transcode.c:97
msgid "Audio language"
msgstr "Bahasa audio"

#: src/libvlc-module.c:674
msgid ""
"Language of the audio track you want to use (comma separated, two or three "
"letter ISO-639 country code; you may use 'none' to avoid a fallback to "
"another language)."
msgstr ""
"Bahasa trek audio yang ingin Anda gunakan (dipisahkan koma, kode negara "
"ISO-639 dua atau tiga huruf; Anda dapat menggunakan 'none' agar tidak "
"beralih ke bahasa lain)."

#: src/libvlc-module.c:677
msgid "Subtitle language"
msgstr "Bahasa subtitle"

#: src/libvlc-module.c:679
msgid ""
"Language of the subtitle track you want to use (comma separated, two or "
"three letter ISO-639 country code; you may use 'any' as a fallback)."
msgstr ""
"Bahasa trek subtitle yang ingin Anda gunakan (dipisahkan koma, kode negara "
"ISO-639 dua atau tiga huruf; Anda dapat menggunakan 'any' sebagai cadangan)."

#: src/libvlc-module.c:682
msgid "Menu language"
msgstr "Bahasa menu"

#: src/libvlc-module.c:684
msgid ""
"Language of the menus you want to use with DVD/BluRay (comma separated, two "
"or three letter ISO-639 country code; you may use 'any' as a fallback)."
msgstr ""
"Bahasa menu yang ingin Anda gunakan untuk DVD/BluRay (dipisahkan koma, kode "
"negara ISO-639 dua atau tiga huruf; Anda dapat menggunakan 'any' sebagai "
"cadangan)."

#: src/libvlc-module.c:687
msgid "Video track ID"
msgstr ""

#: src/libvlc-module.c:689
msgid "Stream ID of the video track to use."
msgstr ""

#: src/libvlc-module.c:691
msgid "Audio track ID"
msgstr "Trek ID audio"

#: src/libvlc-module.c:693
msgid "Stream ID of the audio track to use."
msgstr "ID Stream trek audio yang digunakan."

#: src/libvlc-module.c:695
msgid "Subtitle track ID"
msgstr "ID Trek subtitle"

#: src/libvlc-module.c:697
msgid "Stream ID of the subtitle track to use."
msgstr "ID Stream trek subtitle yang digunakan."

#: src/libvlc-module.c:699
#, fuzzy
msgid "Preferred Closed Captions decoder"
msgstr "Daftar dekoder yang dikehendaki"

#: src/libvlc-module.c:703
msgid "Preferred video resolution"
msgstr "Resolusi video yang dikehendaki"

#: src/libvlc-module.c:705
msgid ""
"When several video formats are available, select one whose resolution is "
"closest to (but not higher than) this setting, in number of lines. Use this "
"option if you don't have enough CPU power or network bandwidth to play "
"higher resolutions."
msgstr ""
"Ketika tersedia beberapa format video, pilih salah satu yang memiliki "
"resolusi terdekat (namun tidak lebih tinggi dari) setting ini, dalam jumlah "
"baris. Gunakan pilihan ini jika Anda tidak memiliki daya CPU atau bandwidth "
"jaringan yang cukup untuk memainkan resolusi yang lebih tinggi."

#: src/libvlc-module.c:711
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:109
msgid "Best available"
msgstr "Yang terbaik yang tersedia"

#: src/libvlc-module.c:711
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:109
msgid "Full HD (1080p)"
msgstr "Full HD (1080p)"

#: src/libvlc-module.c:711
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:109
msgid "HD (720p)"
msgstr "HD (720p)"

#: src/libvlc-module.c:712
msgid "Standard Definition (576 or 480 lines)"
msgstr "Definisi Standar (576 atau 480 baris)"

#: src/libvlc-module.c:713
msgid "Low Definition (360 lines)"
msgstr "Definisi Rendah (360 baris)"

#: src/libvlc-module.c:714
msgid "Very Low Definition (240 lines)"
msgstr "Definisi Sangat Rendah (240 baris)"

#: src/libvlc-module.c:717
msgid "Low delay mode"
msgstr ""

#: src/libvlc-module.c:719
msgid ""
"Try to minimize delay along decoding chain. Might break with non compliant "
"streams."
msgstr ""

#: src/libvlc-module.c:722
msgid "Input repetitions"
msgstr "Pengulangan input"

#: src/libvlc-module.c:724
msgid "Number of time the same input will be repeated"
msgstr "Jumlah waktu input yang sama akan diulang"

#: src/libvlc-module.c:726
#: modules/gui/macosx/windows/VLCOpenWindowController.m:225
msgid "Start time"
msgstr "Waktu mulai"

#: src/libvlc-module.c:728
msgid "The stream will start at this position (in seconds)."
msgstr "Stream akan dimulai pada posisi ini (dalam detik)."

#: src/libvlc-module.c:730
#: modules/gui/macosx/windows/VLCOpenWindowController.m:227
msgid "Stop time"
msgstr "Waktu henti"

#: src/libvlc-module.c:732
msgid "The stream will stop at this position (in seconds)."
msgstr "Stream akan dihentikan pada posisi ini (dalam detik)."

#: src/libvlc-module.c:734
msgid "Run time"
msgstr "Run time"

#: src/libvlc-module.c:736
msgid "The stream will run this duration (in seconds)."
msgstr "Stream ini akan dijalankan pada durasi ini (dalam detik)."

#: src/libvlc-module.c:738
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:401
msgid "Fast seek"
msgstr "Melihat cepat"

#: src/libvlc-module.c:740
msgid "Favor speed over precision while seeking"
msgstr ""

#: src/libvlc-module.c:742 modules/gui/qt/player/qml/PlaybackSpeed.qml:221
#: modules/gui/qt/player/qml/TracksMenu.qml:315
msgid "Playback speed"
msgstr "Kecepatan playback"

#: src/libvlc-module.c:744
msgid "This defines the playback speed (nominal speed is 1.0)."
msgstr "Ini menentukan kecepatan playback (kecepatan nominal adalah 1.0)."

#: src/libvlc-module.c:746
msgid "Input list"
msgstr "Daftar input"

#: src/libvlc-module.c:748
msgid ""
"You can give a comma-separated list of inputs that will be concatenated "
"together after the normal one."
msgstr ""
"Anda dapat memberikan daftar input terpisah koma yang akan dicantumkan "
"bersama setelah yang normal."

#: src/libvlc-module.c:751
msgid "Input slave (experimental)"
msgstr "Input slave (eksperimen)"

#: src/libvlc-module.c:753
msgid ""
"This allows you to play from several inputs at the same time. This feature "
"is experimental, not all formats are supported. Use a '#' separated list of "
"inputs."
msgstr ""
"Ini akan mengizinkan Anda menayangkan beberapa input pada waktu bersamaan. "
"Fitur ini adalah eksperimen, tidak semua format didukung. Gunakan daftar "
"input dipisah '#'. "

#: src/libvlc-module.c:757
msgid "Bookmarks list for a stream"
msgstr "Senarai tandabuku untuk strim"

#: src/libvlc-module.c:759
msgid ""
"You can manually give a list of bookmarks for a stream in the form "
"\"{name=bookmark-name,time=optional-time-offset,bytes=optional-byte-offset},"
"{...}\""
msgstr ""
"Anda dapat secara manual menambahkan daftar tandabuku untuk strim dalam "
"bentuk \"{name=bookmark-name,time=optional-time-offset,bytes=optional-byte-"
"offset},{...}\""

#: src/libvlc-module.c:763
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:92
msgid "Save recently played items"
msgstr "Simpan item yang baru dimainkan ke dalam menu"

#: src/libvlc-module.c:765
#: modules/gui/macosx/panels/dialogs/VLCResumeDialogController.m:65
#: modules/gui/macosx/panels/dialogs/VLCResumeDialogController.m:66
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:414
msgid "Continue playback"
msgstr "Lanjutkan pemutaran"

#: src/libvlc-module.c:766
msgid "Should the playback resume where it was left off?"
msgstr "Haruskah pemutaran dilanjutkan dari posisi terakhir?"

#: src/libvlc-module.c:775
msgid "Never resume playback where it was left off"
msgstr "Jangan pernah melanjutkan pemutaran dari posisi terakhir"

#: src/libvlc-module.c:776
msgid "Ask when the playback starts"
msgstr "Tanyakan saat pemutaran dimulai"

#: src/libvlc-module.c:777
msgid "Always resume playback where it was left off"
msgstr "Selalu lanjutkan pemutaran dari posisi terakhir"

#: src/libvlc-module.c:780
msgid "Resume last playback states"
msgstr "Pulihkan status pemutaran terakhir"

#: src/libvlc-module.c:781
msgid ""
"This will resume the last playback state, such as the selected tracks, rate, "
"aspect-ratio, ..."
msgstr ""
"Ini akan memulihkan status pemutaran terakhir, seperti trek yang dipilih, "
"kecepatan, rasio aspek, ..."

#: src/libvlc-module.c:784
msgid "Record directory"
msgstr "Direktori rekaman"

#: src/libvlc-module.c:786
msgid "Directory where the records will be stored"
msgstr "Direktori tempat rekaman akan disimpan"

#: src/libvlc-module.c:788
msgid "Prefer native stream recording"
msgstr "Cenderung merekam stream asli"

#: src/libvlc-module.c:790
msgid ""
"When possible, the input stream will be recorded instead of using the stream "
"output module"
msgstr ""
"Bila dimungkinkan, stream masukan akan direkam, bukan menggunakan modul "
"stream output"

#: src/libvlc-module.c:793
msgid "Timeshift directory"
msgstr "Direktori peralihan waktu"

#: src/libvlc-module.c:795
msgid "Directory used to store the timeshift temporary files."
msgstr ""
"Direktori yang digunakan untuk menyimpan file peralihan waktu sementara."

#: src/libvlc-module.c:797
msgid "Timeshift granularity"
msgstr "Granularitas peralihan waktu"

#: src/libvlc-module.c:799
msgid ""
"This is the maximum size in bytes of the temporary files that will be used "
"to store the timeshifted streams."
msgstr ""
"Ini adalah ukuran maksimum dalam byte dari file sementara yang akan "
"digunakan untuk menyimpan stream peralihan waktu."

#: src/libvlc-module.c:802
msgid "Change title according to current media"
msgstr "Ganti judul sesuai media saat ini"

#: src/libvlc-module.c:803
msgid ""
"This option allows you to set the title according to what's being "
"played<br>$a: Artist<br>$b: Album<br>$c: Copyright<br>$t: Title<br>$g: "
"Genre<br>$n: Track num<br>$p: Now playing<br>$A: Date<br>$D: Duration<br>$Z: "
"\"Now playing\" (Fall back on Title - Artist)"
msgstr ""

#: src/libvlc-module.c:810
msgid ""
"These options allow you to modify the behavior of the subpictures subsystem. "
"You can for example enable subpictures sources (logo, etc.). Enable these "
"filters here and configure them in the \"subsources filters\" modules "
"section. You can also set many miscellaneous subpictures options."
msgstr ""
"Opsi ini mengizinkan anda mengubah perilaku subsistem subgambar. Anda dapat "
"sebagai contoh menghidupkan filter subgambar (logo, dll.). Aktifkan filter "
"ini di sini dan konfigurasi mereka dalam bagian modul \"filter subgambar\". "
"Anda dapat juga menyetel berbagai opsi subgambar."

#: src/libvlc-module.c:816
msgid "Force subtitle position"
msgstr "Paksa posisi subtitle"

#: src/libvlc-module.c:818
msgid ""
"You can use this option to place the subtitles under the movie, instead of "
"over the movie. Try several positions."
msgstr ""
"Anda dapat menggunakan pilihan ini untuk menempatkan subtitle di bawah film, "
"alih-alih di atas film. Coba beberapa posisi."

#: src/libvlc-module.c:821
msgid "Subtitle position"
msgstr "Posisi subtitle"

#: src/libvlc-module.c:823
msgid ""
"How high the subtitles are, in percent of the height of the picture above "
"their usual place (below it when negative). The same on any screen and in "
"any window size."
msgstr ""
"Seberapa tinggi letak subtitle, dalam persen tinggi gambar di atas tempat "
"biasanya (di bawahnya bila negatif). Sama di layar apa pun dan pada ukuran "
"jendela apa pun."

#: src/libvlc-module.c:827
msgid "Subtitles text scaling factor"
msgstr "Faktor skala teks subtitle"

#: src/libvlc-module.c:828
msgid "Changes the subtitles size where possible"
msgstr "Mengubah ukuran subtitle bila memungkinkan"

#: src/libvlc-module.c:830
msgid "Enable sub-pictures"
msgstr "Hidupkan sub-gambar"

#: src/libvlc-module.c:832
msgid "You can completely disable the sub-picture processing."
msgstr "Anda dapat mematikan pemrosesan sub-gambar secara keseluruhan."

#: src/libvlc-module.c:834
msgid "Display sub-pictures on full window"
msgstr ""

#: src/libvlc-module.c:836
msgid "It allows showing subtitles in black bars."
msgstr ""

#: src/libvlc-module.c:838
msgid "Position of secondary subtitles"
msgstr ""

#: src/libvlc-module.c:840
msgid ""
"Place on video where to display secondary subtitles (default bottom center)."
msgstr ""

#: src/libvlc-module.c:842
msgid "Force secondary subtitle position"
msgstr ""

#: src/libvlc-module.c:844
msgid ""
"You can use this option to vertically adjust the position secondary "
"subtitles are displayed."
msgstr ""

#: src/libvlc-module.c:847
msgid "On Screen Display duration"
msgstr "Durasi On Screen Display"

#: src/libvlc-module.c:849
msgid "How long the messages of the On Screen Display stay, in milliseconds."
msgstr "Berapa lama pesan On Screen Display ditampilkan, dalam milidetik."

#: src/libvlc-module.c:850 src/libvlc-module.c:1827 src/text/iso-639_def.h:573
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:441
msgid "On Screen Display"
msgstr "Tampilan Atas Layar (OSD)"

#: src/libvlc-module.c:852
msgid ""
"VLC can display messages on the video. This is called OSD (On Screen "
"Display)."
msgstr ""
"VLC dapat menampilkan pesan di atas video. Ini disebut OSD (Tampilan Atas "
"Layar)."

#: src/libvlc-module.c:855
msgid "Text rendering module"
msgstr "Modul perenderan teks"

#: src/libvlc-module.c:857
msgid ""
"VLC normally uses Freetype for rendering, but this allows you to use svg for "
"instance."
msgstr ""
"VLC biasanya menggunakan Freetype untuk merender, tetapi ini mengizinkan "
"Anda untuk menggunakan svg sebagai instans."

#: src/libvlc-module.c:859
msgid "Subpictures source module"
msgstr "Modul sumber subgambar"

#: src/libvlc-module.c:861
msgid ""
"This adds so-called \"subpicture sources\". These filters overlay some "
"images or text over the video (like a logo, arbitrary text, ...)."
msgstr ""

#: src/libvlc-module.c:864
msgid "Subpictures filter module"
msgstr "Modul filter subgambar"

#: src/libvlc-module.c:866
msgid ""
"This adds so-called \"subpicture filters\". These filter subpictures created "
"by subtitle decoders or other subpictures sources."
msgstr ""

#: src/libvlc-module.c:869
msgid "Autodetect subtitle files"
msgstr "Deteksi otomatis file subtitle"

#: src/libvlc-module.c:871
msgid ""
"Automatically detect a subtitle file, if no subtitle filename is specified "
"(based on the filename of the movie)."
msgstr ""
"Deteksi otomatis file subtitle, jika tidak terdapat file subtitle yang "
"ditentukan (berdasarkan pada nama file film)."

#: src/libvlc-module.c:874
msgid "Subtitle autodetection fuzziness"
msgstr "Kekaburan deteksi otomatis subtitle"

#: src/libvlc-module.c:876
msgid ""
"This determines how fuzzy subtitle and movie filename matching will be. "
"Options are:\n"
"0 = no subtitles autodetected\n"
"1 = any subtitle file\n"
"2 = any subtitle file containing the movie name\n"
"3 = subtitle file matching the movie name with additional chars\n"
"4 = subtitle file matching the movie name exactly"
msgstr ""
"Ini menentukan bagaimana subtitle kabur dan nama file film akan dipadankan. "
"Pilihan adalah:\n"
"0 = tidak ada subtitle dideteksi secara otomatis\n"
"1 = sembarang file subtitle\n"
"2 = sembarang file subtitle yang mengandung nama film\n"
"3 = file subtitle yang sama dengan nama film dengan karakter tambahan\n"
"4 = file subtitle yang sama persis dengan nama film"

#: src/libvlc-module.c:884
msgid "Subtitle autodetection paths"
msgstr "Path untuk deteksi otomatis subtitle"

#: src/libvlc-module.c:886
msgid ""
"Look for a subtitle file in those paths too, if your subtitle file was not "
"found in the current directory."
msgstr ""
"Cari file subtitle dalam path ini juga, jika file subtitle Anda tidak "
"ditemukan dalam direktori saat ini."

#: src/libvlc-module.c:889
msgid "Subtitle Frames per Second"
msgstr ""

#: src/libvlc-module.c:891
msgid "Override the normal frames per second settings. "
msgstr ""

#: src/libvlc-module.c:893
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:249
#: modules/spu/subsdelay.c:267
msgid "Subtitle delay"
msgstr "Penundaan subtitle"

#: src/libvlc-module.c:895
msgid "Apply a delay to all subtitles (in 1/10s, eg 100 means 10s)."
msgstr ""
