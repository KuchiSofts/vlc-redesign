#: src/libvlc-module.c:403 src/video_output/vout_intf.c:169
msgid "Right Only"
msgstr "Solo destra"

#: src/libvlc-module.c:404 src/video_output/vout_intf.c:170
msgid "Side-by-Side"
msgstr "Affiancato"

#: src/libvlc-module.c:427
msgid "Disable screensaver"
msgstr "Disabilita salvaschermo"

#: src/libvlc-module.c:428
msgid "Disable the screensaver during video playback."
msgstr "Disabilita il salvaschermo durante la riproduzione video."

#: src/libvlc-module.c:432 modules/gui/macosx/main/macosx.m:125
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:51
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:85
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:125
