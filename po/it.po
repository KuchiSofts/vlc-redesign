msgstr "Sopra il normale"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1521
msgid "Below normal"
msgstr "Sotto il normale"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1521
msgid "Idle"
msgstr "Basso"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1639
msgid "Current screen"
msgstr "Schermo attuale"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1644
msgid "Screen %1 (%2)"
msgstr "Schermo %1 (%2)"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1650
msgid "Screen %1"
msgstr "Schermo %1"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1659
msgid "Any title"
msgstr "Qualsiasi titolo"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1659
msgid "Contains title"
msgstr "Contiene il titolo"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1660
msgid "Title with extra characters"
msgstr "Titolo con caratteri aggiuntivi"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1660
msgid "Exact title match"
msgstr "Titolo esatto"

#: modules/gui/qt/dialogs/preferences/config_model_audioscrobbler.cpp:92
msgid "The audio output in use does not keep a startup volume."
msgstr "L'uscita audio in uso non mantiene un volume all'avvio."

