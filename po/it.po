msgstr "Ultraveloce"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:379
msgid "Super fast"
msgstr "Superveloce"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:380
msgid "Very fast"
msgstr "Molto veloce"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:382
msgid "Very slow"
msgstr "Molto lento"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:382
msgid "Placebo"
msgstr "Placebo"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:384
msgid "Film"
msgstr "Film"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:384
#: modules/video_filter/grain.c:64
msgid "Grain"
msgstr "Granulosità"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:385
msgid "Still image"
msgstr "Immagine fissa"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:386
msgid "Fast decoding"
msgstr "Decodifica veloce"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:386
msgid "Zero latency"
msgstr "Latenza zero"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:970
msgid "%1: this value can not be used."
msgstr "%1: questo valore non può essere usato."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1033
#: modules/gui/qt/dialogs/preferences/config_model.cpp:1062
msgid "%1 is not available in this VLC installation."
msgstr "%1 non è disponibile in questa installazione di VLC."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1047
msgid "This setting"
msgstr "Questa impostazione"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1057
msgid "%1: choose a folder of this computer."
msgstr "%1: scegli una cartella di questo computer."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1086
msgid "Select a category to reset."
msgstr "Seleziona una categoria da ripristinare."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1148
msgid "Repeat the current item (One) or the whole play queue (All)."
msgstr ""
"Ripete l'elemento corrente (Uno) o l'intera coda di riproduzione (Tutto)."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1149
msgid "One"
msgstr "Uno"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1156
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:141
msgid "When playback finishes"
msgstr "Al termine della riproduzione"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1157
msgid "Stop, or quit VLC at the end of the play queue."
msgstr "Interrompe o chiude VLC alla fine della coda di riproduzione."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1165
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:47
msgid "Use a custom skin"
msgstr "Usa una skin personalizzata"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1166
msgid "Starts VLC with the skin chosen below instead of this interface."
msgstr "Avvia VLC con la skin scelta qui sotto anziché con questa interfaccia."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1182
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:100
msgid "Remember the playback position"
msgstr "Ricorda la posizione di riproduzione"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1183
msgid "Lets VLC continue the media where you left off."
msgstr "Permette a VLC di riprendere il media da dove lo avevi lasciato."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1197
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:311
msgid "Reverse scroll direction"
msgstr "Inverti direzione di scorrimento"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1198
msgid "The wheels that seek go backwards when turned forwards."
msgstr ""
"Le rotelle che spostano la posizione vanno indietro quando girate in avanti."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1213
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:314
msgid "Web remote control"
msgstr "Controllo remoto via web"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1214
msgid ""
"Lets a web browser control VLC. Set its password in the Advanced Options."
msgstr ""
"Permette di controllare VLC da un browser web. Imposta la password nelle "
"Opzioni avanzate."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1232
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:352
msgid "Video post-processing"
msgstr "Post-elaborazione video"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1233
msgid ""
"Improves the picture of poorly encoded videos, at the cost of processing "
"power."
msgstr ""
"Migliora l'immagine dei video codificati male, a scapito della potenza di "
"elaborazione."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1282
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:239
msgid "Visualization size"
msgstr "Dimensione visualizzazione"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1283
msgid "The size the visualizations are drawn at."
msgstr "La dimensione con cui vengono disegnate le visualizzazioni."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1284
msgid "Match window"
msgstr "Adatta alla finestra"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1325
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:142
msgid "Seek precisely"
msgstr "Spostamento preciso"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1326
msgid ""
"Seek to the exact time asked, slower than seeking to the nearest key frame."
msgstr ""
"Si sposta al momento esatto richiesto, più lentamente rispetto al fotogramma "
"chiave più vicino."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1409
#: modules/gui/qt/dialogs/preferences/simple_preferences.cpp:691
