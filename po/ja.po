#: src/libvlc-module.c:323
msgid "Zoom video"
msgstr "ビデオの拡大"

#: src/libvlc-module.c:325
msgid "You can zoom the video by the specified factor."
msgstr "指定係数でビデオをズームすることが可能です。"

#: src/libvlc-module.c:327
msgid "Grayscale video output"
msgstr "グレースケールビデオ出力"

#: src/libvlc-module.c:329
msgid ""
"Output video in grayscale. As the color information aren't decoded, this can "
"save some processing power."
msgstr ""
"ビデオをグレースケールで出力します。カラー情報はデコードされませんが、CPUパ"
"ワーをセーブすることが可能です。"

#: src/libvlc-module.c:332
msgid "Embedded video"
msgstr "埋め込みビデオ"

#: src/libvlc-module.c:334
msgid "Embed the video output in the main interface."
msgstr "メインインターフェースにビデオ出力を統合します。"

#: src/libvlc-module.c:336
msgid "Fullscreen video output"
msgstr "全画面ビデオ出力"

#: src/libvlc-module.c:338
msgid "Start video in fullscreen mode"
msgstr "全画面表示モードでビデオを開始します。"

#: src/libvlc-module.c:340
msgid "360 videos projection mode"
msgstr "360度ビデオの投影法"

#: src/libvlc-module.c:342
msgid "Change the 360 video projection mode."
msgstr "360度ビデオの投影法を変更します。"

#: src/libvlc-module.c:344 src/video_output/vout_intf.c:316
#: modules/gui/qt/util/csdmenu.cpp:125
msgid "Always on top"
msgstr "常に最前面"

#: src/libvlc-module.c:346
msgid "Always place the video window on top of other windows."
msgstr "常にビデオウィンドウを他のウィンドウの前面に表示します。"

#: src/libvlc-module.c:348
msgid "Enable wallpaper mode"
msgstr "壁紙モードの有効化"

#: src/libvlc-module.c:350
msgid ""
"The wallpaper mode allows you to display the video as the desktop background."
msgstr "壁紙モードはデスクトップの背景としてビデオを表示することが可能です。"

#: src/libvlc-module.c:353
msgid "Show media title on video"
msgstr "ビデオにメディアタイトルを表示"

#: src/libvlc-module.c:355
msgid "Display the title of the video on top of the movie."
msgstr "ビデオタイトルを映画に重ねて表示します。"

#: src/libvlc-module.c:357
msgid "Show video title for x milliseconds"
msgstr "ビデオタイトルを表示する時間(ミリ秒)"

#: src/libvlc-module.c:359
msgid "Show the video title for n milliseconds, default is 5000 ms (5 sec.)"
msgstr ""
"ビデオタイトルを表示する時間をミリ秒で設定します。デフォルトは5000ミリ秒(5秒)"
"です。"

#: src/libvlc-module.c:361
msgid "Position of video title"
msgstr "ビデオタイトルの位置"

#: src/libvlc-module.c:363
msgid "Place on video where to display the title (default bottom center)."
msgstr "ビデオ上のタイトル表示位置(デフォルトは中央下)を設定します。"

#: src/libvlc-module.c:365
msgid "Hide cursor and fullscreen controller after x milliseconds"
msgstr "カーソルと全画面表示コントローラーを隠すまでの時間(ミリ秒)"

