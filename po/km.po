msgid "Debug mask"
msgstr "របាំង​បំបាត់​កំហុស"

#: modules/codec/avcodec/avcodec.h:80
msgid "Codec name"
msgstr "កូឌិក​ឈ្មោះ"

#: modules/codec/avcodec/avcodec.h:81
