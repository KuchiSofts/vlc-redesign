msgstr ""
"<i>VLC ಮೆನುಪಟ್ಟಿ ಅಥವಾ ಪಿನ್ ಮಾಡಿದ ನಿಯಂತ್ರಣಗಳಿಲ್ಲದ, ಆದರೆ ಕ್ಲೈಂಟ್-ಸೈಡ್ ಅಲಂಕಾರವಿರುವ "
"ಆಧುನಿಕ ವಿನ್ಯಾಸವನ್ನು ಬಳಸುತ್ತದೆ</i>"

#: modules/gui/qt/dialogs/firstrun/firstrunwizard.cpp:233
msgid ""
"<i>VLC will use a classic layout with a menubar and pinned controls but with "
"no client-side decoration</i>"
msgstr ""
"<i>VLC ಮೆನುಪಟ್ಟಿ ಮತ್ತು ಪಿನ್ ಮಾಡಿದ ನಿಯಂತ್ರಣಗಳಿರುವ, ಆದರೆ ಕ್ಲೈಂಟ್-ಸೈಡ್ ಅಲಂಕಾರವಿಲ್ಲದ "
"ಸಾಂಪ್ರದಾಯಿಕ ವಿನ್ಯಾಸವನ್ನು ಬಳಸುತ್ತದೆ</i>"

