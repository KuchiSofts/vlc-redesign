#: src/libvlc-module.c:224
msgid "This adds audio post processing filters, to modify the sound rendering."
msgstr ""
"ಇದು ಧ್ವನಿ ಸಲ್ಲಿಸುವಿಕೆಯನ್ನು ಮಾರ್ಪಡಿಸಲು ಧ್ವನಿ ನಂತರದ ಸಂಸ್ಕರಣಾ ಶೋಧಕಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ."

#: src/libvlc-module.c:229
msgid "This adds visualization modules (spectrum analyzer, etc.)."
msgstr ""
"ಇದು ದೃಶ್ಯೀಕರಣ ಘಟಕಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ (ವರ್ಣಪಟಲದ ವಿಶ್ಲೇಷಕ ವಿಶ್ಲೇಷಕ, ಇತ್ಯಾದಿ)."

#: src/libvlc-module.c:233
msgid "Replay gain mode"
msgstr "ಪ್ರಸಾರಣದ ಗಳಿಕೆಯ ಕ್ರಮ"

#: src/libvlc-module.c:236
msgid "Replay preamp"
msgstr "ಪ್ರಸಾರಣದ ಪೂರ್ವವರ್ಧನೆ"

#: src/libvlc-module.c:238
msgid ""
"This allows you to change the default target level (89 dB) for stream with "
"replay gain information"
msgstr ""
"ಇದು ನಿಮಗೆ ಸ್ಟ್ರೀಮ್ ನ ರಿಪ್ಲೇ ಗಳಿಕೆಯ ಮಾಹಿತಿಯ ಪೂರ್ವನಿಯೋಜಿತ ಗುರಿಯ ಮಟ್ಟ 89 dB ಯನ್ನು "
"ಬದಲಾಯಿಸಲು ಅನುಮತಿಸುತ್ತದೆ"

#: src/libvlc-module.c:241
msgid "Default replay gain"
msgstr "ಪೂರ್ವನಿಯೋಜಿತ ಪ್ರಸಾರಣದ ಗಳಿಕೆ"

#: src/libvlc-module.c:243
msgid "This is the gain used for stream without replay gain information"
msgstr "ಇದು ಗಳಿಕೆಯು ಮಾಹಿತಿ ಇಲ್ಲದೆ ಪ್ರಸಾರಣದ ಗಳಿಕೆಯ ಸ್ಟ್ರೀಮ್ ಗೆ  ಬಳಸಲಾಗುತ್ತದೆ"

#: src/libvlc-module.c:245
msgid "Peak protection"
msgstr "ಅತ್ಯುಚ್ಚ ರಕ್ಷಣೆ"

#: src/libvlc-module.c:247
msgid "Protect against sound clipping"
msgstr "ಧ್ವನಿ ಕತ್ತರಿಸುವಿಕೆಯ ವಿರುದ್ಧ ರಕ್ಷಣೆ"

#: src/libvlc-module.c:250
msgid "Enable time stretching audio"
msgstr "ಸಮಯ ಹಿಗ್ಗಿಸುವ ಧ್ವನಿಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ"

#: src/libvlc-module.c:252
msgid ""
"This allows playing audio at lower or higher speed without affecting the "
"audio pitch"
msgstr ""
"ಇದು ಕಡಿಮೆ ಅಥವಾ ಹೆಚ್ಚಿನ ವೇಗದಲ್ಲಿ ಧ್ವನಿಯ ಪಿಚ್ ಗೆ ಧಕ್ಕೆಯಾಗದಂತೆ ಧ್ವನಿಯನ್ನು ಪ್ಲೇ "
"ಅನುಮತಿಸುತ್ತದೆ"

