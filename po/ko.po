msgid "%1 h %2 min"
msgstr "%1시간 %2분"

#: modules/gui/qt/util/vlctick.cpp:100
msgid "%1 min %2 s"
msgstr "%1분 %2초"

#: modules/gui/qt/util/vlctick.cpp:104
msgid "%1 sec"
msgstr "%1초"

