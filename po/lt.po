msgstr "Detalumas (0, 1, 2)"

#: src/libvlc-module.c:100
msgid ""
"This is the verbosity level (0=only errors and standard messages, "
"1=warnings, 2=debug)."
msgstr ""
"Tai detalumo lygis (0=tik klaidos ir įprasti pranešimai, 1=įspėjimai, "
"2=derinimas)."

