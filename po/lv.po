msgstr "Nolasīt VLM konfigurācijas datni, tiklīdz VLM ir sākts."

#: src/libvlc-module.c:1136
msgid "Use a plugins cache"
msgstr "Lietot spraudņu kešatmiņu"

#: src/libvlc-module.c:1138
