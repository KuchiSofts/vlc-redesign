#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:72
msgid "Increase text contrast"
msgstr "Зголеми го контрастот на текстот"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:253
msgid ""
"Draws the dim texts of the design (hints, descriptions, watched items) "
"brighter, to the contrast the WCAG accessibility guidelines ask for (AA)."
msgstr ""
"Ги исцртува бледите текстови на дизајнот (совети, описи, гледани ставки) "
"посветли, до контрастот што го бараат упатствата за пристапност WCAG (AA)."

