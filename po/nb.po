#: modules/gui/qt/dialogs/preferences/config_model.cpp:149
msgid "Smaller"
msgstr "Mindre"

#: src/libvlc-module.c:504 modules/gui/macosx/menus/VLCMainMenu.m:463
#: modules/gui/qt/dialogs/preferences/config_model.cpp:150
msgid "Larger"
msgstr "Større"

