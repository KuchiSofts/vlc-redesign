msgstr "बन्द"

#: src/libvlc-module.c:200
msgid "Stereo audio output mode"
msgstr "स्टेरियो अडियो निर्गत ढाँचा"

#: src/libvlc-module.c:206 src/libvlc-module.c:218 src/libvlc-module.c:424
#: modules/codec/x264.c:434
#: modules/gui/qt/dialogs/preferences/preferences_widgets.cpp:1793
#: modules/gui/qt/dialogs/preferences/qml/ShortcutsCapturePopup.qml:133
msgid "Unset"
msgstr "सेट नगर"

#: src/libvlc-module.c:224
msgid "This adds audio post processing filters, to modify the sound rendering."
msgstr "यसले ध्वनि रेन्डरिङ परिमार्जन गर्न प्रक्रिया पश्चातको अडियो फिल्टर थप्दछ ।"

#: src/libvlc-module.c:229
msgid "This adds visualization modules (spectrum analyzer, etc.)."
msgstr "यसले भिज्युलाइजेसन मोड्युल थप्दछ (स्पेकट्रम विश्लेषक, इत्यादि)"

#: src/libvlc-module.c:233
msgid "Replay gain mode"
msgstr "रिप्ले वृद्धि ढाँचाः"

#: src/libvlc-module.c:236
msgid "Replay preamp"
msgstr "रिप्ले प्रिएम्प"

#: src/libvlc-module.c:238
msgid ""
"This allows you to change the default target level (89 dB) for stream with "
"replay gain information"
msgstr ""
"यसले रिप्ले गेन जानकारी भएका प्रवाहका लागि पूर्वनिर्धारित लक्ष्य स्तर (89 dB) परिवर्तन "
"गर्न दिन्छ"

#: src/libvlc-module.c:241
msgid "Default replay gain"
msgstr "पूर्वनिर्धारित रिप्ले वृद्धि"

#: src/libvlc-module.c:243
msgid "This is the gain used for stream without replay gain information"
msgstr ""

#: src/libvlc-module.c:245
msgid "Peak protection"
msgstr "पिक सुरक्षा"

#: src/libvlc-module.c:247
msgid "Protect against sound clipping"
msgstr "रक्षा ध्वनि क्लिप को बिरुद्ध"

#: src/libvlc-module.c:250
msgid "Enable time stretching audio"
msgstr "अडियो टाइम स्ट्रेचिङ सक्षम पार्नुहोस्"

#: src/libvlc-module.c:252
msgid ""
"This allows playing audio at lower or higher speed without affecting the "
"audio pitch"
msgstr "यसले अडियोको पिच परिवर्तन नगरी कम वा बढी गतिमा अडियो बजाउन दिन्छ"

