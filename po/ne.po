#: modules/codec/dvbsub.c:117 modules/codec/zvbi.c:93
#: modules/gui/macosx/panels/VLCVideoEffectsWindowController.m:377
#: modules/gui/macosx/panels/VLCVideoEffectsWindowController.m:399
#: modules/spu/common.h:54 modules/spu/mosaic.c:182
msgid "Bottom-Left"
msgstr "तल-बायाँ"

