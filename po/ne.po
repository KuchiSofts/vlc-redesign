#: src/libvlc-module.c:321 src/libvlc-module.c:420 src/libvlc-module.c:425
#: modules/codec/dvbsub.c:117 modules/codec/zvbi.c:93
#: modules/gui/macosx/panels/VLCVideoEffectsWindowController.m:375
