msgstr "स्थिर सञ्जाल ID (SDT तालिकाका लागि) मानाङ्कन गर्नुहोस्"

#: modules/mux/mpeg/ts.c:119
msgid "PMT Program numbers"
msgstr "PMT कार्यक्रम नम्बर"

