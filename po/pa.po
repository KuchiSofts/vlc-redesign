#: src/libvlc-module.c:1239
msgid "Fetch-art threads"
msgstr "ਆਰਟ ਲਿਆਉਣ ਵਾਲੇ ਥਰਿਡ"

#: src/libvlc-module.c:1241
msgid "Maximum number of threads used to fetch art"
msgstr "ਆਰਟ ਲਿਆਉਣ ਲਈ ਵਰਤੇ ਜਾਂਦੇ ਥਰਿਡਾਂ ਦੀ ਵੱਧ ਤੋਂ ਵੱਧ ਗਿਣਤੀ"

#: src/libvlc-module.c:1243
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:424
msgid "Allow metadata network access"
msgstr "ਮੇਟਾਡਾਟਾ ਲਈ ਨੈੱਟਵਰਕ ਪਹੁੰਚ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ"

#: src/libvlc-module.c:1248
msgid "Collapse"
msgstr "ਸਮੇਟੋ"

#: src/libvlc-module.c:1248
msgid "Expand"
msgstr "ਫੈਲਾਓ"

#: src/libvlc-module.c:1250
msgid "Subdirectory behavior"
msgstr "ਸਬ-ਡਾਇਰੈਕਟਰੀ ਰਵੱਈਆ"

#: src/libvlc-module.c:1252
msgid ""
"Select whether subdirectories must be expanded.\n"
"none: subdirectories do not appear in the play queue.\n"
"collapse: subdirectories appear but are expanded on first play.\n"
"expand: all subdirectories are expanded.\n"
msgstr ""
"ਚੁਣੋ ਕਿ ਕੀ ਸਬ-ਡਾਇਰੈਕਟਰੀਆਂ ਫੈਲਾਈਆਂ ਜਾਣ।\n"
"none: ਸਬ-ਡਾਇਰੈਕਟਰੀਆਂ ਪਲੇਅ ਕਤਾਰ ਵਿੱਚ ਨਹੀਂ ਦਿਸਦੀਆਂ।\n"
"collapse: ਸਬ-ਡਾਇਰੈਕਟਰੀਆਂ ਦਿਸਦੀਆਂ ਹਨ, ਪਰ ਪਹਿਲੀ ਵਾਰ ਚਲਾਉਣ ਉੱਤੇ ਫੈਲਦੀਆਂ ਹਨ।\n"
"expand: ਸਾਰੀਆਂ ਸਬ-ਡਾਇਰੈਕਟਰੀਆਂ ਫੈਲਾਈਆਂ ਜਾਂਦੀਆਂ ਹਨ।\n"

#: src/libvlc-module.c:1257
msgid "Ignored extensions"
msgstr "ਇਕਸਟੈਨਸ਼ਨਾਂ ਅਣਡਿੱਠੀਆਂ ਕੀਤੀਆਂ"

#: src/libvlc-module.c:1259
msgid ""
"Files with these extensions will not be added to play queue when opening a "
"directory.\n"
"This is useful if you add directories that contain playlist files for "
"instance. Use a comma-separated list of extensions."
msgstr ""
"ਡਾਇਰੈਕਟਰੀ ਖੋਲ੍ਹਣ ਸਮੇਂ ਇਹਨਾਂ ਐਕਸਟੈਨਸ਼ਨਾਂ ਵਾਲੀਆਂ ਫਾਇਲਾਂ ਪਲੇਅ ਕਤਾਰ ਵਿੱਚ ਨਹੀਂ ਜੋੜੀਆਂ ਜਾਣਗੀਆਂ।\n"
"ਇਹ ਲਾਭਦਾਇਕ ਹੈ, ਉਦਾਹਰਨ ਲਈ ਜੇ ਤੁਸੀਂ ਅਜਿਹੀਆਂ ਡਾਇਰੈਕਟਰੀਆਂ ਜੋੜਦੇ ਹੋ ਜਿਹਨਾਂ ਵਿੱਚ ਪਲੇਅਲਿਸਟ ਫਾਇਲਾਂ "
"ਹਨ। ਐਕਸਟੈਨਸ਼ਨਾਂ ਦੀ ਕੌਮੇ ਨਾਲ ਵੱਖ ਕੀਤੀ ਲਿਸਟ ਵਰਤੋ।"

#: src/libvlc-module.c:1264
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:318
msgid "Show hidden files"
msgstr "ਲੁਕਵੀਆਂ ਫਾਇਲਾਂ ਵੇਖੋ"

#: src/libvlc-module.c:1266
msgid "Ignore files starting with '.'"
msgstr "'.' ਨਾਲ ਸ਼ੁਰੂ ਹੋਣ ਵਾਲੀਆਂ ਫਾਇਲਾਂ ਅਣਡਿੱਠੀਆਂ ਕਰੋ"

#: src/libvlc-module.c:1268
msgid "Flatten files listed by extractors (archive)"
msgstr "ਐਕਸਟਰੈਕਟਰਾਂ (ਆਰਕਾਈਵ) ਵੱਲੋਂ ਸੂਚੀਬੱਧ ਫਾਇਲਾਂ ਨੂੰ ਇੱਕੋ ਪੱਧਰ ਉੱਤੇ ਰੱਖੋ"

#: src/libvlc-module.c:1270
msgid "Services discovery modules"
msgstr "ਸਰਵਿਸ ਖੋਜ ਮੋਡੀਊਲ"

#: src/libvlc-module.c:1272
msgid ""
"Specifies the services discovery modules to preload, separated by colons. "
"Typical value is \"sap\"."
msgstr ""

#: src/libvlc-module.c:1275
msgid "Play files randomly forever"
msgstr "ਫਾਇਲਾਂ ਹਮੇਸ਼ਾਂ ਲਈ ਰਲਵੇਂ ਰੂਪ 'ਚ ਚਲਾਓ"

#: src/libvlc-module.c:1277
msgid "VLC will randomly play files in the play queue until interrupted."
msgstr "VLC ਰੋਕੇ ਜਾਣ ਤੱਕ ਪਲੇਅ ਕਤਾਰ ਦੀਆਂ ਫਾਇਲਾਂ ਰਲਵੇਂ ਕ੍ਰਮ ਵਿੱਚ ਚਲਾਏਗਾ।"

#: src/libvlc-module.c:1279
msgid "Repeat all"
msgstr "ਸਭ ਰਪੀਟ ਕਰੋ"

#: src/libvlc-module.c:1281
msgid "VLC will keep playing the play queue indefinitely."
msgstr "VLC ਪਲੇਅ ਕਤਾਰ ਨੂੰ ਲਗਾਤਾਰ ਚਲਾਉਂਦਾ ਰਹੇਗਾ।"

#: src/libvlc-module.c:1283
msgid "Repeat current item"
msgstr "ਮੌਜੂਦਾ ਆਈਟਮ ਰਪੀਟ ਕਰੋ"

#: src/libvlc-module.c:1285
msgid "VLC will keep playing the current play queue item."
msgstr "VLC ਪਲੇਅ ਕਤਾਰ ਦੀ ਮੌਜੂਦਾ ਆਈਟਮ ਨੂੰ ਚਲਾਉਂਦਾ ਰਹੇਗਾ।"

#: src/libvlc-module.c:1287
msgid "Play and stop"
msgstr "ਚਲਾਓ ਅਤੇ ਰੋਕੋ"

#: src/libvlc-module.c:1289
msgid "Stop playback after each item in the play queue."
msgstr "ਪਲੇਅ ਕਤਾਰ ਦੀ ਹਰ ਆਈਟਮ ਤੋਂ ਬਾਅਦ ਪਲੇਅਬੈਕ ਰੋਕੋ।"

#: src/libvlc-module.c:1291
msgid "Play and exit"
msgstr "ਚਲਾਓ ਅਤੇ ਬੰਦ ਕਰੋ"

#: src/libvlc-module.c:1293
msgid "Exit if there are no more items in the play queue."
msgstr "ਪਲੇਅ ਕਤਾਰ ਵਿੱਚ ਹੋਰ ਆਈਟਮਾਂ ਨਾ ਹੋਣ ਤੇ ਬਾਹਰ ਜਾਓ।"

#: src/libvlc-module.c:1295
msgid "Play and pause"
msgstr "ਚਲਾਓ ਅਤੇ ਰੋਕੋ"

#: src/libvlc-module.c:1297
msgid "Pause each item in the play queue on the last frame."
msgstr "ਪਲੇਅ ਕਤਾਰ ਦੀ ਹਰ ਆਈਟਮ ਨੂੰ ਆਖਰੀ ਫਰੇਮ ਉੱਤੇ ਵਿਰਾਮ ਕਰੋ।"

#: src/libvlc-module.c:1299
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:149
msgid "Start paused"
msgstr "ਵਿਰਾਮ ਵਿੱਚ ਸ਼ੁਰੂ ਕਰੋ"

#: src/libvlc-module.c:1301
msgid "Pause each item in the play queue on the first frame."
msgstr "ਪਲੇਅ ਕਤਾਰ ਦੀ ਹਰ ਆਈਟਮ ਨੂੰ ਪਹਿਲੇ ਫਰੇਮ ਉੱਤੇ ਵਿਰਾਮ ਕਰੋ।"

#: src/libvlc-module.c:1303
msgid "Auto start"
msgstr "ਆਟੋ-ਸਟਾਰਟ"

#: src/libvlc-module.c:1304
msgid "Automatically start playing the play queue content once it's loaded."
msgstr "ਲੋਡ ਹੋਣ ਉੱਤੇ ਪਲੇਅ ਕਤਾਰ ਦੀ ਸਮੱਗਰੀ ਆਪਣੇ-ਆਪ ਚਲਾਉਣੀ ਸ਼ੁਰੂ ਕਰੋ।"

#: src/libvlc-module.c:1307
msgid "Pause on audio communication"
msgstr "ਆਡੀਓ ਸੰਚਾਰ ਸਮੇਂ ਵਿਰਾਮ ਕਰੋ"

#: src/libvlc-module.c:1309
msgid ""
"If pending audio communication is detected, playback will be paused "
"automatically."
msgstr "ਜੇ ਚੱਲ ਰਹੇ ਆਡੀਓ ਸੰਚਾਰ (ਜਿਵੇਂ ਕਾਲ) ਦਾ ਪਤਾ ਲੱਗੇ ਤਾਂ ਪਲੇਅਬੈਕ ਆਪਣੇ-ਆਪ ਵਿਰਾਮ ਹੋ ਜਾਵੇਗਾ।"

#: src/libvlc-module.c:1312
msgid "Use media library"
msgstr "ਮੀਡਿਆ ਲਾਇਬਰੇਰੀ ਵਰਤੋਂ"

#: src/libvlc-module.c:1314
msgid ""
"The media library is automatically saved and reloaded each time you start "
"VLC."
msgstr ""
"ਮੀਡਿਆ ਲਾਇਬਰੇਰੀ ਆਟੋਮੈਟਿਕ ਹੀ ਸੰਭਾਲੀ ਜਾਵੇਗੀ ਅਤੇ ਤੁਹਾਡੇ ਵਲੋਂ ਸ਼ੁਰੂ ਕਰਨ ਸਮੇਂ ਆਟੋਮੈਟਿਕ ਹੀ ਮੁੜ-ਲੋਡ "
"ਕੀਤੀ ਜਾਵੇਗੀ।"

#: src/libvlc-module.c:1317
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:321
msgid "Use the media library"
msgstr "ਮੀਡਿਆ ਲਾਇਬਰੇਰੀ ਵਰਤੋ"

#: src/libvlc-module.c:1319
msgid ""
"Start the media library when VLC asks for it (the media player does). Turn "
"it off to browse without indexing your media; this takes effect the next "
"time VLC starts."
msgstr ""
"ਜਦੋਂ VLC ਮੰਗੇ (ਮੀਡਿਆ ਪਲੇਅਰ ਮੰਗਦਾ ਹੈ) ਤਾਂ ਮੀਡਿਆ ਲਾਇਬਰੇਰੀ ਸ਼ੁਰੂ ਕਰੋ। ਆਪਣੇ ਮੀਡਿਆ ਨੂੰ ਇੰਡੈਕਸ ਕੀਤੇ "
"ਬਿਨਾਂ ਬਰਾਊਜ਼ ਕਰਨ ਲਈ ਇਸ ਨੂੰ ਬੰਦ ਕਰੋ; ਇਹ VLC ਦੇ ਅਗਲੀ ਵਾਰ ਸ਼ੁਰੂ ਹੋਣ ਉੱਤੇ ਲਾਗੂ ਹੋਵੇਗਾ।"

#: src/libvlc-module.c:1323
msgid "Display play queue tree"
msgstr "ਪਲੇਅ ਕਤਾਰ ਟਰੀ ਵੇਖੋ"

#: src/libvlc-module.c:1325
msgid ""
"The play queue can use a tree to categorize some items, like the contents of "
"a directory."
msgstr ""
"ਪਲੇਅ ਕਤਾਰ ਕੁਝ ਆਈਟਮਾਂ ਨੂੰ ਵਰਗਾਂ ਵਿੱਚ ਵੰਡਣ ਲਈ ਟਰੀ ਵਰਤ ਸਕਦੀ ਹੈ, ਜਿਵੇਂ ਕਿਸੇ ਡਾਇਰੈਕਟਰੀ ਦੀ "
"ਸਮੱਗਰੀ।"

#: src/libvlc-module.c:1328
msgid "Play queue bookmark 1"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 1"

#: src/libvlc-module.c:1329
msgid "Play queue bookmark 2"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 2"

#: src/libvlc-module.c:1330
msgid "Play queue bookmark 3"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 3"

#: src/libvlc-module.c:1331
msgid "Play queue bookmark 4"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 4"

#: src/libvlc-module.c:1332
msgid "Play queue bookmark 5"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 5"

#: src/libvlc-module.c:1333
msgid "Play queue bookmark 6"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 6"

#: src/libvlc-module.c:1334
msgid "Play queue bookmark 7"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 7"

#: src/libvlc-module.c:1335
msgid "Play queue bookmark 8"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 8"

#: src/libvlc-module.c:1336
msgid "Play queue bookmark 9"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 9"

#: src/libvlc-module.c:1337
msgid "Play queue bookmark 10"
msgstr "ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ 10"

#: src/libvlc-module.c:1338
msgid "This allows you to define play queue bookmarks."
msgstr "ਇਸ ਨਾਲ ਤੁਸੀਂ ਪਲੇਅ ਕਤਾਰ ਬੁੱਕਮਾਰਕ ਤੈਅ ਕਰ ਸਕਦੇ ਹੋ।"

#: src/libvlc-module.c:1345
msgid "These settings are the global VLC key bindings, known as \"hotkeys\"."
msgstr ""

#: src/libvlc-module.c:1350 modules/gui/macosx/main/VLCMain+OldPrefs.m:117
#: modules/gui/qt/dialogs/dialogs_provider.cpp:553
#: modules/misc/medialibrary/medialibrary.cpp:471
msgid "Ignore"
msgstr "ਅਣਡਿੱਠਾ"

#: src/libvlc-module.c:1350
msgid "Volume control"
msgstr "ਵਾਲੀਅਮ ਕੰਟਰੋਲ"

#: src/libvlc-module.c:1351
msgid "Position control"
msgstr "ਸਥਿਤੀ ਕੰਟਰੋਲ"

#: src/libvlc-module.c:1351
msgid "Position control reversed"
msgstr "ਸਥਿਤੀ ਕੰਟਰੋਲ (ਉਲਟਾ)"

#: src/libvlc-module.c:1354
msgid "Mouse wheel vertical axis control"
msgstr "ਮਾਊਸ ਵੀਲ ਦੇ ਖੜ੍ਹਵੇਂ ਧੁਰੇ ਦਾ ਕੰਟਰੋਲ"

#: src/libvlc-module.c:1356
msgid ""
"The mouse wheel vertical (up/down) axis can control volume, position or be "
"ignored."
msgstr ""
"ਮਾਊਸ ਵੀਲ ਦਾ ਖੜ੍ਹਵਾਂ (ਉੱਪਰ/ਹੇਠਾਂ) ਧੁਰਾ ਵਾਲੀਅਮ ਜਾਂ ਸਥਿਤੀ ਨੂੰ ਕੰਟਰੋਲ ਕਰ ਸਕਦਾ ਹੈ ਜਾਂ ਅਣਡਿੱਠਾ "
"ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ।"

#: src/libvlc-module.c:1358
msgid "Mouse wheel horizontal axis control"
msgstr "ਮਾਊਸ ਵੀਲ ਦੇ ਲੇਟਵੇਂ ਧੁਰੇ ਦਾ ਕੰਟਰੋਲ"

#: src/libvlc-module.c:1360
msgid ""
"The mouse wheel horizontal (left/right) axis can control volume, position or "
"be ignored."
msgstr ""
"ਮਾਊਸ ਵੀਲ ਦਾ ਲੇਟਵਾਂ (ਖੱਬੇ/ਸੱਜੇ) ਧੁਰਾ ਵਾਲੀਅਮ ਜਾਂ ਸਥਿਤੀ ਨੂੰ ਕੰਟਰੋਲ ਕਰ ਸਕਦਾ ਹੈ ਜਾਂ ਅਣਡਿੱਠਾ ਕੀਤਾ "
"ਜਾ ਸਕਦਾ ਹੈ।"

#: src/libvlc-module.c:1362 src/video_output/vout_intf.c:327
#: modules/gui/macosx/menus/VLCMainMenu.m:437
#: modules/gui/macosx/menus/VLCMainMenu.m:529
#: modules/gui/macosx/windows/controlsbar/VLCControlsBarCommon.m:176
#: modules/gui/qt/widgets/qml/CSDWindowButtonSet.qml:167
#: modules/gui/qt/player/qml/PlayerControlbarControls.qml:40
#: modules/gui/qt/player/qml/controlbarcontrols/FullscreenButton.qml:33
msgid "Fullscreen"
msgstr "ਪੂਰੀ ਸਕਰੀਨ"

#: src/libvlc-module.c:1363
msgid "Select the hotkey to use to swap fullscreen state."
msgstr "ਪੂਰੀ ਸਕਰੀਨ ਹਾਲਤ ਸਵੈਪ ਕਰਨ ਲਈ ਵਰਤਣ ਵਾਸਤੇ ਹਾਟ-ਕੀ ਚੁਣੋ।"

#: src/libvlc-module.c:1364
msgid "Exit fullscreen"
msgstr "ਪੂਰੀ ਸਕਰੀਨ ਛੱਡੋ"

#: src/libvlc-module.c:1365
msgid "Select the hotkey to use to exit fullscreen state."
msgstr "ਪੂਰੀ ਸਕਰੀਨ ਤੋਂ ਬਾਹਰ ਆਉਣ ਲਈ ਵਰਤਣ ਵਾਸਤੇ ਹਾਟ-ਕੀ ਚੁਣੋ।"

#: src/libvlc-module.c:1366
#: modules/gui/qt/player/qml/controlbarcontrols/PlayButton.qml:69
msgid "Play/Pause"
msgstr "ਚਲਾਓ/ਵਿਰਾਮ"

#: src/libvlc-module.c:1367
msgid "Select the hotkey to use to swap paused state."
msgstr "ਪੌਜ਼ ਹਾਲਤ ਸਵੈਪ ਕਰਨ ਲਈ ਵਰਤਣ ਵਾਸਤੇ ਹਾਟ-ਕੀ ਚੁਣੋ।"

#: src/libvlc-module.c:1368
msgid "Pause only"
msgstr "ਕੇਵਲ ਵਿਰਾਮ"

#: src/libvlc-module.c:1369
msgid "Select the hotkey to use to pause."
msgstr "ਪੌਜ਼ ਲਈ ਵਰਤਣ ਵਾਸਤੇ ਹਾਟ-ਕੀ ਚੁਣੋ।"

#: src/libvlc-module.c:1370
msgid "Play only"
msgstr "ਕੇਵਲ ਚਲਾਓ"

#: src/libvlc-module.c:1371
msgid "Select the hotkey to use to play."
msgstr "ਚਲਾਉਣ ਲਈ ਵਰਤਣ ਵਾਸਤੇ ਹਾਟ-ਕੀ ਚੁਣੋ।"

#: src/libvlc-module.c:1372 modules/gui/macosx/menus/VLCMainMenu.m:396
#: modules/gui/qt/dialogs/preferences/config_model.cpp:372
#: modules/gui/qt/player/qml/PlayerControlbarControls.qml:39
#: modules/gui/qt/player/qml/controlbarcontrols/FasterButton.qml:33
msgid "Faster"
msgstr "ਤੇਜ਼"

#: src/libvlc-module.c:1373 src/libvlc-module.c:1379
msgid "Select the hotkey to use for fast forward playback."
msgstr "ਪਲੇਅਬੈਕ ਤੇਜ਼ ਅੱਗੇ ਕਰਨ ਲਈ ਵਰਤਣ ਵਾਸਤੇ ਹਾਟ-ਕੀ ਚੁਣੋ।"

#: src/libvlc-module.c:1374 modules/gui/macosx/menus/VLCMainMenu.m:394
#: modules/gui/qt/dialogs/preferences/config_model.cpp:373
#: modules/gui/qt/player/qml/PlayerControlbarControls.qml:38
#: modules/gui/qt/player/qml/controlbarcontrols/SlowerButton.qml:33
msgid "Slower"
msgstr "ਹੌਲੀ"

#: src/libvlc-module.c:1375 src/libvlc-module.c:1381
msgid "Select the hotkey to use for slow motion playback."
msgstr "ਪਲੇਅਬੈਕ ਗਤੀ ਹੌਲੀ ਕਰਨ ਲਈ ਵਰਤਣ ਵਾਸਤੇ ਹਾਟ-ਕੀ ਚੁਣੋ।"

#: src/libvlc-module.c:1376
msgid "Normal rate"
msgstr "ਆਮ ਰੇਟ"

#: src/libvlc-module.c:1377
