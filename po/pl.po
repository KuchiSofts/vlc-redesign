msgstr "Umieszczaj okno obrazu zawsze nad innymi oknami."

#: src/libvlc-module.c:348
msgid "Enable wallpaper mode"
msgstr "Włącz tryb tapety"

#: src/libvlc-module.c:350
msgid ""
