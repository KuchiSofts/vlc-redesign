msgstr "Ультрахуткі"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:345
msgid "Super fast"
msgstr "Звышхуткі"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:346
msgid "Very fast"
msgstr "Вельмі хуткі"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:348
msgid "Very slow"
msgstr "Вельмі павольны"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:348
msgid "Placebo"
msgstr "Плацэба"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:350
msgid "Film"
msgstr "Фільм"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:351
msgid "Still image"
msgstr "Нерухомая выява"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:352
msgid "Fast decoding"
msgstr "Хуткае дэкадаванне"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:352
msgid "Zero latency"
msgstr "Нулявая затрымка"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:919
