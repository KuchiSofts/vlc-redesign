msgstr "Вышэй за звычайны"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1451
msgid "Below normal"
msgstr "Ніжэй за звычайны"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1451
