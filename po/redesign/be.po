msgstr "Экран %1 (%2)"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1581
msgid "Screen %1"
msgstr "Экран %1"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1590
msgid "Any title"
msgstr "Любая назва"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1590
msgid "Contains title"
msgstr "Змяшчае назву"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1591
msgid "Title with extra characters"
msgstr "Назва з дадатковымі знакамі"

#: modules/gui/qt/dialogs/preferences/config_model.cpp:1591
msgid "Exact title match"
msgstr "Дакладнае супадзенне назвы"

#: modules/gui/qt/dialogs/preferences/config_model_audioscrobbler.cpp:92
msgid "The audio output in use does not keep a startup volume."
msgstr "Ужываны вывад аўдыё не захоўвае гучнасць пры запуску."

#: modules/gui/qt/dialogs/preferences/config_model_audioscrobbler.cpp:126
