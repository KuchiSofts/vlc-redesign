#: modules/gui/qt/dialogs/firstrun/qml/WelcomeStep.qml:55
msgid "Welcome to %1!"
msgstr "Dobro došli u %1!"

#: modules/gui/qt/dialogs/firstrun/qml/WelcomeStep.qml:73
msgid ""
"VLC is a free and open source cross-platform multimedia player and framework "
"that plays most multimedia files as well as DVDs, Audio CDs, VCDs, and "
"various streaming protocols."
msgstr ""
"VLC je besplatan višeplatformski multimedijski izvođač i okvir otvorenog "
"koda koji reproducira većinu multimedijskih datoteka, kao i DVD-ove, audio "
"CD-ove, VCD-ove i razne protokole strujanja."

#: modules/gui/qt/dialogs/firstrun/qml/WelcomeStep.qml:94
msgid "Choose a Media Folder to get started with"
msgstr "Izaberite medijsku mapu za početak"

#: modules/gui/qt/dialogs/firstrun/qml/WelcomeStep.qml:127
msgid "No folder selected"
msgstr "Nije izabrana nijedna mapa"

#: modules/gui/qt/dialogs/firstrun/qml/WelcomeStep.qml:147
