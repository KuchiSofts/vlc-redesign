#: modules/gui/qt/dialogs/firstrun/qml/SubtitleLanguagesStep.qml:56
msgid "Choose the languages of your subtitles."
msgstr "Trieu els idiomes dels subtítols."

#: modules/gui/qt/dialogs/firstrun/qml/SubtitleLanguagesStep.qml:69
msgid ""
"Subtitles in your language show by themselves: from the video, from a file "
"next to it, or found online. When there are none in it, not even online, the "
"second language is used."
msgstr ""
"Els subtítols en el vostre idioma es mostren automàticament: del vídeo, d'un "
"fitxer que hi ha al costat o trobats en línia. Quan no n'hi ha cap en aquest "
"idioma, ni tan sols en línia, s'utilitza el segon idioma."

#: modules/gui/qt/dialogs/firstrun/qml/SubtitleLanguagesStep.qml:87
msgid "Default language"
msgstr "Idioma per defecte"

#: modules/gui/qt/dialogs/firstrun/qml/SubtitleLanguagesStep.qml:106
