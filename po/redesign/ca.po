msgid ""
"A file of VLC Redesign was changed since it was installed, so the small "
"update can't be used: update with the installer instead."
msgstr ""
"S'ha modificat un fitxer del VLC Redesign des que es va instal·lar, per això "
"no es pot utilitzar l'actualització petita: actualitzeu amb l'instal·lador."

#: modules/gui/qt/util/redesign_updater.cpp:668
msgid "The update is damaged: a file doesn't match its checksum."
msgstr ""
