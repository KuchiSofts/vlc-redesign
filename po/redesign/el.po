#: modules/gui/qt/dialogs/preferences/config_model.cpp:181
#: modules/gui/qt/dialogs/preferences/config_model.cpp:1224
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:342
#: modules/gui/qt/player/qml/AudioVisualizationDialog.qml:23
#: modules/gui/qt/player/qml/AudioVisualizationDialog.qml:145
msgid "Disabled"
msgstr "Απενεργοποιημένο"

#: src/libvlc-module.c:552
msgid "Toggle pause immediately on mouse released"
msgstr "Εναλλαγή παύσης αμέσως μόλις αφεθεί το κουμπί του ποντικιού"

#: src/libvlc-module.c:596
msgid "Clock master source"
msgstr "Κύρια πηγή ρολογιού"

#: src/libvlc-module.c:597
msgid ""
"Select the clock master source:\n"
"auto: best clock source, input if the access can't be paced (when playing "
"live content), or audio otherwise (most likely).\n"
"input: all tracks are driven by the input clock, via PCR updates from the "
"demuxer. This restore the VLC 3.0 clock behavior where both audio and video "
"tracks can be altered to catch up with the input.\n"
"audio: if an audio track is playing, the audio output will drive the clock "
"(Fallback to Monotonic if there is no audio tracks).\n"
"monotonic: all tracks are driven by the monotonic clock of the system."
msgstr ""
"Επιλέξτε την κύρια πηγή ρολογιού:\n"
"αυτόματα: η καλύτερη πηγή ρολογιού· είσοδος αν ο ρυθμός πρόσβασης δεν μπορεί "
"να ελεγχθεί (κατά την αναπαραγωγή ζωντανού περιεχομένου), διαφορετικά ήχος "
"(το πιθανότερο).\n"
"είσοδος: όλα τα κομμάτια οδηγούνται από το ρολόι της εισόδου, μέσω "
"ενημερώσεων PCR από τον αποπολυπλέκτη. Επαναφέρει τη συμπεριφορά ρολογιού "
"του VLC 3.0, όπου τόσο τα κομμάτια ήχου όσο και τα κομμάτια βίντεο μπορούν "
"να τροποποιηθούν ώστε να συγχρονιστούν με την είσοδο.\n"
"ήχος: αν αναπαράγεται κομμάτι ήχου, η έξοδος ήχου οδηγεί το ρολόι (επιστροφή "
"σε μονοτονικό αν δεν υπάρχουν κομμάτια ήχου).\n"
"μονοτονικό: όλα τα κομμάτια οδηγούνται από το μονοτονικό ρολόι του "
"συστήματος."

#: src/libvlc-module.c:612
msgid "Input (PCR)"
msgstr "Είσοδος (PCR)"

#: src/libvlc-module.c:614
msgid "Monotonic"
msgstr "Μονοτονικό"

#: src/libvlc-module.c:657
#: modules/gui/qt/medialibrary/qml/VideoInfoExpandPanel.qml:295
msgid "Video track"
msgstr "Κομμάτι βίντεο"

#: src/libvlc-module.c:659
msgid "Stream number of the video track to use (from 0 to n)."
msgstr ""
"Ο αριθμός ροής δεδομένων του κομματιού βίντεο που θα χρησιμοποιηθεί (από 0 "
"έως n)."

#: src/libvlc-module.c:674
msgid ""
"Language of the audio track you want to use (comma separated, two or three "
"letter ISO-639 country code; you may use 'none' to avoid a fallback to "
"another language)."
msgstr ""
"Γλώσσα του κομματιού ήχου που θέλετε να χρησιμοποιήσετε (διαχωρισμένες με "
"κόμμα, κωδικός χώρας ISO-639 δύο ή τριών γραμμάτων· μπορείτε να "
"χρησιμοποιήσετε 'none' για να μη γίνεται εναλλακτική χρήση άλλης γλώσσας)."

#: src/libvlc-module.c:679
msgid ""
"Language of the subtitle track you want to use (comma separated, two or "
"three letter ISO-639 country code; you may use 'any' as a fallback)."
msgstr ""
"Γλώσσα του κομματιού υποτίτλων που θέλετε να χρησιμοποιήσετε (διαχωρισμένες "
"με κόμμα, κωδικός χώρας ISO-639 δύο ή τριών γραμμάτων· μπορείτε να "
"χρησιμοποιήσετε 'any' ως εναλλακτική επιλογή)."

#: src/libvlc-module.c:684
msgid ""
"Language of the menus you want to use with DVD/BluRay (comma separated, two "
"or three letter ISO-639 country code; you may use 'any' as a fallback)."
msgstr ""
"Γλώσσα των μενού που θέλετε να χρησιμοποιήσετε με DVD/BluRay (διαχωρισμένες "
"με κόμμα, κωδικός χώρας ISO-639 δύο ή τριών γραμμάτων· μπορείτε να "
"χρησιμοποιήσετε 'any' ως εναλλακτική επιλογή)."

#: src/libvlc-module.c:687
msgid "Video track ID"
msgstr "Ταυτότητα κομματιού βίντεο"

#: src/libvlc-module.c:689
msgid "Stream ID of the video track to use."
msgstr "Ταυτότητα ροής δεδομένων του κομματιού βίντεο που θα χρησιμοποιηθεί."

#: src/libvlc-module.c:717
msgid "Low delay mode"
msgstr "Λειτουργία χαμηλής καθυστέρησης"

#: src/libvlc-module.c:719
msgid ""
"Try to minimize delay along decoding chain. Might break with non compliant "
"streams."
msgstr ""
"Προσπάθεια ελαχιστοποίησης της καθυστέρησης σε όλη την αλυσίδα "
"αποκωδικοποίησης. Ενδέχεται να μη λειτουργεί με μη συμβατές ροές δεδομένων."

#: src/libvlc-module.c:766
msgid "Should the playback resume where it was left off?"
msgstr "Να συνεχίζεται η αναπαραγωγή από εκεί που σταμάτησε;"

#: src/libvlc-module.c:775
msgid "Never resume playback where it was left off"
msgstr "Να μη συνεχίζεται ποτέ η αναπαραγωγή από εκεί που σταμάτησε"

#: src/libvlc-module.c:776
msgid "Ask when the playback starts"
msgstr "Ερώτηση κατά την έναρξη της αναπαραγωγής"

#: src/libvlc-module.c:777
msgid "Always resume playback where it was left off"
msgstr "Να συνεχίζεται πάντα η αναπαραγωγή από εκεί που σταμάτησε"

#: src/libvlc-module.c:780
msgid "Resume last playback states"
msgstr "Επαναφορά της τελευταίας κατάστασης αναπαραγωγής"

#: src/libvlc-module.c:781
msgid ""
"This will resume the last playback state, such as the selected tracks, rate, "
"aspect-ratio, ..."
msgstr ""
"Επαναφέρει την τελευταία κατάσταση αναπαραγωγής, όπως τα επιλεγμένα "
"κομμάτια, την ταχύτητα, την αναλογία διαστάσεων, ..."

#: src/libvlc-module.c:821
msgid "Subtitle position"
msgstr "Θέση υποτίτλων"

#: src/libvlc-module.c:823
msgid ""
"How high the subtitles are, in percent of the height of the picture above "
"their usual place (below it when negative). The same on any screen and in "
"any window size."
msgstr ""
"Πόσο ψηλά εμφανίζονται οι υπότιτλοι πάνω από τη συνήθη θέση τους, σε ποσοστό "
"του ύψους της εικόνας (κάτω από αυτήν όταν η τιμή είναι αρνητική). Ίδιο σε "
"κάθε οθόνη και σε κάθε μέγεθος παραθύρου."

#: src/libvlc-module.c:834
msgid "Display sub-pictures on full window"
msgstr "Εμφάνιση υπο-εικόνων σε ολόκληρο το παράθυρο"

#: src/libvlc-module.c:836
msgid "It allows showing subtitles in black bars."
msgstr "Επιτρέπει την εμφάνιση υποτίτλων στις μαύρες λωρίδες."

#: src/libvlc-module.c:838
msgid "Position of secondary subtitles"
msgstr "Θέση δευτερευόντων υποτίτλων"

#: src/libvlc-module.c:840
msgid ""
"Place on video where to display secondary subtitles (default bottom center)."
msgstr ""
"Θέση στο βίντεο όπου θα εμφανίζονται οι δευτερεύοντες υπότιτλοι (προεπιλογή "
"κάτω στο κέντρο)."

#: src/libvlc-module.c:842
msgid "Force secondary subtitle position"
msgstr "Επιβολή θέσης δευτερευόντων υποτίτλων"

#: src/libvlc-module.c:844
msgid ""
"You can use this option to vertically adjust the position secondary "
"subtitles are displayed."
msgstr ""
"Με αυτήν την επιλογή μπορείτε να ρυθμίσετε κατακόρυφα τη θέση στην οποία "
"εμφανίζονται οι δευτερεύοντες υπότιτλοι."

#: src/libvlc-module.c:847
msgid "On Screen Display duration"
msgstr "Διάρκεια εμφάνισης στην οθόνη (OSD)"

#: src/libvlc-module.c:849
msgid "How long the messages of the On Screen Display stay, in milliseconds."
msgstr ""
"Πόση ώρα παραμένουν τα μηνύματα της εμφάνισης στην οθόνη (OSD), σε χιλιοστά "
"του δευτερολέπτου."

#: src/libvlc-module.c:889
msgid "Subtitle Frames per Second"
msgstr "Καρέ ανά δευτερόλεπτο υποτίτλων"

#: src/libvlc-module.c:891
msgid "Override the normal frames per second settings. "
msgstr "Παράκαμψη των κανονικών ρυθμίσεων καρέ ανά δευτερόλεπτο. "

#: src/libvlc-module.c:976
msgid ""
"This X.509 certificate file (PEM format) is used for server-side TLS. On OS "
"X, the string is used as a label to search the certificate in the keychain."
msgstr ""
"Αυτό το αρχείο πιστοποιητικού X.509 (μορφή PEM) χρησιμοποιείται για TLS στην "
"πλευρά του εξυπηρετητή. Στο OS X, η συμβολοσειρά χρησιμοποιείται ως ετικέτα "
"για την αναζήτηση του πιστοποιητικού στην κλειδοθήκη."

#: src/libvlc-module.c:1027
msgid ""
"These options allow you to control the preferred modules used for accessing, "
"demuxing and decoding (or encoding) inputs."
msgstr ""
"Αυτές οι επιλογές σας επιτρέπουν να ελέγχετε τις προτιμώμενες ενότητες που "
"χρησιμοποιούνται για την πρόσβαση, την αποπολυπλεξία και την αποκωδικοποίηση "
"(ή κωδικοποίηση) των εισόδων."

#: src/libvlc-module.c:1037
msgid "Enable hardware decoders"
msgstr "Ενεργοποίηση αποκωδικοποιητών υλικού"

#: src/libvlc-module.c:1039
msgid ""
"VLC will fallback automatically to software decoders in case of hardware "
"decoder failure."
msgstr ""
"Σε περίπτωση αποτυχίας του αποκωδικοποιητή υλικού, το VLC θα επιστρέψει "
"αυτόματα σε αποκωδικοποιητές λογισμικού."

#: src/libvlc-module.c:1042
msgid "Preferred decoder hardware device"
msgstr "Προτιμώμενη συσκευή υλικού αποκωδικοποίησης"

#: src/libvlc-module.c:1085
msgid ""
"This allows you to keep an unique stream output instance across multiple "
"play queue items."
msgstr ""
"Σας επιτρέπει να διατηρείτε μία μοναδική παρουσία εξόδου ροής για πολλά "
"στοιχεία της ουράς αναπαραγωγής."

#: src/libvlc-module.c:1128
msgid "Tracer module"
msgstr "Ενότητα ιχνηλάτησης"

#: src/libvlc-module.c:1130
msgid "This allow to select which tracer module you want to use."
msgstr ""
"Επιτρέπει την επιλογή της ενότητας ιχνηλάτησης που θέλετε να χρησιμοποιήσετε."

#: src/libvlc-module.c:1149
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:23
msgid "Additional command line options"
msgstr "Πρόσθετες επιλογές γραμμής εντολών"

#: src/libvlc-module.c:1151
msgid ""
"Options VLC reads at every start, as if they were written on its command "
"line (the command line wins when it gives the same option). Write them as on "
"a command line, for example: --no-osd --network-caching=3000; quote a value "
"with spaces. Files to open, and the options only a command line can give (--"
"help, --config, --reset-config...), are left out."
msgstr ""
"Επιλογές που διαβάζει το VLC σε κάθε εκκίνηση, σαν να ήταν γραμμένες στη "
"γραμμή εντολών του (η γραμμή εντολών υπερισχύει όταν δίνει την ίδια "
"επιλογή). Γράψτε τις όπως σε μια γραμμή εντολών, για παράδειγμα: --no-osd --"
"network-caching=3000· βάλτε σε εισαγωγικά μια τιμή που περιέχει κενά. Τα "
"αρχεία προς άνοιγμα και οι επιλογές που μπορεί να δώσει μόνο η γραμμή "
"εντολών (--help, --config, --reset-config...) παραλείπονται."

#: src/libvlc-module.c:1162
msgid "Statistics collection frequency"
msgstr "Συχνότητα συλλογής στατιστικών"

#: src/libvlc-module.c:1164
msgid "Collection frequency of the statistics in ms."
msgstr "Συχνότητα συλλογής των στατιστικών σε ms."

#: src/libvlc-module.c:1208
msgid "Enqueue items into play queue in one instance mode"
msgstr "Προσθήκη στοιχείων στην ουρά αναπαραγωγής σε λειτουργία μίας παρουσίας"

#: src/libvlc-module.c:1210
msgid ""
"When using the one instance only option, enqueue items to play queue and "
"keep playing current item."
msgstr ""
"Όταν χρησιμοποιείται η επιλογή μίας μόνο παρουσίας, τα στοιχεία προστίθενται "
"στην ουρά αναπαραγωγής και συνεχίζεται η αναπαραγωγή του τρέχοντος στοιχείου."

#: src/libvlc-module.c:1223
msgid ""
"These options define the behavior of the play queue. Some of them can be "
"overridden in the play queue dialog box."
msgstr ""
"Αυτές οι επιλογές ορίζουν τη συμπεριφορά της ουράς αναπαραγωγής. Ορισμένες "
"από αυτές μπορούν να παρακαμφθούν στο παράθυρο διαλόγου της ουράς "
"αναπαραγωγής."

#: src/libvlc-module.c:1228
msgid ""
"Automatically preparse items added to the play queue (to retrieve some "
"metadata)."
msgstr ""
"Αυτόματη προανάλυση των στοιχείων που προστίθενται στην ουρά αναπαραγωγής "
"(για ανάκτηση ορισμένων μεταδεδομένων)."

#: src/libvlc-module.c:1235
msgid "Preparsing threads"
msgstr "Νήματα προανάλυσης"

#: src/libvlc-module.c:1237
msgid "Maximum number of threads used to preparse items"
msgstr ""
"Μέγιστος αριθμός νημάτων που χρησιμοποιούνται για την προανάλυση στοιχείων"

#: src/libvlc-module.c:1239
msgid "Fetch-art threads"
msgstr "Νήματα λήψης εξωφύλλων"

#: src/libvlc-module.c:1241
msgid "Maximum number of threads used to fetch art"
msgstr "Μέγιστος αριθμός νημάτων που χρησιμοποιούνται για τη λήψη εξωφύλλων"

#: src/libvlc-module.c:1252
msgid ""
"Select whether subdirectories must be expanded.\n"
"none: subdirectories do not appear in the play queue.\n"
"collapse: subdirectories appear but are expanded on first play.\n"
"expand: all subdirectories are expanded.\n"
msgstr ""
"Επιλέξτε αν θα αναπτύσσονται οι υποφάκελοι.\n"
"none: οι υποφάκελοι δεν εμφανίζονται στην ουρά αναπαραγωγής.\n"
"collapse: οι υποφάκελοι εμφανίζονται αλλά αναπτύσσονται κατά την πρώτη "
"αναπαραγωγή.\n"
"expand: όλοι οι υποφάκελοι αναπτύσσονται.\n"

#: src/libvlc-module.c:1259
msgid ""
"Files with these extensions will not be added to play queue when opening a "
"directory.\n"
"This is useful if you add directories that contain playlist files for "
"instance. Use a comma-separated list of extensions."
msgstr ""
"Τα αρχεία με αυτές τις επεκτάσεις δεν θα προστίθενται στην ουρά αναπαραγωγής "
"κατά το άνοιγμα ενός φακέλου.\n"
"Αυτό είναι χρήσιμο, για παράδειγμα, αν προσθέτετε φακέλους που περιέχουν "
"αρχεία λιστών αναπαραγωγής. Χρησιμοποιήστε μια λίστα επεκτάσεων "
"διαχωρισμένων με κόμμα."

#: src/libvlc-module.c:1268
msgid "Flatten files listed by extractors (archive)"
msgstr ""
"Ισοπέδωση των αρχείων που απαριθμούνται από εξαγωγείς (συμπιεσμένα αρχεία)"

#: src/libvlc-module.c:1277
msgid "VLC will randomly play files in the play queue until interrupted."
msgstr ""
"Το VLC θα αναπαράγει τυχαία αρχεία από την ουρά αναπαραγωγής μέχρι να "
"διακοπεί."

#: src/libvlc-module.c:1281
msgid "VLC will keep playing the play queue indefinitely."
msgstr "Το VLC θα αναπαράγει συνεχώς την ουρά αναπαραγωγής."

#: src/libvlc-module.c:1285
msgid "VLC will keep playing the current play queue item."
msgstr ""
"Το VLC θα συνεχίζει να αναπαράγει το τρέχον στοιχείο της ουράς αναπαραγωγής."

#: src/libvlc-module.c:1289
msgid "Stop playback after each item in the play queue."
msgstr ""
"Διακοπή της αναπαραγωγής μετά από κάθε στοιχείο της ουράς αναπαραγωγής."

#: src/libvlc-module.c:1293
msgid "Exit if there are no more items in the play queue."
msgstr "Έξοδος αν δεν υπάρχουν άλλα στοιχεία στην ουρά αναπαραγωγής."

#: src/libvlc-module.c:1297
msgid "Pause each item in the play queue on the last frame."
msgstr "Παύση κάθε στοιχείου της ουράς αναπαραγωγής στο τελευταίο καρέ."

#: src/libvlc-module.c:1301
msgid "Pause each item in the play queue on the first frame."
msgstr "Παύση κάθε στοιχείου της ουράς αναπαραγωγής στο πρώτο καρέ."

#: src/libvlc-module.c:1304
msgid "Automatically start playing the play queue content once it's loaded."
msgstr ""
"Αυτόματη έναρξη της αναπαραγωγής του περιεχομένου της ουράς αναπαραγωγής "
"μόλις φορτωθεί."

#: src/libvlc-module.c:1317
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:321
msgid "Use the media library"
msgstr "Χρήση της βιβλιοθήκης πολυμέσων"

#: src/libvlc-module.c:1319
msgid ""
"Start the media library when VLC asks for it (the media player does). Turn "
"it off to browse without indexing your media; this takes effect the next "
"time VLC starts."
msgstr ""
"Εκκίνηση της βιβλιοθήκης πολυμέσων όταν τη ζητά το VLC (το κάνει ο "
"αναπαραγωγός πολυμέσων). Απενεργοποιήστε την για περιήγηση χωρίς ευρετηρίαση "
"των πολυμέσων σας· η αλλαγή ισχύει από την επόμενη εκκίνηση του VLC."

#: src/libvlc-module.c:1323
msgid "Display play queue tree"
msgstr "Εμφάνιση δέντρου ουράς αναπαραγωγής"

#: src/libvlc-module.c:1325
msgid ""
"The play queue can use a tree to categorize some items, like the contents of "
"a directory."
msgstr ""
"Η ουρά αναπαραγωγής μπορεί να χρησιμοποιεί δέντρο για την κατηγοριοποίηση "
"ορισμένων στοιχείων, όπως τα περιεχόμενα ενός φακέλου."

