msgid "%1 at %2"
msgstr "%1 στις %2"

#: modules/gui/qt/util/model_recovery_agent.hpp:87
msgid "Restore the play queue?"
msgstr "Επαναφορά της ουράς αναπαραγωγής;"

#: modules/gui/qt/util/model_recovery_agent.hpp:88
msgid "VLC Redesign closed unexpectedly on %1. Restore the play queue it had?"
msgstr ""
"Το VLC Redesign έκλεισε απροσδόκητα στις %1. Επαναφορά της ουράς "
"αναπαραγωγής που είχε;"

#: modules/gui/qt/util/model_recovery_agent.hpp:90
msgctxt "play queue"
msgid "Restore"
msgstr "Επαναφορά"

#: modules/gui/qt/util/model_recovery_agent.hpp:91
msgid "Don't restore"
msgstr "Χωρίς επαναφορά"

#: modules/gui/qt/util/redesign_updater.cpp:216
msgid ""
"The update isn't signed by the publisher of this copy (%1), so it wasn't "
"used."
msgstr ""
"Η ενημέρωση δεν είναι υπογεγραμμένη από τον εκδότη αυτού του αντιγράφου "
"(%1), γι' αυτό δεν χρησιμοποιήθηκε."

#: modules/gui/qt/util/redesign_updater.cpp:461
msgid "%1 (later)"
msgstr "%1 (αργότερα)"

#: modules/gui/qt/util/redesign_updater.cpp:463
msgid "%1 (soon)"
msgstr "%1 (σύντομα)"

#: modules/gui/qt/util/redesign_updater.cpp:643
msgid "This build cannot check for updates."
msgstr "Αυτή η έκδοση δεν μπορεί να ελέγξει για ενημερώσεις."

#: modules/gui/qt/util/redesign_updater.cpp:657
msgid "Couldn't reach GitHub. Check your connection and try again."
msgstr ""
"Δεν ήταν δυνατή η σύνδεση με το GitHub. Ελέγξτε τη σύνδεσή σας και δοκιμάστε "
"ξανά."

#: modules/gui/qt/util/redesign_updater.cpp:674
msgid "GitHub sent an unexpected answer (%1)."
msgstr "Το GitHub έστειλε μια μη αναμενόμενη απάντηση (%1)."

#: modules/gui/qt/util/redesign_updater.cpp:792
msgid ""
"This update isn't signed by VLC Redesign, so it wasn't used. Download it "
"from the release page instead."
msgstr ""
"Αυτή η ενημέρωση δεν είναι υπογεγραμμένη από το VLC Redesign, επομένως δεν "
"χρησιμοποιήθηκε. Κατεβάστε την από τη σελίδα της έκδοσης."

#: modules/gui/qt/util/redesign_updater.cpp:814
#: modules/gui/qt/util/redesign_updater.cpp:855
msgid ""
"The update's checksum is missing; download it from the release page instead."
msgstr ""
"Λείπει το άθροισμα ελέγχου της ενημέρωσης· κατεβάστε την από τη σελίδα της "
"έκδοσης."

#: modules/gui/qt/util/redesign_updater.cpp:829
#: modules/gui/qt/util/redesign_updater.cpp:901
msgid "The download failed. Check your connection and try again."
msgstr "Η λήψη απέτυχε. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."

#: modules/gui/qt/util/redesign_updater.cpp:914
msgid "The update doesn't match its checksum, so it wasn't used."
msgstr ""
"Η ενημέρωση δεν αντιστοιχεί στο άθροισμα ελέγχου της, γι' αυτό δεν "
"χρησιμοποιήθηκε."

#: modules/gui/qt/util/redesign_updater.cpp:945
msgid "The update isn't in a format this version knows."
msgstr "Η ενημέρωση δεν είναι σε μορφή που αναγνωρίζει αυτή η έκδοση."

#: modules/gui/qt/util/redesign_updater.cpp:948
#: modules/gui/qt/util/redesign_updater.cpp:972
#: modules/gui/qt/util/redesign_updater.cpp:983
#: modules/gui/qt/util/redesign_updater.cpp:989
msgid "The update is damaged."
msgstr "Η ενημέρωση είναι κατεστραμμένη."

#: modules/gui/qt/util/redesign_updater.cpp:953
msgid "The update isn't for this version."
msgstr "Η ενημέρωση δεν προορίζεται για αυτή την έκδοση."

#: modules/gui/qt/util/redesign_updater.cpp:962
#: modules/gui/qt/util/redesign_updater.cpp:999
#: modules/gui/qt/util/redesign_updater.cpp:1008
#: modules/gui/qt/util/redesign_updater.cpp:1012
#: modules/gui/qt/util/redesign_updater.cpp:1016
msgid "The update can't be written in %1."
msgstr "Δεν είναι δυνατή η εγγραφή της ενημέρωσης στο %1."

#: modules/gui/qt/util/redesign_updater.cpp:964
msgid ""
"A file of VLC Redesign was changed since it was installed, so the small "
"update can't be used: update with the installer instead."
msgstr ""
"Ένα αρχείο του VLC Redesign άλλαξε μετά την εγκατάσταση, γι' αυτό η μικρή "
"ενημέρωση δεν μπορεί να χρησιμοποιηθεί: ενημερώστε με το πρόγραμμα "
"εγκατάστασης."

#: modules/gui/qt/util/redesign_updater.cpp:994
msgid "The update is damaged: a file doesn't match its checksum."
msgstr ""
"Η ενημέρωση είναι κατεστραμμένη: ένα αρχείο δεν αντιστοιχεί στο άθροισμα "
"ελέγχου του."

#: modules/gui/qt/util/redesign_updater.cpp:1119
msgid "The update couldn't be started. It will be tried again next time."
msgstr ""
"Δεν ήταν δυνατή η έναρξη της ενημέρωσης. Θα γίνει νέα προσπάθεια την επόμενη "
"φορά."

#: modules/gui/qt/util/redesign_updater.cpp:1146
msgid "The download failed. Try again, or download it from the release page."
msgstr ""
"Η λήψη απέτυχε. Δοκιμάστε ξανά ή κατεβάστε την από τη σελίδα της έκδοσης."

#: modules/gui/qt/util/redesign_updater.cpp:1159
msgid "The downloaded installer doesn't match its checksum, so it wasn't run."
msgstr ""
"Το πρόγραμμα εγκατάστασης που λήφθηκε δεν αντιστοιχεί στο άθροισμα ελέγχου "
"του, γι' αυτό δεν εκτελέστηκε."

#: modules/gui/qt/util/redesign_updater.cpp:1168
msgid "The installer couldn't be saved to %1."
msgstr "Δεν ήταν δυνατή η αποθήκευση του προγράμματος εγκατάστασης στο %1."

#: modules/gui/qt/util/redesign_updater.cpp:1202
msgid "The installer couldn't be started."
msgstr "Δεν ήταν δυνατή η εκκίνηση του προγράμματος εγκατάστασης."

#: modules/gui/qt/util/renderer_manager.cpp:891
msgid ""
"%1 doesn't answer. Check that it's on, and on the same network as this "
"computer."
msgstr ""
"Το %1 δεν απαντά. Ελέγξτε ότι είναι ενεργοποιημένο και στο ίδιο δίκτυο με "
"αυτόν τον υπολογιστή."

#: modules/gui/qt/util/renderer_manager.cpp:894
msgid ""
"Windows Firewall doesn't let %1 connect to this computer to read the video."
msgstr ""
"Το Τείχος προστασίας των Windows δεν επιτρέπει στο %1 να συνδεθεί σε αυτόν "
"τον υπολογιστή για να διαβάσει το βίντεο."

#: modules/gui/qt/util/renderer_manager.cpp:895
msgid "%1 couldn't read the video from this computer."
msgstr "Το %1 δεν μπόρεσε να διαβάσει το βίντεο από αυτόν τον υπολογιστή."

#: modules/gui/qt/util/renderer_manager.cpp:897
msgid "%1 refused to play this video."
msgstr "Το %1 αρνήθηκε να αναπαραγάγει αυτό το βίντεο."

#: modules/gui/qt/util/renderer_manager.cpp:899
msgid "%1 stopped playing."
msgstr "Το %1 σταμάτησε την αναπαραγωγή."

#: modules/gui/qt/util/renderer_manager.cpp:901
msgid "%1 is playing something else now."
msgstr "Το %1 αναπαράγει τώρα κάτι άλλο."

#: modules/gui/qt/util/renderer_manager.cpp:902
msgid "%1 couldn't play the video."
msgstr "Το %1 δεν μπόρεσε να αναπαραγάγει το βίντεο."

