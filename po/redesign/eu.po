msgid "Enable backdrop blur filter for the main window if possible"
msgstr "Gaitu atzeko planoaren lausotze-iragazkia leiho nagusirako, ahal bada"

#: modules/gui/qt/qt.cpp:334
msgid ""
"If backdrop blur filter is available, use translucency in the backgrounds of "
"certain parts of the user interface instead of a solid color. This setting "
"impairs readibility of text."
msgstr ""
"Atzeko planoaren lausotze-iragazkia erabilgarri badago, erabili "
"zeharrargitasuna erabiltzaile-interfazeko zati batzuen atzeko planoetan, "
"kolore solido baten ordez. Ezarpen honek testuaren irakurgarritasuna "
"kaltetzen du."

