msgid "Safe area for the user interface"
msgstr "Erabiltzaile-interfazearen eremu segurua"

#: modules/gui/qt/qt.cpp:323
msgid ""
"Sets the safe area percentage between 0.0 and 100 when you want to ensure "
"the visibility of the user interface on a constrained viewport"
msgstr ""
"Eremu seguruaren ehunekoa ezartzen du 0,0 eta 100 artean, erabiltzaile-"
"interfazea ikus-eremu mugatu batean ikusgai dagoela ziurtatu nahi duzunean"

