msgstr "પુનઃસ્થાપિત કરશો નહીં"

#: modules/gui/qt/util/redesign_updater.cpp:215
msgid ""
"The update isn't signed by the publisher of this copy (%1), so it wasn't "
"used."
msgstr "આ અપડેટ આ નકલના પ્રકાશક (%1) દ્વારા સહી કરેલું નથી, તેથી તે વાપરવામાં આવ્યું નહીં."

#: modules/gui/qt/util/redesign_updater.cpp:460
msgid "%1 (later)"
msgstr "%1 (પછીથી)"

#: modules/gui/qt/util/redesign_updater.cpp:462
msgid "%1 (soon)"
msgstr "%1 (ટૂંક સમયમાં)"

#: modules/gui/qt/util/redesign_updater.cpp:610
msgid "This build cannot check for updates."
msgstr "આ બિલ્ડ અપડેટ માટે તપાસી શકતું નથી."

#: modules/gui/qt/util/redesign_updater.cpp:624
msgid "Couldn't reach GitHub. Check your connection and try again."
msgstr "GitHub સુધી પહોંચી શકાયું નથી. તમારું જોડાણ તપાસો અને ફરી પ્રયાસ કરો."

#: modules/gui/qt/util/redesign_updater.cpp:641
msgid "GitHub sent an unexpected answer (%1)."
msgstr "GitHub એ અણધાર્યો જવાબ મોકલ્યો (%1)."

#: modules/gui/qt/util/redesign_updater.cpp:759
msgid ""
"This update isn't signed by VLC Redesign, so it wasn't used. Download it "
"from the release page instead."
msgstr ""
"આ અપડેટ પર VLC Redesign ની સહી નથી, તેથી તેનો ઉપયોગ થયો નથી. તેના બદલે તેને રિલીઝ "
"પાના પરથી ડાઉનલોડ કરો."

#: modules/gui/qt/util/redesign_updater.cpp:781
#: modules/gui/qt/util/redesign_updater.cpp:822
msgid ""
"The update's checksum is missing; download it from the release page instead."
msgstr "અપડેટનો ચેકસમ ખૂટે છે; તેના બદલે તેને રિલીઝ પાના પરથી ડાઉનલોડ કરો."

#: modules/gui/qt/util/redesign_updater.cpp:796
#: modules/gui/qt/util/redesign_updater.cpp:868
msgid "The download failed. Check your connection and try again."
msgstr "ડાઉનલોડ નિષ્ફળ ગયું. તમારું જોડાણ તપાસો અને ફરી પ્રયાસ કરો."

#: modules/gui/qt/util/redesign_updater.cpp:881
msgid "The update doesn't match its checksum, so it wasn't used."
msgstr "અપડેટ તેના ચેકસમ સાથે મેળ ખાતું નથી, તેથી તે વાપરવામાં આવ્યું નથી."

#: modules/gui/qt/util/redesign_updater.cpp:912
msgid "The update isn't in a format this version knows."
msgstr "અપડેટ એવા બંધારણમાં છે જે આ આવૃત્તિ જાણતી નથી."

#: modules/gui/qt/util/redesign_updater.cpp:915
#: modules/gui/qt/util/redesign_updater.cpp:939
#: modules/gui/qt/util/redesign_updater.cpp:950
#: modules/gui/qt/util/redesign_updater.cpp:956
msgid "The update is damaged."
msgstr "અપડેટ ખરાબ થયેલું છે."

