msgstr "इनपुट एक्सेस और कोडेक"

#: src/libvlc-module.c:2153
#: modules/gui/qt/dialogs/preferences/qml/SettingsDialog.qml:506
#: modules/gui/qt/dialogs/preferences/qml/SettingsDialog.qml:549
