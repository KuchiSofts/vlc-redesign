#: modules/gui/qt/dialogs/preferences/qml/SettingsSubtitleLanguages.qml:102
#: modules/gui/qt/dialogs/preferences/qml/SettingsDialog.qml:528
msgid "Find subtitles online when a video has none in these languages"
msgstr "Գտնել ենթագրեր առցանց, երբ վիդեոն այս լեզուներով ենթագրեր չունի"

#: modules/gui/qt/dialogs/firstrun/qml/SubtitleLanguagesStep.qml:135
msgid ""
"Online subtitles come from free services (OpenSubtitles, and more for some "
"languages). Change all of it in Settings, Subtitles."
msgstr ""
"Առցանց ենթագրերը ստացվում են անվճար ծառայություններից (OpenSubtitles և որոշ "
"լեզուների համար՝ այլ ծառայություններ)։ Այս ամենը կարող եք փոխել "
"Կարգավորումներում՝ «Ենթագրեր» բաժնում։"

