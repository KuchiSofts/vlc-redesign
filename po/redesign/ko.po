#: modules/gui/qt/playlist/qml/PlaylistPane.qml:274
msgid "Add files to the queue"
msgstr "대기열에 파일 추가"

#: modules/gui/qt/playlist/qml/PlaylistPane.qml:601
msgid "No results"
msgstr "결과 없음"

#: modules/gui/qt/playlist/qml/PlaylistPane.qml:602
msgid "No content yet"
msgstr "아직 콘텐츠가 없습니다"

#: modules/gui/qt/playlist/qml/PlaylistPane.qml:618
msgid "Drag & Drop some content here!"
msgstr "여기에 콘텐츠를 끌어다 놓으세요!"

#: modules/gui/qt/playlist/qml/PlaylistPane.qml:683
msgid "Play queue"
msgstr "재생 대기열"

#: modules/gui/qt/playlist/qml/QueueHeader.qml:171
msgid "%1 elements, %2"
msgstr "항목 %1개, %2"

#: modules/gui/qt/qt.cpp:172
msgid "Select the initial preferences view"
msgstr "처음 표시할 환경설정 보기 선택"

#: modules/gui/qt/qt.cpp:173
msgid ""
"Select which preferences view to show upon opening the preferences dialog."
msgstr "환경설정 대화 상자를 열 때 표시할 보기를 선택합니다."

#: modules/gui/qt/qt.cpp:197
msgid ""
"Show a notification popup with the artist and track name when the current "
"play queue item changes, when VLC is minimized or hidden."
msgstr ""
"VLC가 최소화되거나 숨겨져 있을 때 현재 재생 대기열 항목이 바뀌면 아티스트와 "
"트랙 이름이 담긴 알림 팝업을 표시합니다."

#: modules/gui/qt/qt.cpp:201
msgid ""
"Sets the windows opacity between 0.1 and 1 for main interface, play queue "
"and extended panel. This option only works with Windows and X11 with "
"composite extensions."
msgstr ""
"메인 인터페이스, 재생 대기열 및 확장 패널의 창 불투명도를 0.1에서 1 사이로 설"
"정합니다. 이 옵션은 Windows 및 컴포지트 확장이 있는 X11에서만 작동합니다."

#: modules/gui/qt/qt.cpp:207
msgid ""
"Sets the fullscreen controller opacity between 0.1 and 1 for main interface, "
"play queue and extended panel. This option only works with Windows and X11 "
"with composite extensions."
msgstr ""
"메인 인터페이스, 재생 대기열 및 확장 패널의 전체화면 컨트롤러 불투명도를 0.1"
"에서 1 사이로 설정합니다. 이 옵션은 Windows 및 컴포지트 확장이 있는 X11에서"
"만 작동합니다."

#: modules/gui/qt/qt.cpp:212
msgid "Initial user scale factor for the interface, between 0.3 and 3.0"
msgstr "인터페이스의 초기 사용자 배율 (0.3에서 3.0 사이)"

#: modules/gui/qt/qt.cpp:215
msgid ""
"Show the errors of VLC at the bottom of the window, and ask before removing "
"media from a playlist or from the play queue, or deleting playlists. Off, "
"the errors are only kept in the messages of VLC and these removals are done "
"at once; deleting a file from the disk is always confirmed."
msgstr ""
"VLC 오류를 창 아래쪽에 표시하고, 재생목록이나 재생 대기열에서 미디어를 제거하"
"거나 재생목록을 삭제하기 전에 확인합니다. 끄면 오류는 VLC 메시지에만 남고 이"
"러한 제거는 바로 실행됩니다. 디스크에서 파일을 삭제할 때는 항상 확인합니다."

#: modules/gui/qt/qt.cpp:225
msgid "set the options for qml debugger"
msgstr "QML 디버거 옵션 설정"

#: modules/gui/qt/qt.cpp:226
msgid ""
"set the options for qml debugger (see http://doc.qt.io/qt-5/qtquick-"
"debugging.html#starting-applications)"
msgstr ""
"QML 디버거 옵션 설정 (http://doc.qt.io/qt-5/qtquick-debugging.html#starting-"
"applications 참조)"

#: modules/gui/qt/qt.cpp:246
msgid ""
"Show the playback controls in fullscreen when the mouse moves. Off, only the "
"keyboard shows them (the I key). The skins read it for their fullscreen "
"controller too."
msgstr ""
"전체화면에서 마우스를 움직이면 재생 컨트롤을 표시합니다. 끄면 키보드(I 키)로"
"만 표시됩니다. 스킨의 전체화면 컨트롤러에도 이 설정이 적용됩니다."

#: modules/gui/qt/qt.cpp:262
msgid ""
"Display the cover art of the audio playing in the player (the cone in the "
"compact view). Off, a plain picture takes its place, which also prevents "
"burning the screen."
msgstr ""
"재생 중인 오디오의 커버 아트를 플레이어에 표시합니다(컴팩트 보기에서는 원"
"뿔). 끄면 단순한 그림이 대신 표시되며, 화면 번인도 방지됩니다."

#: modules/gui/qt/qt.cpp:286
msgid ""
"This option allows the interface to be shown and raised automatically when a "
"video/audio playback starts, or never."
msgstr ""
"비디오/오디오 재생이 시작될 때 인터페이스를 자동으로 표시하고 앞으로 가져올"
"지, 또는 절대 그렇게 하지 않을지 설정합니다."

#: modules/gui/qt/qt.cpp:289
msgid "Enable window titlebar"
msgstr "창 제목 표시줄 사용"

#: modules/gui/qt/qt.cpp:290
msgid ""
"This option enables the title bar. Disabling it will remove the titlebar and "
"move window buttons within the interface (Client Side Decoration)"
msgstr ""
"제목 표시줄을 사용합니다. 사용하지 않으면 제목 표시줄이 사라지고 창 버튼이 인"
"터페이스 안으로 이동합니다(클라이언트 측 창 장식)"

#: modules/gui/qt/qt.cpp:294
msgid "Show the menu bar"
msgstr "메뉴 막대 표시"

#: modules/gui/qt/qt.cpp:295
msgid "This option displays the classic menu bar"
msgstr "클래식 메뉴 막대를 표시합니다"

#: modules/gui/qt/qt.cpp:297
msgid "Pin video controls"
msgstr "비디오 컨트롤 고정"

#: modules/gui/qt/qt.cpp:298
msgid "Place video controls above and below the video instead of above"
msgstr ""
"비디오 컨트롤을 비디오 위에 겹치지 않고 비디오의 위와 아래에 배치합니다"

#: modules/gui/qt/qt.cpp:301
msgid "Show the frame at the hovered position above the seek bar"
msgstr "탐색 막대에서 마우스를 올린 위치의 프레임을 위에 표시"

#: modules/gui/qt/qt.cpp:305
msgid "Select Qt video integration backend"
msgstr "Qt 비디오 통합 백엔드 선택"

#: modules/gui/qt/qt.cpp:306
msgid ""
"Select Qt video integration backend. Use with care, the interface may not "
"start if an incompatible compositor is selected"
msgstr ""
"Qt 비디오 통합 백엔드를 선택합니다. 호환되지 않는 컴포지터를 선택하면 인터페"
"이스가 시작되지 않을 수 있으니 주의해서 사용하세요"

#: modules/gui/qt/qt.cpp:308
msgid "Use smooth scrolling in Flickable based views"
msgstr "Flickable 기반 보기에서 부드러운 스크롤 사용"

#: modules/gui/qt/qt.cpp:309
msgid ""
"Deactivating this option will disable smooth scrolling in Flickable based "
"views (such as the Play Queue). This option is only respected with a scroll "
"handler, see option `qt-use-scroll-handler`."
msgstr ""
"이 옵션을 끄면 Flickable 기반 보기(재생 대기열 등)에서 부드러운 스크롤이 비활"
"성화됩니다. 이 옵션은 스크롤 핸들러를 사용할 때만 적용됩니다. `qt-use-scroll-"
"handler` 옵션을 참조하세요."

#: modules/gui/qt/qt.cpp:312
msgid "Use Kirigami scroll handler for Flickable based views"
msgstr "Flickable 기반 보기에 Kirigami 스크롤 핸들러 사용"

#: modules/gui/qt/qt.cpp:313
msgid "Using Kirigami scroll handler may improve scrolling behavior."
msgstr "Kirigami 스크롤 핸들러를 사용하면 스크롤 동작이 개선될 수 있습니다."

#: modules/gui/qt/qt.cpp:315
msgid "Safe area for the user interface"
msgstr "사용자 인터페이스 안전 영역"

#: modules/gui/qt/qt.cpp:316
msgid ""
"Sets the safe area percentage between 0.0 and 100 when you want to ensure "
"the visibility of the user interface on a constrained viewport"
msgstr ""
"제한된 화면에서도 사용자 인터페이스가 보이도록 안전 영역 비율을 0.0에서 100 "
"사이로 설정합니다"

#: modules/gui/qt/qt.cpp:320
msgid "Print Qt's important internal messages"
msgstr "Qt의 중요한 내부 메시지 출력"

#: modules/gui/qt/qt.cpp:321
msgid "Enable Qt's all own messaging categories except the debug category."
msgstr "디버그 범주를 제외한 Qt 자체의 모든 메시지 범주를 사용합니다."

#: modules/gui/qt/qt.cpp:323
msgid "Hide the window on close"
msgstr "닫을 때 창 숨기기"

#: modules/gui/qt/qt.cpp:324
msgid ""
"Instead of closing the application, hide the window. This setting is only "
"applicable when system tray icon is enabled."
msgstr ""
"응용 프로그램을 닫는 대신 창을 숨깁니다. 이 설정은 시스템 트레이 아이콘을 사"
"용할 때만 적용됩니다."

#: modules/gui/qt/qt.cpp:326
msgid "Enable backdrop blur filter for the main window if possible"
msgstr "가능하면 메인 창에 배경 흐림 필터 사용"

#: modules/gui/qt/qt.cpp:327
msgid ""
"If backdrop blur filter is available, use translucency in the backgrounds of "
"certain parts of the user interface instead of a solid color. This setting "
"impairs readibility of text."
msgstr ""
"배경 흐림 필터를 사용할 수 있으면 사용자 인터페이스 일부의 배경에 단색 대신 "
"반투명 효과를 사용합니다. 이 설정은 텍스트 가독성을 떨어뜨립니다."

#: modules/gui/qt/qt.cpp:330
msgid "Enable picture-in-picture (PiP) mode"
msgstr "화면 속 화면(PiP) 모드 사용"

#: modules/gui/qt/qt.cpp:331
msgid ""
"Picture-in-picture mode allows playing video contained in a smaller area so "
"that the interface remains usable."
msgstr ""
"화면 속 화면 모드는 비디오를 작은 영역에서 재생하여 인터페이스를 계속 사용할 "
"수 있게 합니다."

#: modules/gui/qt/qt.cpp:334
msgid ""
"Adjusts the accent color, special values are 'default' and 'system' "
"(requires Qt 6.6) ."
msgstr ""
"강조 색을 조정합니다. 특수 값은 'default'와 'system'입니다(Qt 6.6 필요)."

#: modules/gui/qt/qt.cpp:435
msgid "Check for VLC Redesign updates"
msgstr "VLC Redesign 업데이트 확인"

#: modules/gui/qt/qt.cpp:436
msgid ""
"Look for a new release of VLC Redesign on GitHub at startup, at most once a "
"day."
msgstr ""
"시작할 때 GitHub에서 VLC Redesign의 새 릴리스를 확인합니다(하루 최대 한 번)."

#: modules/gui/qt/qt.cpp:440
msgid "Resume at"
msgstr "재개 위치"

#: modules/gui/qt/qt.cpp:441
msgid ""
"Seconds into the media of the command line where playback continues, after "
"an update."
msgstr "업데이트 후 명령줄로 지정한 미디어에서 재생을 이어 갈 위치(초)입니다."

#: modules/gui/qt/util/color_scheme_model.cpp:41
msgid "Day"
msgstr "주간"

#: modules/gui/qt/util/color_scheme_model.cpp:43
msgid "Night"
msgstr "야간"

#: modules/gui/qt/util/vlctick.cpp:88
msgid "%1 h %2 min"
msgstr "%1시간 %2분"

#: modules/gui/qt/util/vlctick.cpp:100
msgid "%1 min %2 s"
msgstr "%1분 %2초"

#: modules/gui/qt/util/vlctick.cpp:104
msgid "%1 sec"
msgstr "%1초"

#: modules/gui/qt/util/vlctick.cpp:125
msgid "%1h%2"
msgstr "%1시간 %2분"

#: modules/gui/qt/util/vlctick.cpp:144
#, no-c-format
msgid "%1ms"
msgstr "%1 ms"

#: modules/gui/qt/util/redesign_updater.cpp:400
msgid "This build cannot check for updates."
msgstr "이 빌드에서는 업데이트를 확인할 수 없습니다."

#: modules/gui/qt/util/redesign_updater.cpp:414
msgid "Couldn't reach GitHub. Check your connection and try again."
msgstr "GitHub에 연결할 수 없습니다. 연결을 확인하고 다시 시도하세요."

#: modules/gui/qt/util/redesign_updater.cpp:431
msgid "GitHub sent an unexpected answer (%1)."
msgstr "GitHub에서 예기치 않은 응답을 보냈습니다(%1)."

#: modules/gui/qt/util/redesign_updater.cpp:537
msgid ""
"The update's checksum is missing; download it from the release page instead."
msgstr "업데이트의 체크섬이 없습니다. 대신 릴리스 페이지에서 다운로드하세요."

#: modules/gui/qt/util/redesign_updater.cpp:584
msgid "The download failed. Check your connection and try again."
msgstr "다운로드에 실패했습니다. 연결을 확인하고 다시 시도하세요."

#: modules/gui/qt/util/redesign_updater.cpp:597
msgid "The update doesn't match its checksum, so it wasn't used."
msgstr "업데이트가 체크섬과 일치하지 않아 사용하지 않았습니다."

#: modules/gui/qt/util/redesign_updater.cpp:619
msgid "The update isn't in a format this version knows."
msgstr "이 버전에서 인식할 수 없는 형식의 업데이트입니다."

#: modules/gui/qt/util/redesign_updater.cpp:622
#: modules/gui/qt/util/redesign_updater.cpp:646
#: modules/gui/qt/util/redesign_updater.cpp:657
#: modules/gui/qt/util/redesign_updater.cpp:663
msgid "The update is damaged."
msgstr "업데이트가 손상되었습니다."

#: modules/gui/qt/util/redesign_updater.cpp:627
msgid "The update isn't for this version."
msgstr "이 버전용 업데이트가 아닙니다."

#: modules/gui/qt/util/redesign_updater.cpp:636
#: modules/gui/qt/util/redesign_updater.cpp:673
#: modules/gui/qt/util/redesign_updater.cpp:682
#: modules/gui/qt/util/redesign_updater.cpp:686
#: modules/gui/qt/util/redesign_updater.cpp:690
msgid "The update can't be written in %1."
msgstr "%1에 업데이트를 쓸 수 없습니다."

#: modules/gui/qt/util/redesign_updater.cpp:638
msgid ""
"A file of VLC Redesign was changed since it was installed, so the small "
"update can't be used: update with the installer instead."
msgstr ""
"설치 후 VLC Redesign 파일이 변경되어 부분 업데이트를 사용할 수 없습니다. 대"
"신 설치 프로그램으로 업데이트하세요."

#: modules/gui/qt/util/redesign_updater.cpp:668
msgid "The update is damaged: a file doesn't match its checksum."
msgstr "업데이트가 손상되었습니다. 파일이 체크섬과 일치하지 않습니다."

#: modules/gui/qt/util/redesign_updater.cpp:793
msgid "The update couldn't be started. It will be tried again next time."
msgstr "업데이트를 시작할 수 없습니다. 다음에 다시 시도합니다."

#: modules/gui/qt/util/redesign_updater.cpp:820
msgid "The download failed. Try again, or download it from the release page."
msgstr ""
"다운로드에 실패했습니다. 다시 시도하거나 릴리스 페이지에서 다운로드하세요."

#: modules/gui/qt/util/redesign_updater.cpp:833
msgid "The downloaded installer doesn't match its checksum, so it wasn't run."
msgstr "다운로드한 설치 프로그램이 체크섬과 일치하지 않아 실행하지 않았습니다."

#: modules/gui/qt/util/redesign_updater.cpp:842
msgid "The installer couldn't be saved to %1."
msgstr "설치 프로그램을 %1에 저장할 수 없습니다."

#: modules/gui/qt/util/redesign_updater.cpp:870
msgid "The installer couldn't be started."
msgstr "설치 프로그램을 시작할 수 없습니다."

#: modules/gui/qt/util/renderer_manager.cpp:867
msgid ""
"%1 doesn't answer. Check that it's on, and on the same network as this "
"computer."
msgstr ""
"%1이(가) 응답하지 않습니다. 장치가 켜져 있고 이 컴퓨터와 같은 네트워크에 있는"
"지 확인하세요."

#: modules/gui/qt/util/renderer_manager.cpp:870
msgid ""
"Windows Firewall doesn't let %1 connect to this computer to read the video."
msgstr ""
"Windows 방화벽 때문에 %1이(가) 비디오를 읽으려고 이 컴퓨터에 연결할 수 없습니"
"다."

#: modules/gui/qt/util/renderer_manager.cpp:871
msgid "%1 couldn't read the video from this computer."
msgstr "%1이(가) 이 컴퓨터의 비디오를 읽을 수 없습니다."

#: modules/gui/qt/util/renderer_manager.cpp:873
msgid "%1 refused to play this video."
msgstr "%1이(가) 이 비디오 재생을 거부했습니다."

#: modules/gui/qt/util/renderer_manager.cpp:875
msgid "%1 stopped playing."
msgstr "%1에서 재생이 중지되었습니다."

#: modules/gui/qt/util/renderer_manager.cpp:877
msgid "%1 is playing something else now."
msgstr "%1에서 지금 다른 항목을 재생하고 있습니다."

#: modules/gui/qt/util/renderer_manager.cpp:878
