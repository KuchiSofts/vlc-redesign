#: modules/gui/qt/util/redesign_updater.cpp:221
msgid ""
"The update isn't signed by the publisher of this copy (%1), so it wasn't "
"used."
msgstr "ഈ പകർപ്പിന്റെ പ്രസാധകൻ (%1) അപ്ഡേറ്റിൽ ഒപ്പിട്ടിട്ടില്ലാത്തതിനാൽ അത് ഉപയോഗിച്ചില്ല."

