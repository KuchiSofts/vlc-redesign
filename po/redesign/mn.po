#: modules/gui/qt/util/redesign_updater.cpp:221
msgid ""
"The update isn't signed by the publisher of this copy (%1), so it wasn't "
"used."
msgstr ""
"Шинэчлэлийг энэ хуулбарын нийтлэгч (%1) гарын үсгээр баталгаажуулаагүй тул "
"ашиглаагүй."

#: modules/gui/qt/util/redesign_updater.cpp:467
msgid "%1 (later)"
msgstr "%1 (дараа)"

#: modules/gui/qt/util/redesign_updater.cpp:469
msgid "%1 (soon)"
msgstr "%1 (удахгүй)"

#: modules/gui/qt/util/redesign_updater.cpp:649
msgid "This build cannot check for updates."
msgstr "Энэ хувилбар шинэчлэлт шалгах боломжгүй."

#: modules/gui/qt/util/redesign_updater.cpp:663
msgid "Couldn't reach GitHub. Check your connection and try again."
msgstr "GitHub-д холбогдож чадсангүй. Холболтоо шалгаад дахин оролдоно уу."

#: modules/gui/qt/util/redesign_updater.cpp:680
msgid "GitHub sent an unexpected answer (%1)."
msgstr "GitHub гэнэтийн хариу илгээлээ (%1)."

#: modules/gui/qt/util/redesign_updater.cpp:798
msgid ""
"This update isn't signed by VLC Redesign, so it wasn't used. Download it "
"from the release page instead."
msgstr ""
"Энэ шинэчлэлийг VLC Redesign гарын үсгээр баталгаажуулаагүй тул ашиглаагүй. "
"Оронд нь хувилбарын хуудаснаас татна уу."

#: modules/gui/qt/util/redesign_updater.cpp:820
#: modules/gui/qt/util/redesign_updater.cpp:861
msgid ""
"The update's checksum is missing; download it from the release page instead."
msgstr ""
"Шинэчлэлтийн хяналтын нийлбэр алга; оронд нь хувилбарын хуудаснаас татна уу."

#: modules/gui/qt/util/redesign_updater.cpp:835
#: modules/gui/qt/util/redesign_updater.cpp:907
msgid "The download failed. Check your connection and try again."
msgstr "Татаж чадсангүй. Холболтоо шалгаад дахин оролдоно уу."

#: modules/gui/qt/util/redesign_updater.cpp:920
msgid "The update doesn't match its checksum, so it wasn't used."
msgstr "Шинэчлэлт хяналтын нийлбэртэйгээ таарахгүй байгаа тул ашиглаагүй."

#: modules/gui/qt/util/redesign_updater.cpp:951
msgid "The update isn't in a format this version knows."
msgstr "Шинэчлэлт энэ хувилбарын мэдэх форматад биш байна."

#: modules/gui/qt/util/redesign_updater.cpp:954
#: modules/gui/qt/util/redesign_updater.cpp:978
#: modules/gui/qt/util/redesign_updater.cpp:989
#: modules/gui/qt/util/redesign_updater.cpp:995
msgid "The update is damaged."
msgstr "Шинэчлэлт гэмтсэн байна."

#: modules/gui/qt/util/redesign_updater.cpp:959
msgid "The update isn't for this version."
msgstr "Шинэчлэлт энэ хувилбарт зориулагдаагүй."

#: modules/gui/qt/util/redesign_updater.cpp:968
#: modules/gui/qt/util/redesign_updater.cpp:1005
#: modules/gui/qt/util/redesign_updater.cpp:1014
#: modules/gui/qt/util/redesign_updater.cpp:1018
#: modules/gui/qt/util/redesign_updater.cpp:1022
msgid "The update can't be written in %1."
msgstr "Шинэчлэлтийг дараах байршилд бичих боломжгүй: %1."

#: modules/gui/qt/util/redesign_updater.cpp:970
msgid ""
"A file of VLC Redesign was changed since it was installed, so the small "
"update can't be used: update with the installer instead."
msgstr ""
"VLC Redesign-ийн нэг файл суулгаснаас хойш өөрчлөгдсөн тул жижиг "
"шинэчлэлтийг ашиглах боломжгүй: оронд нь суулгагчаар шинэчилнэ үү."

#: modules/gui/qt/util/redesign_updater.cpp:1000
msgid "The update is damaged: a file doesn't match its checksum."
msgstr ""
"Шинэчлэлт гэмтсэн байна: нэг файл хяналтын нийлбэртэйгээ таарахгүй байна."

#: modules/gui/qt/util/redesign_updater.cpp:1125
msgid "The update couldn't be started. It will be tried again next time."
msgstr "Шинэчлэлтийг эхлүүлж чадсангүй. Дараагийн удаа дахин оролдоно."

#: modules/gui/qt/util/redesign_updater.cpp:1152
msgid "The download failed. Try again, or download it from the release page."
msgstr "Татаж чадсангүй. Дахин оролдох эсвэл хувилбарын хуудаснаас татна уу."

#: modules/gui/qt/util/redesign_updater.cpp:1165
msgid "The downloaded installer doesn't match its checksum, so it wasn't run."
msgstr ""
"Татсан суулгагч хяналтын нийлбэртэйгээ таарахгүй байгаа тул ажиллуулаагүй."

#: modules/gui/qt/util/redesign_updater.cpp:1174
msgid "The installer couldn't be saved to %1."
msgstr "Суулгагчийг хадгалж чадсангүй: %1."

#: modules/gui/qt/util/redesign_updater.cpp:1208
msgid "The installer couldn't be started."
msgstr "Суулгагчийг эхлүүлж чадсангүй."

#: modules/gui/qt/util/renderer_manager.cpp:896
msgid ""
"%1 doesn't answer. Check that it's on, and on the same network as this "
