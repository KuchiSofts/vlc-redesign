msgstr "ही प्ले रांग वाचनखूण निश्चित करण्यासाठी की निवडा."

#: src/libvlc-module.c:1513 modules/gui/qt/menus/qml_menu_wrapper.cpp:1212
msgid "Clear the play queue"
msgstr "प्ले रांग रिकामी करा"

#: src/libvlc-module.c:1514
