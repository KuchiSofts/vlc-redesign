msgstr "यसले बजाउने लाम बुकमार्कहरू निर्धारण गर्न दिन्छ।"

#: src/libvlc-module.c:1383
msgid "Select the hotkey to use to skip to the next item in the play queue."
msgstr "बजाउने लामको अर्को वस्तुमा जान प्रयोग गर्ने हटकुञ्जी छान्नुहोस्।"

#: src/libvlc-module.c:1385
msgid ""
"Select the hotkey to use to skip to the previous item in the play queue."
msgstr "बजाउने लामको अघिल्लो वस्तुमा जान प्रयोग गर्ने हटकुञ्जी छान्नुहोस्।"

#: src/libvlc-module.c:1418
msgid "Select the hotkey to go to the next video frame."
msgstr "अर्को भिडियो फ्रेममा जाने हटकुञ्जी छान्नुहोस्।"

#: src/libvlc-module.c:1419 src/player/input.c:968
#: modules/gui/qt/player/qml/controlbarcontrols/FramePrevButton.qml:34
msgid "Previous frame"
msgstr "अघिल्लो फ्रेम"

#: src/libvlc-module.c:1421
