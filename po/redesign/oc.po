#: modules/gui/qt/util/redesign_updater.cpp:931
msgid ""
"A file of VLC Redesign was changed since it was installed, so the small "
"update can't be used: update with the installer instead."
msgstr ""
"Un fichièr de VLC Redesign es estat modificat dempuèi son installacion, "
"doncas la pichona mesa a jorn se pòt pas utilizar : metètz a jorn amb "
"l'installador a la plaça."

#: modules/gui/qt/util/redesign_updater.cpp:961
msgid "The update is damaged: a file doesn't match its checksum."
msgstr ""
"La mesa a jorn es damatjada : un fichièr correspond pas a sa soma de "
"contraròtle."

#: modules/gui/qt/util/redesign_updater.cpp:1086
msgid "The update couldn't be started. It will be tried again next time."
msgstr ""
"La mesa a jorn a pas pogut èsser aviada. Serà ensajada tornamai la còp que "
"ven."

#: modules/gui/qt/util/redesign_updater.cpp:1113
msgid "The download failed. Try again, or download it from the release page."
msgstr ""
"Lo telecargament a fracassat. Tornatz ensajar, o telecargatz-la dempuèi la "
"pagina de la version."

#: modules/gui/qt/util/redesign_updater.cpp:1126
