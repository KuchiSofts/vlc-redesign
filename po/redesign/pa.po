msgstr "ਨਹੀਂ ਚੱਲ ਰਿਹਾ: ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰਨ ਲਈ ਇਸ ਨੂੰ ਚੁਣੋ"

#: modules/gui/qt/player/qml/controlbarcontrols/CastButton.qml:154
msgid "Connecting…"
msgstr "ਜੁੜਿਆ ਜਾ ਰਿਹਾ ਹੈ…"

#: modules/gui/qt/player/qml/controlbarcontrols/CastButton.qml:155
msgid "Sound only"
msgstr "ਸਿਰਫ਼ ਆਵਾਜ਼"

#: modules/gui/qt/player/qml/controlbarcontrols/CastButton.qml:174
msgid "Looking for TVs and Chromecasts on your network…"
msgstr "ਤੁਹਾਡੇ ਨੈੱਟਵਰਕ ਉੱਤੇ TV ਅਤੇ Chromecast ਲੱਭੇ ਜਾ ਰਹੇ ਹਨ…"

#: modules/gui/qt/player/qml/controlbarcontrols/CastButton.qml:175
msgid ""
"No device found. Turn your TV or Chromecast on, on the same network as this "
"computer."
msgstr ""
"ਕੋਈ ਜੰਤਰ ਨਹੀਂ ਲੱਭਿਆ। ਆਪਣਾ TV ਜਾਂ Chromecast ਇਸ ਕੰਪਿਊਟਰ ਵਾਲੇ ਨੈੱਟਵਰਕ ਉੱਤੇ ਹੀ ਚਾਲੂ ਕਰੋ।"

#: modules/gui/qt/player/qml/controlbarcontrols/CastButton.qml:189
msgid "Show the video here too"
msgstr "ਵਿਡੀਓ ਇੱਥੇ ਵੀ ਵੇਖਾਓ"

#: modules/gui/qt/player/qml/controlbarcontrols/CastButton.qml:235
msgid "With a Chromecast, the video plays only there."
msgstr "Chromecast ਨਾਲ ਵਿਡੀਓ ਸਿਰਫ਼ ਉੱਥੇ ਹੀ ਚੱਲਦੀ ਹੈ।"

#: modules/gui/qt/player/qml/controlbarcontrols/CastButton.qml:246
msgid "The subtitles shown go to the TV with the picture."
msgstr "ਵੇਖਾਏ ਜਾ ਰਹੇ ਸਬ-ਟਾਈਟਲ ਤਸਵੀਰ ਦੇ ਨਾਲ TV ਉੱਤੇ ਜਾਂਦੇ ਹਨ।"

#: modules/gui/qt/player/qml/controlbarcontrols/CastButton.qml:265
msgid "playing here"
msgstr "ਇੱਥੇ ਚੱਲ ਰਿਹਾ ਹੈ"

#: modules/gui/qt/player/qml/controlbarcontrols/ResolutionWidget.qml:17
msgid "Resolution unavailable"
msgstr "ਰੈਜ਼ੋਲੂਸ਼ਨ ਉਪਲੱਬਧ ਨਹੀਂ"

#: modules/gui/qt/player/qml/controlbarcontrols/SkipBack10Button.qml:28
