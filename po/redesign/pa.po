msgstr "10 ਸਕਿੰਟ ਅੱਗੇ"

#: modules/gui/qt/player/qml/controlbarcontrols/SkipForwardButton.qml:33
msgid "Forward 15 seconds"
msgstr "15 ਸਕਿੰਟ ਅੱਗੇ"

#: modules/gui/qt/player/qml/controlbarcontrols/VolumeWidget.qml:351
