msgstr ""
"Actualizarea nu corespunde sumei de control, așa că nu a fost folosită."

#: modules/gui/qt/util/redesign_updater.cpp:619
msgid "The update isn't in a format this version knows."
msgstr "Actualizarea nu este într-un format cunoscut de această versiune."

#: modules/gui/qt/util/redesign_updater.cpp:622
#: modules/gui/qt/util/redesign_updater.cpp:646
#: modules/gui/qt/util/redesign_updater.cpp:657
#: modules/gui/qt/util/redesign_updater.cpp:663
