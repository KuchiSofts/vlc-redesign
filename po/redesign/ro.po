msgstr "Actualizarea este deteriorată."

#: modules/gui/qt/util/redesign_updater.cpp:627
msgid "The update isn't for this version."
msgstr "Actualizarea nu este pentru această versiune."

#: modules/gui/qt/util/redesign_updater.cpp:636
#: modules/gui/qt/util/redesign_updater.cpp:673
#: modules/gui/qt/util/redesign_updater.cpp:682
#: modules/gui/qt/util/redesign_updater.cpp:686
#: modules/gui/qt/util/redesign_updater.cpp:690
msgid "The update can't be written in %1."
msgstr "Actualizarea nu poate fi scrisă în %1."

#: modules/gui/qt/util/redesign_updater.cpp:638
msgid ""
"A file of VLC Redesign was changed since it was installed, so the small "
"update can't be used: update with the installer instead."
msgstr ""
"Un fișier VLC Redesign a fost modificat de la instalare, așa că actualizarea "
"mică nu poate fi folosită: actualizați cu programul de instalare."

#: modules/gui/qt/util/redesign_updater.cpp:668
msgid "The update is damaged: a file doesn't match its checksum."
msgstr ""
"Actualizarea este deteriorată: un fișier nu corespunde sumei de control."

#: modules/gui/qt/util/redesign_updater.cpp:793
msgid "The update couldn't be started. It will be tried again next time."
msgstr ""
"Actualizarea nu a putut fi pornită. Se va încerca din nou data viitoare."

#: modules/gui/qt/util/redesign_updater.cpp:820
msgid "The download failed. Try again, or download it from the release page."
msgstr ""
"Descărcarea a eșuat. Încercați din nou sau descărcați-o de pe pagina "
"versiunii."

#: modules/gui/qt/util/redesign_updater.cpp:833
msgid "The downloaded installer doesn't match its checksum, so it wasn't run."
msgstr ""
"Programul de instalare descărcat nu corespunde sumei de control, așa că nu a "
"fost rulat."

#: modules/gui/qt/util/redesign_updater.cpp:842
msgid "The installer couldn't be saved to %1."
msgstr "Programul de instalare nu a putut fi salvat în %1."

#: modules/gui/qt/util/redesign_updater.cpp:870
msgid "The installer couldn't be started."
msgstr "Programul de instalare nu a putut fi pornit."

#: modules/gui/qt/util/renderer_manager.cpp:867
msgid ""
"%1 doesn't answer. Check that it's on, and on the same network as this "
"computer."
msgstr ""
"%1 nu răspunde. Verificați dacă este pornit și în aceeași rețea cu acest "
"computer."

#: modules/gui/qt/util/renderer_manager.cpp:870
msgid ""
"Windows Firewall doesn't let %1 connect to this computer to read the video."
msgstr ""
"Paravanul de protecție Windows nu permite ca %1 să se conecteze la acest "
"computer pentru a citi videoclipul."

#: modules/gui/qt/util/renderer_manager.cpp:871
msgid "%1 couldn't read the video from this computer."
msgstr "%1 nu a putut citi videoclipul de pe acest computer."

#: modules/gui/qt/util/renderer_manager.cpp:873
msgid "%1 refused to play this video."
msgstr "%1 a refuzat să redea acest videoclip."

#: modules/gui/qt/util/renderer_manager.cpp:875
msgid "%1 stopped playing."
