msgstr "Обновление предназначено не для этой версии."

#: modules/gui/qt/util/redesign_updater.cpp:929
#: modules/gui/qt/util/redesign_updater.cpp:966
#: modules/gui/qt/util/redesign_updater.cpp:975
#: modules/gui/qt/util/redesign_updater.cpp:979
