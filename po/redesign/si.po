#: modules/gui/qt/player/qml/controlbarcontrols/SkipForward10Button.qml:28
msgid "Forward 10 seconds"
msgstr "තත්පර 10 ඉදිරියට"

#: modules/gui/qt/player/qml/controlbarcontrols/SkipForwardButton.qml:33
msgid "Forward 15 seconds"
msgstr "තත්පර 15 ඉදිරියට"

#: modules/gui/qt/player/qml/controlbarcontrols/VolumeWidget.qml:345
