msgstr "நிகழ்படம் இல்லாமல் பெரிதாக்கம் கிடைக்காது"

#: modules/gui/qt/playlist/qml/PlaylistDelegate.qml:193
msgid "Playing"
msgstr "இயங்குகிறது"

#: modules/gui/qt/playlist/qml/PlaylistDelegate.qml:197
msgid "Media cover"
msgstr "ஊடக அட்டைப்படம்"

#: modules/gui/qt/playlist/qml/PlaylistPane.qml:194
