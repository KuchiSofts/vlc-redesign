msgstr "Không thể chọn thiết bị đầu ra này."

#: modules/gui/qt/dialogs/preferences/audio_output_preview.cpp:141
msgid "The audio output changed; the device preview cannot be kept."
msgstr "Đầu ra âm thanh đã thay đổi; không thể giữ bản nghe thử của thiết bị."

#: modules/gui/qt/dialogs/preferences/audio_output_preview.cpp:162
msgid "The previous audio device could not be restored."
msgstr "Không thể khôi phục thiết bị âm thanh trước đó."

