msgstr "Ce afișează bannerul peste video la schimbarea canalului."

#: modules/gui/qt/dialogs/preferences/config_model.cpp:295
msgid "Channel, now and next|Channel and now|Channel only|Nothing"
msgstr "Canal, acum și urmează|Canal și acum|Doar canalul|Nimic"

