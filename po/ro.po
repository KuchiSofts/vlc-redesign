#: modules/gui/macosx/windows/convertandsave/VLCConvertAndSaveWindowController.m:207
#: modules/spu/mosaic.c:93 modules/video_output/vmem.c:44
#: share/lua/http/dialogs/mosaic_window.html:126
msgid "Height"
msgstr "Înalțime"

#: src/libvlc-module.c:507
msgid "Custom crop ratios list"
msgstr "Listă de rapoarte de trunchiere personalizate"

#: src/libvlc-module.c:509
msgid ""
"Comma separated list of crop ratios which will be added in the interface's "
"crop ratios list."
msgstr ""
"Lista cu separare prin virgulă, a raporturilor de decupare ce va fi adăugată "
"în lista raporturilor de decupare, din interfață."

#: src/libvlc-module.c:512
msgid "Custom aspect ratios list"
msgstr "Listă de rapoarte de aspect particularizate"

#: src/libvlc-module.c:514
msgid ""
"Comma separated list of aspect ratios which will be added in the interface's "
"aspect ratio list."
msgstr ""
"Listă de rapoarte de aspect, separate prin virgulă care vor fi adăugate în "
"lista de rapoarte de aspect a interfaței."

#: src/libvlc-module.c:517
msgid "Fix HDTV height"
msgstr "Corectează înălțimea HDTV"

#: src/libvlc-module.c:519
msgid ""
"This allows proper handling of HDTV-1080 video format even if broken encoder "
"incorrectly sets height to 1088 lines. You should only disable this option "
"if your video has a non-standard format requiring all 1088 lines."
msgstr ""
"Permite manipularea corespunzătoare a formatului video HDTV-1080, chiar dacă "
"un codor defectuos stabilește în mod incorect înălțiimea la 1088 de linii. "
"Această opțiune ar trebui dezactivată doar dacă materialul video are un "
"format nestandard care necesită 1088 de linii."

#: src/libvlc-module.c:524
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:180
msgid "Monitor pixel aspect ratio"
msgstr "Raport de aspect al pixelilor monitorului"

#: src/libvlc-module.c:526
msgid ""
"This forces the monitor aspect ratio. Most monitors have square pixels "
"(1:1). If you have a 16:9 screen, you might need to change this to 4:3 in "
"order to keep proportions."
msgstr ""
"Forțează raportul de aspect al monitorului. Majoritatea monitoarelor au "
"pixeli pătrați (1:1). Dacă aveți un ecran 16:9, ar putea fi necesar să "
"schimbați aceasta în 4:3 pentru a putea păstra proporțiile."

#: src/libvlc-module.c:530
msgid "Drop late frames"
msgstr "Aruncă cadrele întârziate"

#: src/libvlc-module.c:532
msgid ""
"This drops frames that are late (arrive to the video output after their "
"intended display date)."
msgstr ""
"Aruncă cadrele care sunt întârziate (care ajung la ieșirea video după "
"momentul intenționat de afișare)."

#: src/libvlc-module.c:535
msgid "Key press events"
msgstr "Evenimente la apăsarea tastelor"

#: src/libvlc-module.c:537
msgid "This enables VLC hotkeys from the (non-embedded) video window."
msgstr ""
"Aceasta activează, în VLC, tastele rapide hotkey din fereastra video "
"(neîncastrată)."

#: src/libvlc-module.c:539
msgid "Mouse events"
msgstr "Evenimente de maus"

#: src/libvlc-module.c:541
msgid "This enables handling of mouse clicks on the video."
msgstr "Aceasta activează gestionarea clicurilor de mouse pentru video."

#: src/libvlc-module.c:543
msgid "Mouse Pause Policy"
msgstr "Pauză la clic cu mouse-ul"

#: src/libvlc-module.c:545
msgid "This controls how pause on mouse click is handled"
msgstr "Stabilește cum este tratată pauza la clic cu mouse-ul"

#: src/libvlc-module.c:552 modules/access/rist.h:85
#: modules/audio_output/mmdevice.c:1621
#: modules/gui/qt/dialogs/preferences/config_model.cpp:181
#: modules/gui/qt/dialogs/preferences/config_model.cpp:1224
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:342
#: modules/gui/qt/player/qml/AudioVisualizationDialog.qml:23
#: modules/gui/qt/player/qml/AudioVisualizationDialog.qml:144
msgid "Disabled"
msgstr "Dezactivat"

#: src/libvlc-module.c:552
msgid "Toggle pause immediately on mouse released"
msgstr "Comută pauza imediat la eliberarea butonului mouse-ului"

#: src/libvlc-module.c:560
msgid ""
"These options allow you to modify the behavior of the input subsystem, such "
"as the DVD or VCD device, the network interface settings or the subtitle "
"channel."
msgstr ""
"Aceste opțiuni vă permit să modificați comportamentul subsistemului de "
"intrare, cum ar fi dispozitive DVD sau VCD, setările interfeței de rețea, "
"sau ale canalului de subtitlu."

#: src/libvlc-module.c:564
msgid "File caching (ms)"
msgstr "Stocare în cache pentru fișiere (ms)"

#: src/libvlc-module.c:566
msgid "Caching value for local files, in milliseconds."
msgstr "Valoarea de stocare în cache pentru fișierele locale, în milisecunde."

#: src/libvlc-module.c:568
msgid "Live capture caching (ms)"
msgstr "Captură directă în caching (ms)"

#: src/libvlc-module.c:570
msgid "Caching value for cameras and microphones, in milliseconds."
msgstr ""
"Valoarea de stocare în cache pentru camere și microfoane, în milisecunde."

#: src/libvlc-module.c:572
msgid "Disc caching (ms)"
msgstr "Stocare în cache pentru disc (ms)"

#: src/libvlc-module.c:574
msgid "Caching value for optical media, in milliseconds."
msgstr "Valoarea de stocare în cache pentru media optic, în milisecunde."

#: src/libvlc-module.c:576
msgid "Network caching (ms)"
msgstr "Stocare în cache pentru rețea (ms)"

#: src/libvlc-module.c:578
msgid "Caching value for network resources, in milliseconds."
msgstr "Valoarea de stocare în cache pentru rețea, în milisecunde."

#: src/libvlc-module.c:580
msgid "Clock reference average counter"
msgstr "Contor mediu de referință de ceas"

#: src/libvlc-module.c:582
msgid ""
"When using the PVR input (or a very irregular source), you should set this "
"to 10000."
msgstr ""
"Când se folosește intrarea PVR (sau o sursă foarte neregulată), ar trebui să "
"stabiliți aceasta la 10000."

#: src/libvlc-module.c:585
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:354
msgid "Clock synchronisation"
msgstr "Sincronizare ceas"

#: src/libvlc-module.c:587
msgid ""
"It is possible to disable the input clock synchronisation for real-time "
"sources. Use this if you experience jerky playback of network streams."
msgstr ""
"Este posibil să dezactivați sincronizarea ceasului de intrare pentru surse "
"de timp real. Folosiți aceasta dacă vă confruntați cu o redare sacadată a "
"fluxurilor de rețea."

#: src/libvlc-module.c:591
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:355
msgid "Clock jitter"
msgstr "Frecvență deviații"

#: src/libvlc-module.c:593
msgid ""
"This defines the maximum input delay jitter that the synchronization "
"algorithms should try to compensate (in milliseconds)."
msgstr ""
"Aceasta definește valoarea de întârzierea maximă, a variației de temporizare "
"jitter, pe care algoritmii de sincronizare ar trebui s-o compenseze (în "
"milisecunde)."

#: src/libvlc-module.c:596
msgid "Clock master source"
msgstr "Sursă principală de ceas"

#: src/libvlc-module.c:597
msgid ""
"Select the clock master source:\n"
"auto: best clock source, input if the access can't be paced (when playing "
"live content), or audio otherwise (most likely).\n"
"input: all tracks are driven by the input clock, via PCR updates from the "
"demuxer. This restore the VLC 3.0 clock behavior where both audio and video "
"tracks can be altered to catch up with the input.\n"
"audio: if an audio track is playing, the audio output will drive the clock "
"(Fallback to Monotonic if there is no audio tracks).\n"
"monotonic: all tracks are driven by the monotonic clock of the system."
msgstr ""
"Selectați sursa principală de ceas:\n"
"automat: cea mai bună sursă de ceas; intrarea, dacă accesul nu poate fi "
"cadențat (la redarea conținutului în direct), altfel audio (cel mai "
"probabil).\n"
"intrare: toate pistele sunt conduse de ceasul intrării, prin actualizările "
"PCR de la demultiplexor. Aceasta restabilește comportamentul ceasului din "
"VLC 3.0, în care atât pistele audio, cât și cele video pot fi modificate "
"pentru a ajunge din urmă intrarea.\n"
"audio: dacă se redă o pistă audio, ieșirea audio va conduce ceasul (se "
"revine la ceasul monoton dacă nu există piste audio).\n"
"monoton: toate pistele sunt conduse de ceasul monoton al sistemului."

#: src/libvlc-module.c:612
msgid "Input (PCR)"
msgstr "Intrare (PCR)"

#: src/libvlc-module.c:614
msgid "Monotonic"
msgstr "Monoton"

#: src/libvlc-module.c:619 src/video_output/vout_intf.c:119
#: src/video_output/vout_intf.c:137 modules/access/dshow/dshow.cpp:90
#: modules/access/dshow/dshow.cpp:97 modules/access/dshow/dshow.cpp:2018
#: modules/audio_output/alsa.c:1153 modules/audio_output/mmdevice.c:1435
