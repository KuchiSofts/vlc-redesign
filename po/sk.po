#: src/libvlc-module.c:1243
#: modules/gui/macosx/preferences/VLCSimplePrefsController.m:424
msgid "Allow metadata network access"
msgstr "Povoliť sieťový prístup pre metadáta"

#: src/libvlc-module.c:1248
msgid "Collapse"
msgstr "Zbaliť"

#: src/libvlc-module.c:1248
msgid "Expand"
msgstr "Rozbaliť"

#: src/libvlc-module.c:1250
msgid "Subdirectory behavior"
msgstr "Správanie podpriečinkov"

#: src/libvlc-module.c:1252
msgid ""
"Select whether subdirectories must be expanded.\n"
"none: subdirectories do not appear in the play queue.\n"
"collapse: subdirectories appear but are expanded on first play.\n"
"expand: all subdirectories are expanded.\n"
msgstr ""
"Vyberte, či sa majú podpriečinky rozbaliť.\n"
"none: podpriečinky sa vo fronte prehrávania nezobrazujú.\n"
"collapse: podpriečinky sa zobrazujú, ale rozbalia sa pri prvom prehraní.\n"
"expand: všetky podpriečinky sú rozbalené.\n"

#: src/libvlc-module.c:1257
msgid "Ignored extensions"
msgstr "Ignorované koncovky"

#: src/libvlc-module.c:1259
msgid ""
"Files with these extensions will not be added to play queue when opening a "
"directory.\n"
"This is useful if you add directories that contain playlist files for "
"instance. Use a comma-separated list of extensions."
msgstr ""
"Súbory s týmito príponami sa pri otváraní priečinka nepridajú do frontu "
"prehrávania.\n"
"Hodí sa to napríklad pri pridávaní priečinkov, ktoré obsahujú súbory "
"playlistov. Použite zoznam prípon oddelených čiarkami."

#: src/libvlc-module.c:1264
#: modules/gui/qt/dialogs/preferences/qml/SettingsPresentation.qml:318
msgid "Show hidden files"
msgstr "Zobrazovať skryté súbory"

#: src/libvlc-module.c:1266
