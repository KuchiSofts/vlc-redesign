"automatically."
msgstr ""
"Ak bude detegovaná audio-komunikácia, prehrávanie sa automaticky pozastaví."

#: src/libvlc-module.c:1312
msgid "Use media library"
msgstr "Použiť knižnicu médií"

#: src/libvlc-module.c:1314
msgid ""
