msgstr ""
"Pokaže naslov posnetka za n milisekund, privzeta vrednost je 5000 ms (5 "
"sekund)."

#: src/libvlc-module.c:361
msgid "Position of video title"
msgstr "Položaj naslova videa"

#: src/libvlc-module.c:363
