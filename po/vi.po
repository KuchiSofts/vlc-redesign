#: src/interface/interface.c:215
msgid ""
"Running vlc with the default interface. Use 'cvlc' to use vlc without "
"interface."
msgstr ""
"Khởi động VLC với giao diện mặc định. Sử dụng 'cvlc' để chạy VLC mà không "
