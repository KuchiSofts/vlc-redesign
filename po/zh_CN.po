" -  0: 4x4\n"
" -  1: 8x8\n"
" - -1: smallest possible according to level"
msgstr ""

#: modules/codec/x264.c:280
msgid "Weighted prediction for B-frames"
msgstr "B 帧的加权预测"

#: modules/codec/x264.c:282
